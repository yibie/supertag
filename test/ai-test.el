(ert-deftest supertag-ai-terminal-deliveries-advance-once-without-reentry ()
  (supertag-ai-test-with-batch
    (cl-letf (((symbol-function 'supertag-ai--submit)
               (lambda (req)
                 (push req requests)
                 (list :run-id (format "run%d" (length requests))))))
      (supertag-ai-extract-tag-properties)
      (let ((batch supertag-ai--batch) (completed (car requests)))
        (supertag-ai-test-deliver completed "{}" 'completed)
        (should (= 2 (length requests)))
        (should (equal '("n1") (plist-get batch :done)))
        (supertag-ai-test-deliver completed "{}" 'completed)
        (should (= 2 (length requests)))
        (should (equal '("n1") (plist-get batch :done)))
        (let ((failed (car requests)))
          (supertag-ai-test-deliver failed "failed" 'failed)
          (should (= 3 (length requests)))
          (should (equal "n3" (plist-get batch :current)))
          (supertag-ai-test-deliver failed "failed" 'failed)
          (should (= 3 (length requests))))
        (let ((cancelled (car requests)))
          (cl-letf (((symbol-function 'superchat-runtime-cancel)
                     (lambda (_run)
                       (supertag-ai-test-deliver cancelled "cancelled" 'cancelled))))
            (supertag-ai-cancel "n3"))
          (should-not supertag-ai--batch)
          (should (= 3 (length requests)))
          (should (equal '("n1") (plist-get batch :done)))
          (supertag-ai-test-deliver cancelled "{}")
          (should-not supertag-ai--batch)
          (should (= 3 (length requests))))))))

(ert-deftest supertag-ai-batch-note-requires-terminal-token-and-batch-slot ()
  (supertag-ai-test-with-batch
    (cl-letf (((symbol-function 'supertag-ai--submit)
               (lambda (req) (push req requests) (list :run-id "run"))))
      (supertag-ai-extract-tag-properties)
      (let* ((request (car requests))
             (batch supertag-ai--batch)
             (token (plist-get (gethash "n1" supertag-ai--candidates) :token))
             checked
             (after-refresh
              (lambda (id)
                (when (and (equal id "n1")
                           (eq 'done (plist-get (gethash id supertag-ai--candidates) :status)))
                  ;; Actual delivery has set terminal status; none of these
                  ;; notifications owns both its request and the original slot.
                  (dolist (args (list (list id (gensym "wrong-token") batch)
                                     (list id token (copy-tree batch))
                                     (list id token nil)
                                     (list "n2" token batch)))
                    (apply #'supertag-ai--batch-note args)
                    (should (= 1 (length requests)))
                    (should (equal "n1" (plist-get batch :current)))
                    (should-not (plist-get batch :done)))
                  (setq checked t)))))
        ;; A matching owner is insufficient while its request is still pending.
        (supertag-ai--batch-note "n1" token batch)
        (should (= 1 (length requests)))
        (should (equal "n1" (plist-get batch :current)))
        (advice-add 'supertag-ai--refresh :after after-refresh)
        (unwind-protect (supertag-ai-test-deliver request "{}")
          (advice-remove 'supertag-ai--refresh after-refresh))
        (should checked)
        (should (= 2 (length requests)))
        (should (equal '("n1") (plist-get batch :done)))
        (should (equal "n2" (plist-get batch :current)))
        ;; The former owner cannot terminate another current slot a second time.
        (supertag-ai--batch-note "n1" token batch)
        (should (= 2 (length requests)))
        (should (equal '("n1") (plist-get batch :done)))
        (should (equal "n2" (plist-get batch :current)))))))

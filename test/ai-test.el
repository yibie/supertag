      (let* ((old (car requests))
             (refreshes 0)
             (record-refresh (lambda (id) (when (equal id "n1") (cl-incf refreshes)))))
        ;; Observe real refresh calls; do not replace the renderer or delivery.
        (advice-add 'supertag-ai--refresh :after record-refresh)
        (unwind-protect
            (cl-letf (((symbol-function 'superchat-runtime-cancel)
                       (lambda (_run)

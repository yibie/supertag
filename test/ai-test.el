        (should (equal "n2" (plist-get supertag-ai--batch :current)))
        (should (eq 'cancelled (plist-get (gethash "n1" supertag-ai--candidates) :status)))
        (supertag-ai-test-deliver old "{}")
        (should (= 2 (length requests)))))))


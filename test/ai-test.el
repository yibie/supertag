                (should (string-match-p "KIND: one" (buffer-string)))
                (should (equal (plist-get snapshot :value) "one"))
                (cl-letf (((symbol-function 'message)
                           (lambda (fmt &rest args)
                             (when (string-prefix-p "Supertag AI plan:" fmt)
                               (setq summary (apply #'format fmt args))))))
                  (supertag-ai-plan-apply))
                (should (equal summary "Supertag AI plan: 2 written, 0 skipped, 1 plan changed, 0 unsaved file"))
                ;; The affected subtree is byte-identical; other rows really save.
                (should (equal (car (split-string disk "\\* Two"))
                               (car (split-string (supertag-document-test-disk file) "\\* Two"))))
                (should-not (supertag-ai--disk-value "n1" "KIND"))

;;; ai-test.el --- Disposable AI candidates and real Org writes -*- lexical-binding: t; -*-
;; Set the optional package's data location before any require can load it.
(unless (boundp 'superchat-data-directory)
  (setq superchat-data-directory
        (expand-file-name "superchat/" (or (getenv "SUPERTAG_TEST_TMP")
                                           (make-temp-file "supertag-ai-runtime-" t)))))
(require 'ert)
(require 'cl-lib)
(require 'document-fixture)
(require 'supertag-ai)
(require 'supertag-view-node)
(require 'supertag-embark)
(defvar superchat-data-directory)
(defvar superchat-llm-backend)
(declare-function make-llm-fake "llm-fake" (&rest args))

(defmacro supertag-ai-test-with-request (&rest body)
  "Run BODY with captured REQUEST, isolated candidates and a stub transport."
  (declare (indent 0))
  `(let ((supertag-ai--candidates (make-hash-table :test 'equal)) request)
     (cl-letf (((symbol-function 'superchat-runtime-submit) #'ignore)
               ((symbol-function 'supertag-ai--submit)
                (lambda (value) (setq request value) (list :run-id "run" :turn-id "turn"))))
       ,@body)))

(defun supertag-ai-test-deliver (request text &optional status)
  (funcall (plist-get request :delivery-function) text (or status 'completed) "tape"))

(defun supertag-ai-test-snapshot (file)
  (list (supertag-document-test-disk file)
        (with-current-buffer (find-file-noselect file) (buffer-string))
        (with-current-buffer (find-file-noselect file) (buffer-modified-p))
        (prin1-to-string supertag--store)))

(ert-deftest supertag-ai-request-uses-live-own-body-and-custom-prompts ()
  (supertag-document-test-with-vault
    (supertag-ai-test-with-request
      (with-current-buffer (find-file-noselect file)
        (goto-char (point-max))
        (insert "written by Ada\n** Child\nDo not send child.\n")
        (goto-char (point-min))
        (let ((before (supertag-ai-test-snapshot file)))
          (supertag-ai-extract-properties)
          (should (equal before (supertag-ai-test-snapshot file)))))
      (should (string-match-p "Property Node" (plist-get request :prompt)))
      (should (string-match-p "ZETA: last" (plist-get request :prompt)))
      (should (string-match-p "written by Ada" (plist-get request :prompt)))
      (should-not (string-match-p "Child\\|:PROPERTIES:\\|document-node" (plist-get request :prompt)))
      (should (eq (plist-get request :type) :llm-query))
      (should (eq (plist-get request :tools) 'none))
      (should-not (plist-get request :record-conversation))
      (should (equal (buffer-name (plist-get request :buffer)) " *supertag-ai*"))
      (should (equal (plist-get request :system-prompt)
                     (plist-get (alist-get 'extract-properties supertag-ai-prompts) :system)))
      (should (equal (plist-get (gethash "document-node" supertag-ai--candidates) :run-id) "run"))
      (should (equal (plist-get (gethash "document-node" supertag-ai--candidates) :turn-id) "turn"))
      (supertag-ai-discard "document-node")
      (let ((supertag-ai-prompts '((alternate :system "System X" :user "%t|%p|%b")))
            (supertag-ai-max-body-chars 4))
        (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "alternate")))
          (with-current-buffer (find-file-noselect file)
            (supertag-ai-extract-properties t)))
        (should (equal (plist-get request :system-prompt) "System X"))
        (should (string-match-p "Body(truncated)" (replace-regexp-in-string "\n" "" (plist-get request :prompt))))))))

(ert-deftest supertag-ai-fresh-id-to-accepted-property-without-early-save ()
  (supertag-document-test-with-vault
    (supertag-ai-test-with-request
      (with-current-buffer (find-file-noselect plain)
        (goto-char (point-min))
        (let ((disk (supertag-document-test-disk plain)))
          (should-not (org-entry-get nil "ID"))
          (supertag-ai-extract-properties)
          (let ((id (org-entry-get nil "ID")))
            (should id)
            (should (supertag-node-get id))
            (should request)
            (should (buffer-modified-p))
            (should (equal disk (supertag-document-test-disk plain)))
            (should (eq 'pending (plist-get (gethash id supertag-ai--candidates) :status)))
            (should-error (supertag-ai-extract-properties) :type 'user-error)
            (supertag-ai-test-deliver request "{\"AUTHOR\":{\"value\":\"Ada\",\"source\":null}}")
            (should (supertag-ai-accept id "AUTHOR"))
            (should-not (buffer-modified-p))
            (should (string-match-p ":AUTHOR: +Ada" (supertag-document-test-disk plain)))
            (should (equal (plist-get (plist-get (supertag-node-get id) :properties) :AUTHOR) "Ada"))))))))

(ert-deftest supertag-ai-preflight-rejects-unsaved-and-file-level-without-writes ()
  (supertag-document-test-with-vault
    (supertag-ai-test-with-request
      (dolist (path (list nil (expand-file-name "never-saved.org" tmp)))
        (with-temp-buffer
          (org-mode) (setq buffer-file-name path) (insert "* Unsaved\nBody.\n")
          (goto-char (point-min))
          (let ((text (buffer-string)) (store (prin1-to-string supertag--store)))
            (should (equal (cadr (should-error (supertag-ai-extract-properties) :type 'user-error))
                           "Save this file before extracting properties"))
            (should (equal text (buffer-string)))
            (should (equal store (prin1-to-string supertag--store))))))
      (with-current-buffer (find-file-noselect plain)
        (goto-char (point-min)) (insert "Preamble\n") (goto-char (point-min))
        (let ((before (supertag-ai-test-snapshot plain)))
          (should-error (supertag-ai-extract-properties) :type 'user-error)
          (should (equal before (supertag-ai-test-snapshot plain)))))
      (should-not request)
      (should (= 0 (hash-table-count supertag-ai--candidates))))))

(ert-deftest supertag-ai-parser-normalizes-and-drops-invalid-or-equal-values ()
  (cl-multiple-value-bind (candidates dropped)
      (supertag-ai--parse-candidates
       "prefix\n```json\n{\" author \":{\"value\":\" Ada \",\"source\":\"written by Ada\"},\"AUTHOR\":{\"value\":\"Other\"},\"YEAR\":{\"value\":2020,\"source\":null},\"ID\":{\"value\":\"bad\"},\"CUSTOM_ID\":{\"value\":\"bad\"},\"CATEGORY\":{\"value\":\"bad\"},\"TODO\":{\"value\":\"bad\"},\"bad key\":{\"value\":\"bad\"},\"MULTI\":{\"value\":\"a\\nb\"},\"EMPTY\":{\"value\":\" \"},\"SAME\":{\"value\":\"same\"},\"LIST\":{\"value\":[1,2]}}\n```\nsuffix"
       '(("author" . "Before") ("same" . "same")))
    (should (= 10 dropped))
    (should (equal (mapcar (lambda (c) (plist-get c :name)) candidates) '("AUTHOR" "YEAR")))
    (should (equal (plist-get (car candidates) :current) "Before"))
    (should (equal (plist-get (car candidates) :value) "Ada"))
    (should (equal (plist-get (cadr candidates) :value) "2020"))
    (should-not (plist-get (cadr candidates) :source)))
  (cl-multiple-value-bind (candidates dropped)
      (supertag-ai--parse-candidates "prose {\"OK\":{\"value\":\"yes\"}} after" nil)
    (should (equal (plist-get (car candidates) :name) "OK"))
    (should (zerop dropped)))
  (should (supertag-ai--parse-candidates "```\n{\"OK\":{\"value\":\"yes\"}}\n```" nil))
  (dolist (text '("garbage" "```json\n[]\n```" "[]" "{broken}"))
    (should-error (supertag-ai--parse-candidates text nil))))

(ert-deftest supertag-ai-delivery-failures-skip-and-discard-are-zero-write ()
  (supertag-document-test-with-vault
    (supertag-ai-test-with-request
      (with-current-buffer (find-file-noselect file)
        (goto-char (point-min)) (supertag-ai-extract-properties))
      (let ((before (supertag-ai-test-snapshot file)))
        (dolist (response '("[]" "garbage"))
          (supertag-ai-test-deliver request response)
          (should (eq 'failed (plist-get (gethash "document-node" supertag-ai--candidates) :status))))
        (supertag-ai-test-deliver request "provider failed" 'failed)
        (should (equal "provider failed" (plist-get (gethash "document-node" supertag-ai--candidates) :message)))
        (supertag-ai-test-deliver request "{\"AUTHOR\":{\"value\":\"Ada\"},\"YEAR\":{\"value\":2020}}")
        (supertag-ai-skip "document-node" "AUTHOR")
        (should (= 1 (length (plist-get (gethash "document-node" supertag-ai--candidates) :candidates))))
        (supertag-ai-discard "document-node")
        (should-not (gethash "document-node" supertag-ai--candidates))
        (should (equal before (supertag-ai-test-snapshot file)))))))

(ert-deftest supertag-ai-accept-all-stops-at-failed-writer-and-retains-candidate ()
  (supertag-document-test-with-vault
    (supertag-ai-test-with-request
      (with-current-buffer (find-file-noselect file)
        (goto-char (point-min)) (supertag-ai-extract-properties))
      (supertag-ai-test-deliver request "{\"AUTHOR\":{\"value\":\"Ada\"},\"YEAR\":{\"value\":2020}}")
      (let ((calls 0) (before (supertag-ai-test-snapshot file)))
        (cl-letf (((symbol-function 'supertag-service-org-set-property)
                   (lambda (&rest _) (cl-incf calls) (error "write failed"))))
          (supertag-ai-accept-all "document-node"))
        (should (= calls 1))
        (should (= 2 (length (plist-get (gethash "document-node" supertag-ai--candidates) :candidates))))
        (should (equal before (supertag-ai-test-snapshot file))))
      (supertag-ai-accept-all "document-node")
      (should (string-match-p ":AUTHOR: +Ada" (supertag-document-test-disk file)))
      (should (string-match-p ":YEAR: +2020" (supertag-document-test-disk file)))
      (should-not (plist-get (gethash "document-node" supertag-ai--candidates) :candidates))
      (should (eq 'done (plist-get (gethash "document-node" supertag-ai--candidates) :status))))))

(ert-deftest supertag-ai-node-view-review-and-button-write ()
  (supertag-document-test-with-vault
    (supertag-ai-test-with-request
      (let ((view (with-current-buffer (find-file-noselect file)
                    (supertag-view-node-open "document-node"))))
        (with-current-buffer view
          (should-not (string-match-p "Property candidates" (buffer-string)))
          (supertag-ai-extract-properties)
          (should (string-match-p "Extracting with prompt extract-properties" (buffer-string))))
        (supertag-ai-test-deliver request "{\"AUTHOR\":{\"value\":\"Ada\",\"source\":\"written by Ada\"},\"ALPHA\":{\"value\":\"changed\"}}")
        (with-current-buffer view
          (should (string-match-p " PROPERTY CANDIDATES / 02 " (buffer-string)))
          (should (string-match-p "ALPHA: first → changed" (buffer-string)))
          (should (string-match-p "Not found in the body" (buffer-string)))
          (goto-char (point-min)) (search-forward "[Accept]")
          (button-activate (button-at (1- (point)))))
        (should (string-match-p ":AUTHOR: +Ada" (supertag-document-test-disk file)))
        (with-current-buffer view
          (goto-char (point-min)) (search-forward "[Skip]")
          (button-activate (button-at (1- (point))))
          (should (string-match-p "All candidates handled" (buffer-string))))
        (supertag-ai-test-deliver request "bad" 'failed)
        (with-current-buffer view
          (should (string-match-p "Failed: bad" (buffer-string)))
          (goto-char (point-min)) (search-forward "[Discard]")
          (button-activate (button-at (1- (point)))))
        (should-not (gethash "document-node" supertag-ai--candidates))))))

(ert-deftest supertag-ai-submit-error-is-visible-and-synchronous-delivery-survives ()
  (supertag-document-test-with-vault
    (supertag-ai-test-with-request
      (with-current-buffer (find-file-noselect file)
        (goto-char (point-min))
        (cl-letf (((symbol-function 'supertag-ai--submit) (lambda (_) (error "bad request"))))
          (should-error (supertag-ai-extract-properties)))
        (should (eq 'failed (plist-get (gethash "document-node" supertag-ai--candidates) :status)))
        (cl-letf (((symbol-function 'supertag-ai--submit)
                   (lambda (request)
                     (supertag-ai-test-deliver request "{}")
                     '(:run-id "synchronous"))))
          (supertag-ai-extract-properties))
        (should (eq 'done (plist-get (gethash "document-node" supertag-ai--candidates) :status)))
        (should (equal "synchronous" (plist-get (gethash "document-node" supertag-ai--candidates) :run-id)))))))

(ert-deftest supertag-ai-missing-runtime-is-actionable ()
  (let ((original (symbol-function 'fboundp)))
    (cl-letf (((symbol-function 'fboundp)
               (lambda (symbol) (and (not (eq symbol 'superchat-runtime-submit))
                                     (funcall original symbol)))))
      (should (equal (cadr (should-error (supertag-ai-extract-properties) :type 'user-error))
                     "Supertag AI needs the superchat package loaded first (see README)")))))

(ert-deftest supertag-ai-embark-adapter-is-not-command ()
  (should-not (commandp 'supertag-embark-node-extract-properties))
  (should (eq (lookup-key supertag-embark-node-map "x") #'supertag-embark-node-extract-properties)))

(ert-deftest supertag-ai-real-runtime-with-llm-fake ()
  (unless (and (getenv "SUPERTAG_TEST_TMP")
               (file-in-directory-p superchat-data-directory (getenv "SUPERTAG_TEST_TMP")))
    (ert-skip "Runtime data directory must be inside SUPERTAG_TEST_TMP"))
  (skip-unless (and (require 'superchat nil t) (require 'llm-fake nil t)))
  (supertag-document-test-with-vault
    (let* ((supertag-ai--candidates (make-hash-table :test 'equal))
           (output (generate-new-buffer " *llm-fake*"))
           (superchat-llm-backend
            (make-llm-fake :output-to-buffer output
                          :chat-action-func
                          (lambda () "```json\n{\"AUTHOR\":{\"value\":\"Ada\",\"source\":\"written by Ada\"}}\n```"))))
      (unwind-protect
          (progn
            (with-current-buffer (find-file-noselect file)
              (goto-char (point-max)) (insert "written by Ada\n")
              (goto-char (point-min)) (supertag-ai-extract-properties))
            (let ((deadline (+ (float-time) 15)))
              (while (and (eq 'pending (plist-get (gethash "document-node" supertag-ai--candidates) :status))
                          (< (float-time) deadline))
                (accept-process-output nil 0.05)))
            (should (eq 'done (plist-get (gethash "document-node" supertag-ai--candidates) :status)))
            (should (equal "Ada" (plist-get (car (plist-get (gethash "document-node" supertag-ai--candidates) :candidates)) :value)))
            (should (supertag-ai-accept "document-node" "AUTHOR"))
            (should (string-match-p ":AUTHOR: +Ada" (supertag-document-test-disk file))))
        (kill-buffer output)))))

(ert-deftest supertag-ai-save-failure-needs-user-save-and-projection-before-accept ()
  (supertag-document-test-with-vault
    (supertag-ai-test-with-request
      (with-current-buffer (find-file-noselect file)
        (goto-char (point-min))
        (supertag-ai-extract-properties))
      (supertag-ai-test-deliver request "{\"AUTHOR\":{\"value\":\"Ada\"}}")
      (cl-letf (((symbol-function 'save-buffer)
                 (lambda (&rest _) (error "isolated save failure"))))
        (should-not (supertag-ai-accept "document-node" "AUTHOR")))
      (should (plist-get (gethash "document-node" supertag-ai--candidates) :candidates))
      (let ((before (supertag-ai-test-snapshot file)) messages)
        (cl-letf (((symbol-function 'message)
                   (lambda (format-string &rest args)
                     (push (apply #'format format-string args) messages))))
          (should-not (supertag-ai-accept "document-node" "AUTHOR")))
        (should (member "Supertag AI: AUTHOR is in the Org buffer but not saved yet; save node.org, then accept again" messages))
        (should (equal before (supertag-ai-test-snapshot file))))
      (should (plist-get (gethash "document-node" supertag-ai--candidates) :candidates))
      (should-not (string-match-p ":AUTHOR:" (supertag-document-test-disk file)))
      (should-not (plist-get (plist-get (supertag-node-get "document-node") :properties) :AUTHOR))
      ;; Recovery is explicitly performed by the user/test, never the AI action.
      (with-current-buffer (find-file-noselect file) (save-buffer))
      (supertag-service-org-retry-node-projection "document-node" file)
      (should (supertag-ai-accept "document-node" "AUTHOR"))
      (should-not (plist-get (gethash "document-node" supertag-ai--candidates) :candidates))
      (should (string-match-p ":AUTHOR: +Ada" (supertag-document-test-disk file)))
      (should (equal "Ada" (plist-get (plist-get (supertag-node-get "document-node") :properties) :AUTHOR))))))

(ert-deftest supertag-ai-live-projection-is-not-disk-proof ()
  (supertag-document-test-with-vault
    (supertag-ai-test-with-request
      (with-current-buffer (find-file-noselect file)
        (goto-char (point-min)) (supertag-ai-extract-properties)
        (supertag-ai-test-deliver request "{\"AUTHOR\":{\"value\":\"Ada\"}}")
        (org-entry-put nil "AUTHOR" "Ada")
        (supertag-node-sync-at-point)
        (let ((before (supertag-ai-test-snapshot file)))
          (should-not (supertag-ai-accept "document-node" "AUTHOR"))
          (should (equal before (supertag-ai-test-snapshot file))))
        (should (plist-get (gethash "document-node" supertag-ai--candidates) :candidates))
        (should-not (string-match-p ":AUTHOR:" (supertag-document-test-disk file)))
        (save-buffer)
        (should (supertag-ai-accept "document-node" "AUTHOR"))))))

(ert-deftest supertag-ai-conflict-requires-another-review-and-stops-batch ()
  (supertag-document-test-with-vault
    (supertag-ai-test-with-request
      (with-current-buffer (find-file-noselect file)
        (goto-char (point-min)) (supertag-ai-extract-properties))
      (supertag-ai-test-deliver request "{\"ALPHA\":{\"value\":\"Proposed\"},\"AUTHOR\":{\"value\":\"Ada\"}}")
      (supertag-service-org-set-property "document-node" "ALPHA" "User changed")
      (let ((before (supertag-ai-test-snapshot file)))
        (supertag-ai-accept-all "document-node")
        (should (equal before (supertag-ai-test-snapshot file))))
      (let ((candidates (plist-get (gethash "document-node" supertag-ai--candidates) :candidates)))
        (should (= 2 (length candidates)))
        (should (equal "User changed" (plist-get (car candidates) :current)))
        (should (plist-get (car candidates) :stale)))
      (with-temp-buffer
        (supertag-ai-insert-section "document-node")
        (should (string-match-p "changed since extraction: first → User changed" (buffer-string))))
      (should (supertag-ai-accept "document-node" "ALPHA"))
      (should (string-match-p ":ALPHA: +Proposed" (supertag-document-test-disk file)))
      (should (= 1 (length (plist-get (gethash "document-node" supertag-ai--candidates) :candidates)))))))

(ert-deftest supertag-ai-nonobject-responses-fail-without-writes ()
  (supertag-document-test-with-vault
    (supertag-ai-test-with-request
      (with-current-buffer (find-file-noselect file)
        (goto-char (point-min)) (supertag-ai-extract-properties))
      (let ((before (supertag-ai-test-snapshot file)))
        (dolist (text (list "[{\"AUTHOR\":{\"value\":\"Ada\"}}]"
                           (json-serialize "{\"AUTHOR\":{\"value\":\"Ada\"}}")
                           "Result: [{\"AUTHOR\":{\"value\":\"Ada\"}}]"
                           "null" "17" "```json\n[{}]\n```"))
          (supertag-ai-test-deliver request text)
          (should (eq 'failed (plist-get (gethash "document-node" supertag-ai--candidates) :status)))
          (should (equal before (supertag-ai-test-snapshot file)))))
      (dolist (text '("```json\n{\"AUTHOR\":{\"value\":\"Ada\"}}\n```"
                      "Here you go: {\"AUTHOR\":{\"value\":\"Ada\"}} done"))
        (supertag-ai-test-deliver request text)
        (should (eq 'done (plist-get (gethash "document-node" supertag-ai--candidates) :status)))))))

(ert-deftest supertag-ai-source-quotes-are-verified-against-sent-body ()
  (supertag-document-test-with-vault
    (supertag-ai-test-with-request
      (let ((supertag-ai-max-body-chars 25))
        (with-current-buffer (find-file-noselect file)
          (goto-char (point-max)) (insert "written by\nAda\nBeyond sent body\n")
          (goto-char (point-min)) (supertag-ai-extract-properties)))
      (supertag-ai-test-deliver request "{\"AUTHOR\":{\"value\":\"Ada\",\"source\":\"written by Ada\"},\"FAKE\":{\"value\":\"x\",\"source\":\"Invented quote\"},\"EMPTY\":{\"value\":\"x\",\"source\":\"  \"},\"BEYOND\":{\"value\":\"x\",\"source\":\"Beyond sent body\"}}")
      (let* ((entry (gethash "document-node" supertag-ai--candidates))
             (candidates (plist-get entry :candidates)))
        (should (= 25 (length (plist-get entry :body))))
        (should (plist-get (car candidates) :source-verified))
        (dolist (candidate (cdr candidates)) (should-not (plist-get candidate :source-verified))))
      (with-temp-buffer
        (supertag-ai-insert-section "document-node")
        (should (string-match-p "      written by Ada" (buffer-string)))
        (should (string-match-p "      Invented quote" (buffer-string)))
        (should (string-match-p "      Beyond sent body" (buffer-string)))
        (should-not (string-match-p "⚠ Not found in the body\\|unverified:" (buffer-string)))
        (should-not (string-match-p "      [[:space:]]*\n" (buffer-string)))))))

(ert-deftest supertag-ai-late-response-cannot-replace-a-new-request ()
  (supertag-document-test-with-vault
    (supertag-ai-test-with-request
      (with-current-buffer (find-file-noselect file)
        (goto-char (point-min)) (supertag-ai-extract-properties)
        (let ((a request))
          (supertag-ai-discard "document-node")
          (supertag-ai-extract-properties)
          (supertag-ai-test-deliver request "{\"AUTHOR\":{\"value\":\"B\"}}")
          (let ((before (copy-tree (gethash "document-node" supertag-ai--candidates))))
            (supertag-ai-test-deliver a "{\"AUTHOR\":{\"value\":\"A\"}}")
            (should (equal before (gethash "document-node" supertag-ai--candidates))))))))
)

(ert-deftest supertag-ai-disk-reader-ignores-example-id-before-real-target ()
  (supertag-document-test-with-vault
    (supertag-ai-test-with-request
      (with-current-buffer (find-file-noselect file)
        (goto-char (point-min)) (supertag-ai-extract-properties)
        (supertag-ai-test-deliver request "{\"AUTHOR\":{\"value\":\"Ada\"}}")
        (goto-char (point-min))
        (insert "* Example\n:PROPERTIES:\n:ID: decoy\n:AUTHOR: Ada\n:END:\n#+begin_src org\n:ID: document-node\n#+end_src\n")
        (save-buffer)
        (goto-char (point-min)) (re-search-forward "^\\* Property Node")
        (org-back-to-heading t) (org-entry-put nil "AUTHOR" "Ada")
        (let ((disk (supertag-document-test-disk file)))
          (should-not (supertag-ai--disk-value "document-node" "AUTHOR"))
          (should-not (supertag-ai-accept "document-node" "AUTHOR"))
          (should (plist-get (gethash "document-node" supertag-ai--candidates) :candidates))
          (should (equal disk (supertag-document-test-disk file))))
        (save-buffer)
        (should (equal "Ada" (supertag-ai--disk-value "document-node" "AUTHOR")))
        (should (supertag-ai-accept "document-node" "AUTHOR"))))))

(ert-deftest supertag-ai-disk-reader-rejects-only-examples-and-ambiguous-ids ()
  (supertag-document-test-with-vault
    (with-current-buffer (find-file-noselect file)
      (goto-char (point-min)) (org-entry-delete nil "ID")
      (org-entry-put nil "AUTHOR" "Ada")
      (goto-char (point-max))
      (insert "\n:ID: document-node\n#+begin_src org\n:ID: document-node\n#+end_src\n")
      (save-buffer)

(ert-deftest supertag-ai-cancel-refresh-reentry-cannot-notify-new-owner ()
  (supertag-ai-test-with-batch
    (cl-letf (((symbol-function 'supertag-ai--submit)
               (lambda (req)
                 (push req requests)
                 (list :run-id (format "run%d" (length requests)))))
              ((symbol-function 'superchat-runtime-cancel) #'ignore))
      (supertag-ai-extract-tag-properties)
      (let* ((old (car requests)) new-entry new-batch reentered
             (during-refresh
              (lambda (id)
                (when (and (not reentered) (equal id "n1")
                           (eq 'cancelled (plist-get (gethash id supertag-ai--candidates) :status)))
                  (setq reentered t)
                  (supertag-ai--reset-runtime)
                  (supertag-ai-extract-tag-properties)
                  (setq new-entry (gethash "n1" supertag-ai--candidates)
                        new-batch supertag-ai--batch)))))
        ;; Reenter after the actual refresh, exercising the cancel caller's seam.
        (advice-add 'supertag-ai--refresh :after during-refresh)
        (unwind-protect (supertag-ai-cancel "n1")
          (advice-remove 'supertag-ai--refresh during-refresh))
        (should reentered)
        (should (eq new-entry (gethash "n1" supertag-ai--candidates)))
        (should (eq new-batch supertag-ai--batch))
        (should (equal "n1" (plist-get new-batch :current)))
        (should (eq 'pending (plist-get new-entry :status)))
        (should (equal "run2" (plist-get new-entry :run-id)))
        (should (= 2 (length requests)))
        (supertag-ai-test-deliver old "{}")
        (should (eq new-entry (gethash "n1" supertag-ai--candidates)))
        (should (= 2 (length requests)))))))

(defun supertag-ai-test--terminal-refresh-reentry (status)
  "Deliver STATUS through the real refresh/reset seam into a replacement batch."
  (supertag-ai-test-with-batch
    (cl-letf (((symbol-function 'supertag-ai--submit)
               (lambda (req)
                 (push req requests)
                 (list :run-id (format "run%d" (length requests))))))
      (supertag-ai-extract-tag-properties)
      (let* ((old (car requests))
             (old-token (plist-get (gethash "n1" supertag-ai--candidates) :token))
             (disk (supertag-document-test-disk file))
             new-entry new-batch reentered
             (after-refresh
              (lambda (id)
                (when (and (not reentered) (equal id "n1")
                           (memq (plist-get (gethash id supertag-ai--candidates) :status)
                                 '(done failed cancelled)))
                  (setq reentered t)
                  (supertag-ai--reset-runtime)
                  (supertag-ai-extract-tag-properties)
                  (setq new-entry (gethash "n1" supertag-ai--candidates)
                        new-batch supertag-ai--batch)))))
        (advice-add 'supertag-ai--refresh :after after-refresh)
        (unwind-protect
            (if (eq status 'cancelled)
                (cl-letf (((symbol-function 'superchat-runtime-cancel)
                           (lambda (_run)
                             (supertag-ai-test-deliver old "cancelled" 'cancelled))))
                  (supertag-ai-cancel "n1"))
              (supertag-ai-test-deliver old "{}" status))
          (advice-remove 'supertag-ai--refresh after-refresh))
        (should reentered)
        (should (eq new-entry (gethash "n1" supertag-ai--candidates)))
        (should (eq new-batch supertag-ai--batch))
        (should-not (eq old-token (plist-get new-entry :token)))
        (should (equal "run2" (plist-get new-entry :run-id)))
        (should (eq 'pending (plist-get new-entry :status)))
        (should (= 2 (length requests)))
        (should (equal "n1" (plist-get new-batch :current)))
        (should (equal '("n2" "n3") (plist-get new-batch :queue)))
        (should-not (plist-get new-batch :done))
        ;; Duplicate and late old terminal callbacks cannot notify the new owner.
        (dolist (late-status '(completed failed cancelled))
          (supertag-ai-test-deliver old "{}" late-status)
          (should (= 2 (length requests)))
          (should (eq new-entry (gethash "n1" supertag-ai--candidates)))
          (should (eq 'pending (plist-get new-entry :status)))
          (should (equal "n1" (plist-get new-batch :current))))
        (should (equal disk (supertag-document-test-disk file)))))))

(ert-deftest supertag-ai-cancel-delivery-refresh-preserves-replacement-owner ()
  (supertag-ai-test--terminal-refresh-reentry 'cancelled))


            (should (equal (buffer-string) supertag-query-block--syntax-reference-text)))
          (princ "QUERY-D-DONE menu-syntax\n"))
         ('menu-build
          (let ((answers '("term" "and" "term" "no" "Copy to kill-ring"))
                (texts '("Needle" "Other")))
            (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) (pop answers)))
                      ((symbol-function 'read-string) (lambda (&rest _) (pop texts)))
                      ((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
              (call-interactively #'supertag-menu--query-build))
            (should-not answers) (should-not texts)
            (should (equal "(not (and (term \"Needle\") (term \"Other\")))" (car kill-ring))))
          (supertag--ensure-store)
          (supertag-store-put-entity :nodes "p" '(:id "p" :title "Needle" :tags ("root") :properties (:ROLE "real")))
          (supertag-store-put-entity :tags "root" '(:id "root" :name "root"))
          (supertag-store-put-entity :relations "r" '(:id "r" :from "p" :to "p" :type :reference :kind :document-link :origin :org :relation-name "knows"))
          (let ((facts (prin1-to-string supertag--store)))
            (cl-letf (((symbol-function 'completing-read)
                       (lambda (_prompt candidates &rest _) (should (member "root" candidates)) "root")))
              (should (equal "root" (supertag-query-block--read-tag-name))))
            (cl-letf (((symbol-function 'completing-read)
                       (lambda (_prompt candidates &rest _) (should (equal '("knows") candidates)) "knows")))
              (should (equal "knows" (supertag-query-block--read-link-reference))))
            (dolist (action '("Insert block" "Run now"))
              (let ((answers (list "term" "no" action)))
                (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) (pop answers)))
                          ((symbol-function 'read-string) (lambda (&rest _) "Needle"))
                          ((symbol-function 'y-or-n-p) (lambda (&rest _) nil)))
                  (call-interactively #'supertag-menu--query-build))
                (should-not answers)))
            (with-current-buffer target (should (string-match-p (regexp-quote "#+BEGIN_SRC") (buffer-string))))
            (with-current-buffer "*Supertag Query Results*"

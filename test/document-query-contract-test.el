;;; document-query-contract-test.el --- Q document contracts -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'supertag-query)
(require 'document-fixture)

(ert-deftest supertag-document-query-normalization-and-validation ()
  "Q validates its two inputs without implicitly initializing a library."
  (should (eq :STAGE (supertag-note-query-normalize-property-key "sTaGe")))
  (dolist (bad '(nil 12 "" :STAGE))
    (should-error (supertag-note-query-normalize-property-key bad))
    (should-error (supertag-note-query-read-node bad)))
  (let ((supertag--store nil))
    (should-error (supertag-note-query-read-node "absent"))
    (should-not supertag--store)))

(ert-deftest supertag-document-query-real-projection-empty-missing-and-zero-write ()
  "Read real document values without changing text, identities or Store."
  (supertag-document-test-with-vault
    (with-current-buffer (find-file-noselect plain)
      (goto-char (point-max)) (insert "Unsent draft.\n")
      (let ((live (buffer-string)) (disk (supertag-document-test-disk plain))
            (store (prin1-to-string supertag--store)))
        (let* ((result (supertag-note-query-read-node "document-node"))
               (entries (plist-get result :properties)))
          (should (equal "Property Node" (plist-get (plist-get result :node) :title)))
          (should (equal '("ALPHA" "EMPTY" "ZETA")
                         (mapcar (lambda (e) (plist-get e :name)) entries)))
          (should (equal '("first" "" "last")
                         (mapcar (lambda (e) (plist-get e :value)) entries)))
          (should (= 3 (plist-get result :property-count)))
          (should-not (supertag-note-query-read-node "missing")))
        (should (equal store (prin1-to-string supertag--store)))
        (should (equal live (buffer-string)))
        (should (equal disk (supertag-document-test-disk plain)))
        (should (buffer-modified-p))
        (should-not (org-entry-get nil "ID"))))))

(ert-deftest supertag-document-query-return-isolation ()
  "Mutating returned nested containers and strings cannot mutate Store."
  (supertag-document-test-with-vault
    (let* ((raw (supertag-store-get-entity :nodes "document-node"))
           (nested (make-hash-table :test 'equal)))
      (puthash "key" (vector (list "original")) nested)
      (put-text-property 0 1 'payload (list "kept") (plist-get raw :title))
      (supertag-store-put-entity :nodes "document-node"
                                 (plist-put raw :test-payload nested))
      (let* ((before (prin1-to-string supertag--store))
             (result (supertag-note-query-read-node "document-node"))
             (node (plist-get result :node)))
        (should (equal-including-properties (plist-get raw :title) (plist-get node :title)))
        (setcar (get-text-property 0 'payload (plist-get node :title)) "changed")
        (aset (plist-get node :title) 0 ?X)
        (setcar (aref (gethash "key" (plist-get node :test-payload)) 0) "changed")
        (aset (plist-get (car (plist-get result :properties)) :value) 0 ?X)
        (aset (plist-get result :id) 0 ?X)
        (should (equal before (prin1-to-string supertag--store)))))))

(ert-deftest supertag-document-query-distinguishes-disk-and-live-projections ()
  "Queue input is saved S1; explicit live projection reads unsaved S2."
  (supertag-document-test-with-vault
    (supertag-document-test-save-property file "ALPHA" "saved-S1")
    (with-current-buffer (find-file-noselect file)
      (goto-char (point-min)) (org-entry-put nil "ALPHA" "live-S2"))
    (supertag-document-test-drain)
    (should (equal "saved-S1" (plist-get (car (plist-get
                  (supertag-note-query-read-node "document-node") :properties)) :value)))
    (with-current-buffer (find-file-noselect file)
      (let ((live (buffer-string)))
        (goto-char (point-min)) (supertag-node-sync-at-point)
        (should (equal live (buffer-string)))
        (should (buffer-modified-p))))
    (should (equal "live-S2" (plist-get (car (plist-get
                  (supertag-note-query-read-node "document-node") :properties)) :value)))
    (should (string-match-p "saved-S1" (supertag-document-test-disk file)))))

(provide 'document-query-contract-test)

(ert-deftest supertag-document-query-independent-source-load ()
  "A fresh unified Query retains initialized Store reads without heavy providers."
  (supertag-document-query--a-cold 'after 'leaf))

(ert-deftest supertag-document-query-normalized-stable-order-and-current-library ()
  "Normalize once, keep equal-name order, and read the current Store each time."
  (let ((supertag--store nil))
    (supertag--ensure-store)
    (supertag-store-put-entity :nodes "node"
                              '(:id "node" :properties (:z "last" "alpha" "first" :Alpha "second")))
    (let ((entries (plist-get (supertag-note-query-read-node "node") :properties)))
      (should (equal '(:ALPHA :ALPHA :Z) (mapcar (lambda (e) (plist-get e :key)) entries)))
      (should (equal '("first" "second" "last") (mapcar (lambda (e) (plist-get e :value)) entries))))
    (let ((supertag--store nil))
      (supertag--ensure-store)
      (should-not (supertag-note-query-read-node "node")))))

(ert-deftest supertag-document-query-bool-vector-return-isolation ()
  "Boolean vectors retain their type/content without sharing Store storage."
  (let ((supertag--store nil)
        (flags (bool-vector nil t nil t)))
    (supertag--ensure-store)
    (supertag-store-put-entity
     :nodes "flags" (list :id "flags" :properties (list :FLAGS flags)
                           :payload (vector (list flags))))
    (let* ((result (supertag-note-query-read-node "flags"))
           (property (plist-get (car (plist-get result :properties)) :value))
           (nested (car (aref (plist-get (plist-get result :node) :payload) 0))))
      (dolist (returned (list property nested))
        (should (bool-vector-p returned))
        (should (equal flags returned)))
      (aset property 0 t)
      (aset nested 1 nil)
      (should (equal (bool-vector nil t nil t) flags))
      (should-not (eq property flags))
      (should-not (eq nested flags)))))

(ert-deftest supertag-document-query-long-flat-list-nested-isolation ()
  "Flat list length does not consume recursion depth; nested values detach."
  (let ((supertag--store nil)
        (depth max-lisp-eval-depth)
        (refs (mapcar (lambda (n) (format "node-%d" n))
                      (number-sequence 0 999)))
        (pair (cons "head" "tail")))
    (supertag--ensure-store)
    (supertag-store-put-entity
     :nodes "many" (list :id "many" :ref-to refs
                         :payload (list refs pair)))
    (let* ((result (supertag-note-query-read-node "many"))
           (node (plist-get result :node))
           (returned (plist-get node :ref-to))
           (nested (plist-get node :payload)))
      (should (= 1000 (length returned)))
      (should (equal refs returned))
      (should (equal pair (cadr nested)))
      (aset (nth 999 returned) 0 ?X)
      (setcar (car nested) "changed")
      (aset (cdr (cadr nested)) 0 ?X)
      (should (equal "node-999" (nth 999 refs)))
      (should (equal "node-0" (car refs)))
      (should (equal '("head" . "tail") pair))
      (should (= depth max-lisp-eval-depth)))))

;;; Query-A first-use contracts, each in an independent source process.
(defconst supertag-document-query--a-root
  (file-name-directory (directory-file-name (file-name-directory (or load-file-name buffer-file-name)))))
(defun supertag-document-query--a-cold (stage scenario)
  (let* ((tmp (make-temp-file "supertag-query-a-" t))
         (root supertag-document-query--a-root)
         (program (or (getenv "EMACS_BIN") (expand-file-name invocation-name invocation-directory)))
         (deps (split-string (or (getenv "SUPERTAG_DEPS_LOADPATH") "") path-separator t))
         (process-environment (copy-sequence process-environment))
         (script (expand-file-name "cold.el" tmp))
         (body '
(progn
  (require 'cl-lib) (require 'ert) (require 'org)
  (setq user-emacs-directory (file-name-as-directory qa-tmp)
        supertag-data-directory (expand-file-name "data/" qa-tmp)
        supertag--base-data-directory supertag-data-directory
        supertag-db-file (expand-file-name "store.el" supertag-data-directory)
        supertag-db-backup-directory (expand-file-name "backups/" qa-tmp)
        supertag-sync-state-file (expand-file-name "sync.el" qa-tmp)
        supertag-sync--state-source supertag-sync-state-file
        supertag-sync-directories (list qa-tmp) supertag-sync-directories-mode 'unified
        supertag-sync-exclude-directories nil supertag-sync-file-pattern "\\.org$"
        org-id-locations-file (expand-file-name "ids" qa-tmp)
        org-id-locations nil org-id-files nil org-id-track-globally nil
        after-init-time nil org-mode-hook nil
        supertag-view-style-auto-enable t supertag-org-capture-auto-enable t
        global-supertag-ui-completion-mode nil
        make-backup-files nil auto-save-default nil)
  (defun qa-absent (features)
    (dolist (feature features)
      (should-not (featurep feature))
      (should-not (cl-find-if (lambda (row) (and (stringp (car row))
                             (equal (file-name-base (car row)) (symbol-name feature)))) load-history))))
  (defun qa-provider (symbol file)
    (should-not (autoloadp (symbol-function symbol)))
    (should (equal (symbol-file symbol 'defun) (expand-file-name file qa-root)))
    (princ (format "QUERY-A-PROVIDER %S %s\n" symbol file)))
  (defun qa-seed ()
    (supertag--ensure-store)
    (dolist (row '(("p" :id "p" :title "Alpha" :content "needle" :tags ("parent") :properties (:SCORE 2 :EMPTY "" :GROUP "x"))
                   ("c" :id "c" :title "Beta" :content "needle" :tags ("child") :properties (:SCORE 4 :GROUP "x"))
                   ("m" :id "m" :title "Missing" :content "other" :tags nil :properties nil)))
      (supertag-store-put-entity :nodes (car row)
        (plist-put (copy-tree (cdr row)) :created-at (encode-time 0 0 0 2 1 2020))))
    (supertag-store-put-entity :tags "parent" '(:id "parent" :name "root"))
    (supertag-store-put-entity :tags "child" '(:id "child" :name "child" :extends ("parent")))
    (supertag-store-put-entity :relations "named" '(:id "named" :from "p" :to "c" :type :reference :kind :document-link :origin :org :relation-name "knows"))
    (supertag-store-put-entity :relations "plain" '(:id "plain" :from "p" :to "m" :type :reference :kind :document-link :origin :org)))
  (let* ((file (expand-file-name "input.org" qa-tmp))
         (text "* Saved\n:PROPERTIES:\n:ID: saved\n:ALPHA: first\n:END:\nBody.\n")
         (ordinary (get-buffer-create " *query-a-ordinary*"))
         target hooks)
    (with-temp-file file (insert text))
    (setq target (find-file-noselect file))
    (with-current-buffer target (org-mode))
    (setq hooks (list (copy-tree org-mode-hook)
                     (and (boundp 'org-capture-after-finalize-hook) (copy-tree org-capture-after-finalize-hook))
                     (and (boundp 'enable-theme-functions) (copy-tree enable-theme-functions))))
    (when (memq qa-case '(tag-first node-first))
      (load (expand-file-name (if (eq qa-case 'tag-first) "supertag-tag.el" "supertag-node.el") qa-root) nil nil t))
    (load (expand-file-name
           (if (eq qa-stage 'after) "supertag-query.el"
             (if (eq qa-case 'leaf) "supertag-services-note-query.el" "supertag-services-query.el")) qa-root) nil nil t)
    (princ (format "QUERY-A-ENTRY stage=%S case=%S\n" qa-stage qa-case))
    (when (or (eq qa-case 'owner) (eq qa-stage 'after))
      (dolist (symbol qa-symbols) (qa-provider symbol "supertag-query.el"))
      (dolist (old '("supertag-services-query.el" "supertag-services-note-query.el"))
        (should-not (file-exists-p (expand-file-name old qa-root)))))
    (cond
     ((or (eq qa-case 'leaf) (and (eq qa-stage 'after) (not (memq qa-case '(tag-first node-first)))))
      (qa-absent '(supertag-core-scan supertag-node supertag-tag supertag-ops-node
                   supertag-services-sync supertag-service-org supertag-services-ui
                   supertag-ui-commands supertag-services-formula supertag-automation))
      (when (eq qa-stage 'after) (qa-absent '(supertag-services-query supertag-services-note-query)))
      (should (equal hooks (list org-mode-hook
                               (and (boundp 'org-capture-after-finalize-hook) org-capture-after-finalize-hook)
                               (and (boundp 'enable-theme-functions) enable-theme-functions))))
      (dolist (b (list target ordinary))
        (with-current-buffer b
          (should-not (bound-and-true-p supertag-view-style-mode))
          (should-not (bound-and-true-p supertag-ui-completion-mode))))
      (should-not supertag--store))
     ((eq qa-stage 'before)
      (should (featurep 'supertag-tag)) (should (featurep 'supertag-node))
      (should (featurep 'supertag-services-formula))
      (princ "QUERY-A-OLD-HEAVY Tag/Node/Formula loaded\n")))
    (should-not global-supertag-ui-completion-mode)
    (should-not (file-exists-p supertag-db-file))
    (should-error (supertag-note-query-read-node "absent"))
    (qa-seed)
    (let ((facts (prin1-to-string supertag--store)))
      (pcase qa-case
        ((or 'leaf 'heavy 'owner)
         (should-not (supertag-note-query-read-node "missing"))
         (let* ((result (supertag-note-query-read-node "p"))
                (entries (plist-get result :properties)))
           (should (equal '("EMPTY" "GROUP" "SCORE") (mapcar (lambda (x) (plist-get x :name)) entries)))
           (should (equal "" (plist-get (car entries) :value)))
           (aset (plist-get (plist-get result :node) :title) 0 ?X))
         (should-error (supertag-note-query-normalize-property-key :SCORE)))
        ('node
         (should (eq (supertag-store-get-entity :nodes "p") (supertag-query-node "p")))
         (should (= 2 (supertag-query-property-value "p" "score")))
         (qa-provider 'supertag-node-get "supertag-node.el"))
        ('tag
         (should (equal '((:id "parent" :name "root" :display "root")
                          (:id "child" :name "child" :display "root › child"))
                        (supertag-query-tag-descriptors)))
         (should (= 2 (length (supertag-query-tags))))
         (qa-provider 'supertag--ensure-plist "supertag-tag.el")
         (qa-provider 'supertag-tag-display-name "supertag-tag.el"))
        ('scan
         (should (equal '("p") (supertag-query-node-ids-by-tag "parent")))
         (should (equal '("c" "p") (sort (copy-sequence (supertag-query-node-ids-by-tag "parent" t)) #'string<)))
         (should (equal '("c" "p") (sort (supertag-query-node-ids '(term "needle")) #'string<)))
         (should (equal '("c" "m" "p") (sort (supertag-query-node-ids '(between "2020-01-01" "2020-01-03")) #'string<)))
         (dolist (s '(supertag-index-get-nodes-by-tag supertag-index-get-nodes-by-word supertag-index-get-nodes-by-date-range)) (qa-provider s (if (eq qa-stage 'before) "supertag-core-scan.el" "supertag-query.el"))))
        ('relation
         (should (equal '("p") (supertag-query-node-ids '(has-link "knows"))))
         (should (equal '("c") (supertag-query-node-ids '(has-reverse-link knows))))
         (should (equal '("named") (mapcar (lambda (x) (plist-get x :id)) (supertag-query-named-links-from "p" "knows"))))
         (should (equal '("named") (mapcar (lambda (x) (plist-get x :id)) (supertag-query-named-links-to "c" "knows"))))
         (should (equal '("plain") (mapcar (lambda (x) (plist-get x :id)) (supertag-query-ordinary-references-from "p"))))
         (should-error (supertag-query-node-ids '(has-link "")))
         (dolist (s '(supertag-relation-named-document-link-p supertag-relation-find-by-from supertag-relation-find-by-to)) (qa-provider s (if (or (eq qa-stage 'before) (equal (getenv "SUPERTAG_LC_STAGE") "before")) "supertag-ops-relation.el" "supertag-link.el"))))
        ('formula
         (should (= 0 (supertag-query-evaluate '(sum "SCORE"))))
         (should (= 6 (supertag-query-evaluate '(and (sum "SCORE")))))
         (should (= 3 (supertag-query-evaluate '(and (avg "SCORE")))))
         (qa-provider 'supertag-rollup-apply
                      (if (eq qa-stage 'before)
                          "supertag-services-formula.el"
                        "supertag-query.el"))
         (should-not (featurep 'supertag-automation))
         (should (equal '("p" "c" "m") (supertag-query-node-ids '(sort-by "SCORE" asc))))
         (should (equal '(("__ungrouped__" . 0) ("x" . 6)) (supertag-query-evaluate '(and (group-by "GROUP") (sum "SCORE")))))
         (should (= 2.5 (supertag-query--numeric " 2.5 ")))
         (should-not (supertag-query--numeric "two"))
         (should-error (supertag-query-node-ids '(sum "SCORE")))
         (should (= 0 (supertag-query-evaluate '(and (property "GROUP" "none") (sum "SCORE"))))))
        ((or 'tag-first 'node-first)
         (should (equal '("p") (supertag-query-node-ids-by-tag "parent")))
         (should (= 2 (supertag-query-property-value "p" "SCORE")))
         (load (expand-file-name (if (eq qa-stage 'after) "supertag-query.el" "supertag-services-query.el") qa-root) nil nil t)
         (should (equal '("p") (supertag-query-node-ids-by-tag "parent")))
         (should supertag-view-style-auto-enable) (should supertag-org-capture-auto-enable))
        ('sync
         (load (expand-file-name "supertag-services-sync.el" qa-root) nil nil t)
         (when (eq qa-stage 'after) (qa-absent '(supertag-core-scan)))
         (princ (format "QUERY-A-SYNC-BEFORE scan=%S\n" (featurep 'supertag-core-scan)))
         (let ((counters (list :nodes-created 0 :nodes-updated 0 :nodes-deleted 0)))
           (supertag-sync--process-single-file file counters))
         (should (equal "Saved" (plist-get (supertag-store-get-entity :nodes "saved") :title)))
         (should (equal '("saved") (mapcar #'car (supertag-find-nodes-by-file file))))
         (qa-provider 'supertag-find-nodes-by-file
                      (if (eq qa-stage 'before) "supertag-core-scan.el" "supertag-query.el"))))
      (unless (eq qa-case 'sync) (should (equal facts (prin1-to-string supertag--store)))))
    (with-current-buffer target (should (equal text (buffer-string))) (should-not (buffer-modified-p)))
    (should (equal text (with-temp-buffer (insert-file-contents file) (buffer-string))))
    (princ "QUERY-A-PASS\n")))
))
    (unwind-protect
        (progn
          (with-temp-file script
            (insert ";;; -*- lexical-binding: t; -*-\n")
            (prin1 `(setq qa-root ,root qa-tmp ,tmp qa-stage ',stage qa-case ',scenario
                          qa-symbols '(supertag-note-query-normalize-property-key supertag-note-query-read-node supertag-query-link--relation-name supertag-query-link--parse-binary supertag-query-link--parse-unary supertag-query-link--unique supertag-query-link--execute-forward supertag-query-link--execute-reverse supertag-query-link--execute-has-out supertag-query-link--execute-has-in supertag-query-normalize-property-key supertag-query-node supertag-query-tag-descriptors supertag-query-tags supertag-query-node-ids-by-tag supertag-query-automations supertag-query-tag-occurrences supertag-query-relations supertag-query-property-value supertag-query-relations-from supertag-query-relations-to supertag-query-named-links-from supertag-query-named-links-to supertag-query-ordinary-references-from supertag-query-ordinary-references-to supertag-query-relations-among supertag-query-node-tags supertag-query-node-properties supertag-query-node-detail supertag-query supertag-query-nodes supertag-query-node-ids supertag-query-evaluate supertag-query-sexp supertag-query-properties supertag-query-validate supertag-query-date-valid-p supertag-query-expand supertag-query--date-arg supertag-query--modifier-ast-p supertag-query--parse-sexp supertag-query--execute-ast supertag-query--get-all-node-ids supertag-query--ast-modifiers supertag-query--numeric supertag-query--value< supertag-query--sort-value supertag-query--sort-node-ids supertag-query--aggregate-values supertag-query--group-values supertag-query--apply-modifiers supertag-query-modifiers supertag-query--resolve-date-string supertag-query--get-properties-from-ast)) (current-buffer))
            (insert "\n")
            (let ((print-length nil) (print-level nil))
              (prin1 `(condition-case err
                          (unwind-protect ,body
                            (setq emacs-startup-hook nil kill-emacs-hook nil org-mode-hook nil
                                  org-capture-after-finalize-hook nil enable-theme-functions nil)
                            (when (fboundp 'org-id-find)
                              (advice-remove 'org-id-find 'supertag-service-org--org-id-find-advice))
                            (mapc #'cancel-timer (append timer-list timer-idle-list))
                            (dolist (b (buffer-list))
                              (when (or (member (buffer-name b) '(" *query-a-ordinary*"))
                                        (and (buffer-file-name b) (file-in-directory-p (buffer-file-name b) qa-tmp)))
                                (with-current-buffer b (set-buffer-modified-p nil) (kill-buffer b)))))
                        (error (princ (format "QUERY-A-ERROR %S\n" err)) (kill-emacs 1))) (current-buffer))))
          ;; Pin the child cwd before HOME is repointed.
          (setq default-directory (file-truename default-directory))
          (setenv "HOME" tmp) (setenv "CFFIXED_USER_HOME" tmp)
          (setenv "EMACSLOADPATH" (concat (mapconcat #'identity deps path-separator) path-separator))
          (with-temp-buffer
            (let ((status (apply #'call-process program nil t nil
                                 (append '("-Q" "--batch")
                                         (apply #'append (mapcar (lambda (dir) (list "-L" dir)) deps))
                                         (list "-L" root "-l" script)))))
              (unless (and (equal status 0) (string-match-p "QUERY-A-ENTRY" (buffer-string))
                           (string-match-p "QUERY-A-PASS" (buffer-string)))
                (ert-fail (format "QUERY-A %S/%S exit=%S\n%s" stage scenario status (buffer-string))))
              (dolist (line (split-string (buffer-string) "\n" t))
                (when (string-prefix-p "QUERY-A-" line) (princ (concat line "\n")))))))
      (delete-directory tmp t))))


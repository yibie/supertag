       supertag-db-backup-directory (expand-file-name "backups/" qd-tmp)
       supertag-sync-state-file (expand-file-name "sync.el" qd-tmp)
       supertag-sync--state-source supertag-sync-state-file
       supertag-sync-directories nil org-id-locations-file (expand-file-name "ids" qd-tmp)
       org-id-locations nil org-id-files nil org-id-track-globally nil
       after-init-time nil make-backup-files nil auto-save-default nil

          (should (equal "first" (supertag-view-api-node-property "document-node" "aLpHa")))
          (should (equal "" (supertag-view-api-node-property "document-node" "EMPTY")))
          (should-not (supertag-view-api-node-property "document-node" "MISSING")))
        (dolist (bad '(nil "" 1 :ALPHA))
          (should-error (supertag-view-api-node-property "document-node" bad)))
        (should-not (supertag-view-api-node-property "absent" "ALPHA"))
        (should (equal disk (supertag-document-test-disk file)))
        (should (equal live (buffer-string))) (should (eq dirty (buffer-modified-p)))
        (should (equal facts (prin1-to-string supertag--store)))
        (should (equal ids (prin1-to-string org-id-locations)))))
    (princ "QUERY-E-DONE saved-properties\n")))

(defun supertag-document-query--e-cold (scenario)
  (let* ((root supertag-document-query--a-root)
         (stage (if (equal (getenv "SUPERTAG_QE_STAGE") "before") 'before 'after))
         (tmp (make-temp-file "supertag-query-e-" t))
         (script (expand-file-name "cold.el" tmp))
         (deps (split-string (or (getenv "SUPERTAG_DEPS_LOADPATH") "") path-separator t))
         (process-environment (copy-sequence process-environment))
         (body
          '(progn
             (require 'ert) (require 'cl-lib)
             (setq user-emacs-directory (file-name-as-directory qe-tmp)
                   supertag-data-directory (expand-file-name "data/" qe-tmp)
                   supertag--base-data-directory supertag-data-directory
                   supertag-db-file (expand-file-name "store.el" qe-tmp)
                   supertag-db-backup-directory (expand-file-name "backups/" qe-tmp)
                   supertag-sync-state-file (expand-file-name "sync.el" qe-tmp)
                   supertag-sync--state-source supertag-sync-state-file
                   supertag-sync-directories nil
                   org-id-locations-file (expand-file-name "ids" qe-tmp)
                   org-id-locations nil org-id-files nil org-id-track-globally nil
                   after-init-time nil make-backup-files nil auto-save-default nil
                   org-mode-hook nil org-babel-load-languages nil
                   global-supertag-ui-completion-mode nil)
             (defun qe-absent (features)
               (dolist (f features)
                 (should-not (featurep f))
                 (should-not (cl-find-if
                              (lambda (row) (and (stringp (car row))
                                                (equal (file-name-base (car row)) (symbol-name f))))
                              load-history))))
             (load (expand-file-name "supertag-query.el" qe-root) nil nil t)
             (princ (format "QUERY-E-ENTRY %s query=%S\n" qe-case (featurep 'supertag-query)))
             (should (featurep 'supertag-query)) (should-not supertag--store)
             (qe-absent '(supertag-node supertag-tag supertag-view-api supertag-services-ui
                                       supertag-services-sync supertag-ops-relation supertag-link))
             (if (eq qe-case 'owner)
                 (progn
                   (dolist (f qe-forms)
                     (should (equal (symbol-file f 'defun) (expand-file-name "supertag-query.el" qe-root))))
                   (load (expand-file-name (if (or (eq qe-stage 'before) (equal (getenv "SUPERTAG_VWB_STAGE") "before")) "supertag-view-api.el" "supertag-view-framework.el") qe-root) nil nil t)
                   (load (expand-file-name (if (or (eq qe-stage 'before) (equal (getenv "SUPERTAG_VWB_STAGE") "before")) "supertag-view-api.el" "supertag-view-framework.el") qe-root) nil nil t)
                   (dolist (f qe-forms)
                     (should (equal (symbol-file f 'defun) (expand-file-name "supertag-query.el" qe-root))))
                   (should (equal (symbol-file 'supertag-view-api-subscribe 'defun)
                                  (expand-file-name (if (or (eq qe-stage 'before) (equal (getenv "SUPERTAG_VWB_STAGE") "before")) "supertag-view-api.el" "supertag-view-framework.el") qe-root))))
               (when (eq qe-stage 'before)
                 (load (expand-file-name "supertag-view-api.el" qe-root) nil nil t))
               (supertag--ensure-store)
               (cond
                ((eq qe-case 'relation)
                 (let ((record (list :id "embedded-relation" :from "a" :to "b")))
                   (supertag-store-put-entity :relations "relation-key" record)
                   (princ "QUERY-E-RELATION-CALL\n")
                   (should (eq record (supertag-view-api-get-entity :relation "relation-key")))
                   (should (equal "embedded-relation"
                                  (plist-get (supertag-view-api-get-entity :relations "relation-key") :id)))
                   (should-not (autoloadp (symbol-function 'supertag-relation-get)))
                   (should (equal (symbol-file 'supertag-relation-get 'defun)
                                  (expand-file-name (if (or (eq qe-stage 'before) (equal (getenv "SUPERTAG_LC_STAGE") "before")) "supertag-ops-relation.el" "supertag-link.el") qe-root)))
                   (should (cl-find-if (lambda (row) (and (stringp (car row))
                                                        (equal (file-name-base (car row)) (if (or (eq qe-stage 'before) (equal (getenv "SUPERTAG_LC_STAGE") "before")) "supertag-ops-relation" "supertag-link")))) load-history))))
                ((eq qe-case 'node)
                 (let ((record (list :id "n" :title "Node")))
                   (supertag-store-put-entity :nodes "n" record)
                   (should (eq record (supertag-view-api-get-entity :node "n")))
                   (should (featurep 'supertag-node))
                   (should-not (autoloadp (symbol-function 'supertag-node-get)))))
                ((eq qe-case 'tag)
                 (let ((record (list :id "parent" :name "Parent")))
                   (supertag-store-put-entity :tags "parent" record)
                   (should (eq record (supertag-view-api-get-entity :tag "parent")))
                   (should (equal '("parent") (supertag-view-api-list-entity-ids '(:type :tags))))
                   (should (featurep 'supertag-tag))
                   (should-not (autoloadp (symbol-function 'supertag-view-api-list-tag-ids)))))
                (t
                 ;; Direct Store seeds; saved-property control uses real Org projection.
                 (dolist (entry '(("parent" :id "parent" :name "Parent" :aliases ("alias"))
                                  ("parent/child" :id "parent/child" :name "Parent/Child" :extends ("parent"))))
                   (supertag-store-put-entity :tags (car entry) (cdr entry)))
                 (dolist (entry '(("a" :id "a" :title "Alpha" :tags ("parent"))
                                  ("b" :id "b" :title "Beta" :tags ("parent/child"))))
                   (supertag-store-put-entity :nodes (car entry) (cdr entry)))
                 (supertag-store-put-entity :relations "map-key" '(:id "embedded-id" :from "a" :to "b"))
                 (supertag-store-put-entity :automations "z-key" '(:id "rule-z" :name "Zulu"))
                 (supertag-store-put-entity :automations "a-key" '(:id "rule-a" :name "Alpha"))
                 (let ((facts (prin1-to-string supertag--store)))
                   (if (eq qe-case 'dataset)
                       (progn
                         (should (equal '("a" "b") (supertag-view-api-list-entity-ids '(:type :nodes))))
                         (should (equal '("parent" "parent/child") (supertag-view-api-list-entity-ids '(:type :tags))))
                         (dolist (token '("parent" "alias"))
                           (should (equal '("a") (supertag-view-api-list-entity-ids (list :type :tag :value token))))
                           (should (equal '("a" "b") (sort (supertag-view-api-list-entity-ids
                                                          (list :type :tag :value token :include-descendants t)) #'string<))))
                         (should (equal '("embedded-id") (supertag-view-api-list-entity-ids '(:type :relations))))
                         (dolist (type '(:automation :automations))
                           (should (equal '("rule-a" "rule-z") (supertag-view-api-list-entity-ids (list :type type)))))
                         (dolist (type '(:embeds :database :databases))
                           (should-not (supertag-view-api-list-entity-ids (list :type type))))
                         (dolist (type '(:node :relation nil :unknown))
                           (should-error (supertag-view-api-list-entity-ids (list :type type))))
                         (dolist (bad '(nil "" 9))
                           (should-error (supertag-view-api-list-entity-ids (list :type :tag :value bad)))))
                     (dolist (pair '((:node :nodes "a" :nodes "a")
                                     (:tag :tags "parent" :tags "parent")
                                     (:relation :relations "map-key" :relations "map-key")
                                     (:automation :automations "rule-a" :automations "a-key")))
                       (let ((raw (supertag-store-get-entity (nth 3 pair) (nth 4 pair))))
                         (dolist (type (list (car pair) (cadr pair)))
                           (should (eq raw (supertag-view-api-get-entity type (nth 2 pair))))
                           (should-not (supertag-view-api-get-entity type "missing")))))
                     (dolist (type '(:embed :embeds :database :databases :unknown))
                       (should-not (supertag-view-api-get-entity type "a")))
                     (dolist (bad '(nil "" 3))
                       (should-error (supertag-view-api-get-entity :unknown bad)))
                     (let ((rows (supertag-view-api-get-entities :nodes '("b" nil "missing" "a" "b"))))
                       (should (equal '("b" "a" "b") (mapcar (lambda (n) (plist-get n :id)) rows)))
                       (should (eq (car rows) (nth 2 rows))))
                     (should-error (supertag-view-api-get-entities :nodes '("a" ""))))
                   (should (equal facts (prin1-to-string supertag--store))))))
               (should-not (file-exists-p supertag-db-file))
               (princ (format "QUERY-E-COST %s %S\n" qe-case
                              (mapcar (lambda (f) (cons f (featurep f)))
                                      '(supertag-node supertag-tag supertag-view-api supertag-services-ui supertag-services-sync supertag-ops-relation supertag-link)))))
             (princ (format "QUERY-E-DONE %s\n" qe-case)))))
    (unwind-protect
        (progn
          (with-temp-file script
            (insert ";;; -*- lexical-binding: t; -*-\n")
            (prin1 `(setq qe-root ,root qe-tmp ,tmp qe-stage ',stage qe-case ',scenario
                          qe-forms '(supertag-view-api-list-entity-ids supertag-view-api-get-entity
                                     supertag-view-api-get-entities supertag-view-api-node-property))
                   (current-buffer))
            (insert "\n")
            (let ((print-length nil) (print-level nil))
              (prin1 `(condition-case err
                          (unwind-protect ,body
                            (setq kill-emacs-hook nil emacs-startup-hook nil org-mode-hook nil enable-theme-functions nil)
                            (mapc #'cancel-timer (append timer-list timer-idle-list))
                            (dolist (b (buffer-list))
                              (when (and (buffer-file-name b) (file-in-directory-p (buffer-file-name b) qe-tmp))
                                (with-current-buffer b (set-buffer-modified-p nil) (kill-buffer b)))))
                        (error (princ (format "QUERY-E-ERROR %S\n" err)) (kill-emacs 1)))
                     (current-buffer))))
          ;; Pin the child cwd before HOME is repointed.
          (setq default-directory (file-truename default-directory))
          (setenv "HOME" tmp) (setenv "CFFIXED_USER_HOME" tmp)
          (setenv "EMACSLOADPATH" (concat (mapconcat #'identity deps path-separator) path-separator))
          (with-temp-buffer
            (let ((status (apply #'call-process (or (getenv "EMACS_BIN") (expand-file-name invocation-name invocation-directory))
                                 nil t nil (append '("-Q" "--batch")
                                                   (apply #'append (mapcar (lambda (d) (list "-L" d)) deps))
                                                   (list "-L" root "-l" script)))))
              (when-let* ((out (getenv "SUPERTAG_QE_EVIDENCE")))
                (write-region (point-min) (point-max) (expand-file-name (format "%s-%s.log" stage scenario) out) nil 'silent)
                (copy-file script (expand-file-name (format "%s-%s.el" stage scenario) out) t))
              (princ (buffer-string))
              (should (equal status 0))
              (should (string-match-p (format "QUERY-E-ENTRY %s" scenario) (buffer-string)))
              (should (string-match-p (format "QUERY-E-DONE %s" scenario) (buffer-string))))))
      (delete-directory tmp t))))


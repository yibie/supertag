;;; QUERY-B: independent fresh-process computation, not QA historical before.
(defun supertag-document-query--b-cold (scenario)
  (let* ((root supertag-document-query--a-root)
         (stage (if (equal (getenv "SUPERTAG_QB_STAGE") "before") 'before 'after))
         (tmp (make-temp-file "supertag-query-b-" t))
         (script (expand-file-name "cold.el" tmp))
         (deps (split-string (or (getenv "SUPERTAG_DEPS_LOADPATH") "") path-separator t))
         (process-environment (copy-sequence process-environment))
         (body
          '(progn
             (require 'ert) (require 'cl-lib) (require 'org)
             (setq user-emacs-directory (file-name-as-directory qb-tmp)
                   supertag-data-directory (expand-file-name "data/" qb-tmp)
                   org-id-locations-file (expand-file-name "ids" qb-tmp)
                   org-id-track-globally nil after-init-time nil
                   org-mode-hook nil make-backup-files nil auto-save-default nil
                   supertag-view-style-auto-enable t supertag-org-capture-auto-enable t
                   global-supertag-ui-completion-mode nil)
             (let* ((file (expand-file-name "input.org" qb-tmp))
                    (text "* Saved\n:PROPERTIES:\n:ID: qb\n:END:\nBody.\n")
                    (ordinary (get-buffer-create " *qb-ordinary*")) target hooks modes)
               (with-temp-file file (insert text))
               (setq target (find-file-noselect file))
               (with-current-buffer ordinary (insert "Ordinary draft"))
               (setq hooks (mapcar (lambda (s) (and (boundp s) (copy-tree (symbol-value s))))
                                   '(org-mode-hook org-capture-after-finalize-hook enable-theme-functions)))
               (setq modes (mapcar (lambda (b) (with-current-buffer b
                                                (list major-mode (buffer-modified-p))))
                                   (list target ordinary)))
               (load (expand-file-name "supertag-query.el" qb-root) nil nil t)
               (princ "QUERY-B-ENTRY\n")
               (should-not supertag--store)
               (when (eq qb-case 'owner)
                 (dolist (s qb-symbols)
                   (should (equal (symbol-file s 'defun)
                                  (expand-file-name "supertag-query.el" qb-root))))
                 (should-not (file-exists-p (expand-file-name "supertag-services-formula.el" qb-root))))
               ;; Real non-count dispatch resolves the old ordinary provider on before.
               (should (= 6 (supertag-query--aggregate-values
                             '((:id "a" :title 2) (:id "b" :title 4)) 'sum "title")))
               (supertag--ensure-store)
               (supertag-store-put-entity :nodes "qb" '(:id "qb" :properties (:X "2")))
               (let* ((entity '(:id "qb" :properties (:X "9" :BAD " 2" :TEXT "word")))
                      (original (copy-tree entity))
                      (snapshot (prin1-to-string supertag--store)))
                 (pcase qb-case
                   ('sources
                    (should (= 3 (supertag-formula-eval-string "x + 1" "qb")))
                    (should (= 10 (supertag-formula-evaluate "x + 1" entity)))
                    (let (names)
                      (should (= 6 (supertag-formula-evaluate "x + 1" entity
                                      (lambda (name) (push name names) "5"))))
                      (should (equal names '("x"))))
                    (dolist (input '("missing + 1" "bad + 1" "text * 2"))
                      (should-not (supertag-formula-evaluate input entity)))
                    (should (= -9 (supertag-formula-evaluate "-x" entity)))
                    (should (equal 4.5 (supertag-formula-evaluate "x / 2" entity)))
                    (should (= 0 (supertag-formula-evaluate "x / 0" entity)))
                    (should (= 4.5 (supertag-formula-evaluate "n + 1" nil (lambda (_) "3.5"))))
                    (princ "QUERY-B-DONE sources\n"))
                   ('grammar
                    (should (equal '(2 + 3 * 4) (supertag-formula-tokenize "2 + 3 * 4")))
                    (should (= 14 (supertag-formula-eval
                                   (supertag-formula-parse (supertag-formula-tokenize "2 + 3 * 4")) "qb")))
                    (should (= 10 (supertag-formula-evaluate "(+ {{ :x }} 1)" entity)))
                    (should (= 10 (supertag-formula-evaluate "{{x}} + 1" entity)))
                    (should (equal "x + x" (supertag-formula--translate-placeholders "{{:x}} + {{ x }}")))
                    (should-error (supertag-formula-eval-string "{{x}} + 1" "qb"))
                    (dolist (input '("(+ x 1 2)" "(foo x)" "x @ 2" "x +" ""))
                      (should-error (supertag-formula-evaluate input entity)))
                    (should-error (supertag-formula-evaluate nil entity))
                    (princ "QUERY-B-DONE grammar\n"))
                   ('rollup
                    (dolist (row '((count :count 2) (sum :sum 5) (avg :avg 2)
                                   (average :average 2) (min :min 2) (max :max 3)
                                   (first :first 2) (last :last 3)))
                      (dolist (op (list (car row) (cadr row)))
                        (should (= (nth 2 row) (supertag-rollup-apply op '(2 3))))))
                    (dolist (op '(count :count sum :sum avg :avg average :average))
                      (should (= 0 (supertag-rollup-apply op nil))))
                    (dolist (op '(min :min max :max first :first last :last))
                      (should-not (supertag-rollup-apply op nil)))
                    (should (= 2 (supertag-rollup-apply 'unique-count '(2 2 3))))
                    (should (equal "a, b" (supertag-rollup-apply 'concat '("a" "b"))))
                    (should (equal "" (supertag-rollup-apply 'concat nil)))
                    (dolist (op '(:unique-count :concat :unknown))
                      (should (equal (format "Unknown rollup function: %S" op)
                                     (supertag-rollup-apply op '(2 3)))))
                    (let ((values (list 2 3)) seen)
                      (should (= 6 (supertag-rollup-apply
                                    (lambda (xs) (setq seen xs) (apply #'* xs)) values)))
                      (should (eq seen values)))
                    (should-error (supertag-rollup-apply (lambda (_) (error "reducer")) '(1)))
                    (princ "QUERY-B-DONE rollup\n"))
                   ('owner (princ "QUERY-B-DONE owner\n"))
                   (_ (error "Unknown QB case %S" qb-case)))
                 (should (equal original entity))
                 (should (equal snapshot (prin1-to-string supertag--store)))
                 (load (expand-file-name "supertag-query.el" qb-root) nil nil t)
                 (should (equal snapshot (prin1-to-string supertag--store))))
               (dolist (s qb-symbols)
                 (should-not (autoloadp (symbol-function s)))
                 (should (equal (symbol-file s 'defun)
                                (expand-file-name (if (eq qb-stage 'before)
                                                     "supertag-services-formula.el" "supertag-query.el") qb-root))))
               (dolist (f '(supertag-node supertag-tag supertag-services-ui supertag-automation
                             supertag-services-sync supertag-service-org))
                 (should-not (featurep f))
                 (should-not (cl-find-if (lambda (row) (and (stringp (car row))
                                                           (equal (file-name-base (car row)) (symbol-name f)))) load-history)))
               (when (eq qb-stage 'after) (should-not (featurep 'supertag-services-formula)))
               (should (equal hooks (mapcar (lambda (s) (and (boundp s) (symbol-value s)))
                                           '(org-mode-hook org-capture-after-finalize-hook enable-theme-functions))))
               (should (equal modes (mapcar (lambda (b) (with-current-buffer b
                                                        (list major-mode (buffer-modified-p)))) (list target ordinary))))
               (should supertag-view-style-auto-enable) (should supertag-org-capture-auto-enable)
               (should-not global-supertag-ui-completion-mode)
               (with-current-buffer target (should (equal text (buffer-string))))
               (with-current-buffer ordinary (should (equal "Ordinary draft" (buffer-string))))
               (should (equal text (with-temp-buffer (insert-file-contents file) (buffer-string))))
               (princ (format "QUERY-B-PASS %S %S\n" qb-stage qb-case))))))
    (unwind-protect
        (progn
          (with-temp-file script
            (insert ";;; -*- lexical-binding: t; -*-\n")
            (prin1 `(setq qb-root ,root qb-tmp ,tmp qb-stage ',stage qb-case ',scenario
                          qb-symbols '(supertag-formula-tokenize supertag-formula-parse supertag-formula-eval
                                       supertag-formula-parse-string supertag-formula-eval-string
                                       supertag-formula--translate-placeholders supertag-formula--prefix-to-infix
                                       supertag-formula--canonicalize supertag-rollup-apply supertag-formula-evaluate)) (current-buffer))
            (insert "\n")
            (let ((print-length nil) (print-level nil))
              (prin1 `(condition-case err
                          (unwind-protect ,body
                            (setq kill-emacs-hook nil emacs-startup-hook nil)
                            (mapc #'cancel-timer (append timer-list timer-idle-list))
                            (dolist (b (buffer-list))
                              (when (or (equal (buffer-name b) " *qb-ordinary*")
                                        (and (buffer-file-name b) (file-in-directory-p (buffer-file-name b) qb-tmp)))
                                (with-current-buffer b (set-buffer-modified-p nil) (kill-buffer b)))))
                        (error (princ (format "QUERY-B-ERROR %S\n" err)) (kill-emacs 1))) (current-buffer))))
          ;; Pin the child cwd before HOME is repointed.
          (setq default-directory (file-truename default-directory))
          (setenv "HOME" tmp) (setenv "CFFIXED_USER_HOME" tmp)
          (setenv "EMACSLOADPATH" (concat (mapconcat #'identity deps path-separator) path-separator))
          (with-temp-buffer
            (let ((status (apply #'call-process (or (getenv "EMACS_BIN") (expand-file-name invocation-name invocation-directory))
                                 nil t nil (append '("-Q" "--batch")
                                                   (apply #'append (mapcar (lambda (d) (list "-L" d)) deps))
                                                   (list "-L" root "-l" script)))))
              (when-let* ((out (getenv "SUPERTAG_QB_EVIDENCE")))
                (write-region (point-min) (point-max) (expand-file-name (format "%s-%s.log" stage scenario) out) nil 'silent)
                (copy-file script (expand-file-name (format "%s-%s.el" stage scenario) out) t))
              (princ (buffer-string))
              (should (equal status 0))
              (should (string-match-p "QUERY-B-ENTRY" (buffer-string)))
              (should (string-match-p (format "QUERY-B-DONE %s" scenario) (buffer-string)))
              (should (string-match-p (format "QUERY-B-PASS %s %s" stage scenario) (buffer-string))))))
      (delete-directory tmp t))))

(ert-deftest supertag-document-query-b-sources () (supertag-document-query--b-cold 'sources))

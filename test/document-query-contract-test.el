;;; QUERY-D warm real render/Org execution; independent from QA/B/C stages.
(ert-deftest supertag-document-query-d-generated-output ()
  (supertag-document-test-with-vault
    (load (expand-file-name
           (if (equal (getenv "SUPERTAG_QD_STAGE") "before")
               "supertag-query-block.el" "supertag-query.el")
           supertag-document-query--a-root) nil nil t)
    (with-current-buffer (find-file-noselect file)
      (goto-char (point-max))
      (insert "\nOutside [[id:manual][Manual]].\n| [[id:manual-table][Manual table]] |\n\n"
              "#+BEGIN_SRC supertag-query-block :results raw\n(property \"ROLE\" \"generated\")\n#+END_SRC\n\n"
              "#+BEGIN: supertag-query :query \"(property \\\"ROLE\\\" \\\"generated\\\")\"\n#+END:\n\n"
              "* Zulu :gen:\n:PROPERTIES:\n:ID: generated-z\n:ROLE: generated\n:SCORE: 2\n:GROUP: g\n:END:\nTarget Z.\n"
              "* Alpha :gen:\n:PROPERTIES:\n:ID: generated-a\n:ROLE: generated\n:SCORE: 4\n:GROUP: g\n:END:\nTarget A.\n")
      (save-buffer))
    (supertag-sync--process-single-file file (list :nodes-created 0 :nodes-updated 0 :nodes-deleted 0))
    (let ((disk (supertag-document-test-disk file))
          (facts (prin1-to-string supertag--store))
          (ids (copy-tree org-id-locations))
          (org-confirm-babel-evaluate nil)
          (save-count 0) (mode-count 0))
      (cl-letf* ((original-save (symbol-function 'save-buffer))
                 ((symbol-function 'save-buffer)
                  (lambda (&rest args) (cl-incf save-count) (apply original-save args))))
        (let ((org-mode-hook (cons (lambda () (cl-incf mode-count)) org-mode-hook)))
          (let ((table (supertag-query-block--render
                        "(property \"ROLE\" \"generated\")" '(:columns "SCORE" :sort "title" :order "asc" :limit 1))))
            (should (string-match-p "\\[\\[id:generated-a\\]\\[Alpha\\]\\]" table))
            (should-not (string-match-p "generated-z" table))
            (should (string-match-p "SCORE" table)))
          (should (> mode-count 0))
          (let ((table (supertag-query-block--render
                        "(and (property \"ROLE\" \"generated\") (sort-by \"title\" desc))"
                        '(:sort "title" :order "asc" :limit 1))))
            (should (string-match-p "generated-z" table))
            (should-not (string-match-p "generated-a" table)))
          (should (string-match-p "nil" (supertag-query-block--render
                                       "(and (property \"ROLE\" \"generated\") (sum \"SCORE\"))"
                                       '(:limit -1))))
          (should (string-match-p "4" (supertag-query-block--render
                                       "(and (property \"ROLE\" \"generated\") (first \"SCORE\"))" nil)))
          (should (string-match-p "Group" (supertag-query-block--render
                                           "(and (property \"ROLE\" \"generated\") (group-by \"GROUP\") (sum \"SCORE\"))" nil)))
          (should (equal "No results found." (supertag-query-block--render "(property \"ROLE\" \"none\")" nil)))
          (should (string-prefix-p "Error:" (supertag-query-block--render "(" nil)))
          (should (string-prefix-p "Error:" (supertag-query-block--render "(term \"Zulu\")" '(:limit -1))))
          (should-error (supertag-query-block--render-results '(unknown-query))))
        (with-current-buffer (find-file-noselect file)
          (goto-char (point-min)) (search-forward "#+BEGIN_SRC") (beginning-of-line)
          (let ((result (org-babel-execute-src-block)))
            (should (stringp result))
            (should (string-match-p "generated-a" result)))
          (should (save-excursion (goto-char (point-min)) (search-forward "#+RESULTS:" nil t)))
          (goto-char (point-min)) (search-forward "#+BEGIN:") (beginning-of-line)
          (org-dblock-update)
          (let ((once (buffer-string)))
            (org-dblock-update)
            (should (equal once (buffer-string))))
          (should (buffer-modified-p)))
        (should (= save-count 0)))
      (should (equal disk (supertag-document-test-disk file)))
      (should (equal facts (prin1-to-string supertag--store)))
      (should (equal ids org-id-locations))
      ;; Only this explicit test action persists generated output, then projects it.
      (with-current-buffer (find-file-noselect file) (save-buffer))
      (supertag-sync--process-single-file file (list :nodes-created 0 :nodes-updated 0 :nodes-deleted 0))
      (should (equal '("manual" "manual-table")
                     (plist-get (supertag-store-get-entity :nodes "document-node") :ref-to)))
      (should (string-match-p "generated-a" (supertag-document-test-disk file)))
      (princ "QUERY-D-DONE generated-output\n"))))

(defun supertag-document-query--d-cold (scenario)
  (let* ((root supertag-document-query--a-root)
         (stage (if (equal (getenv "SUPERTAG_QD_STAGE") "before") 'before 'after))
         (tmp (make-temp-file "supertag-query-d-" t))
         (script (expand-file-name "cold.el" tmp))
         (deps (split-string (or (getenv "SUPERTAG_DEPS_LOADPATH") "") path-separator t))
         (process-environment (copy-sequence process-environment))
         (body '
(progn
 (require 'ert) (require 'cl-lib)
 (setq user-emacs-directory (file-name-as-directory qd-tmp)
       supertag-data-directory (expand-file-name "data/" qd-tmp)
       supertag--base-data-directory supertag-data-directory

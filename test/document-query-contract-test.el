      (princ "QUERY-C-DONE main\n"))
     ('owner (princ "QUERY-C-DONE owner\n"))
     (_ (error "Unknown QC case")))
   (princ (format "QUERY-C-EVENTS %S\n" (reverse qc-events)))
   (with-current-buffer target (should (equal text (buffer-string))) (should-not (buffer-modified-p)))
   (with-current-buffer ordinary (should (equal "Ordinary draft" (buffer-string))))
   (should (equal text (with-temp-buffer (insert-file-contents file) (buffer-string))))
   (should supertag-view-style-auto-enable)
   (should supertag-org-capture-auto-enable)
   (should-not global-supertag-ui-completion-mode)
   (princ (format "QUERY-C-PASS %S %S\n" qc-stage qc-case)))
 (remove-hook 'after-load-functions #'qc-watch)
 (dolist (entry qc-advice) (advice-remove (car entry) (cdr entry))))))
    (unwind-protect
        (progn
          (with-temp-file script
            (insert ";;; -*- lexical-binding: t; -*-\n")
            (prin1 `(setq qc-root ,root qc-tmp ,tmp qc-stage ',stage qc-case ',scenario
                          qc-symbols '(supertag-index-get-nodes-by-tag supertag-index-get-nodes-by-word supertag-index-get-nodes-by-date-range supertag-find-nodes-by-tag supertag-find-nodes-by-file supertag-find-file-node)) (current-buffer))
            (insert "\n")
            (let ((print-length nil) (print-level nil))
              (prin1 `(condition-case err
                          (unwind-protect ,body
                            (setq kill-emacs-hook nil emacs-startup-hook nil org-mode-hook nil enable-theme-functions nil)
                            (when (fboundp 'qc-watch) (remove-hook 'after-load-functions #'qc-watch))
                            (when (boundp 'qc-advice) (dolist (a qc-advice) (advice-remove (car a) (cdr a))))
                            (mapc #'cancel-timer (append timer-list timer-idle-list))
                            (dolist (b (buffer-list))
                              (when (or (equal (buffer-name b) " *qc-ordinary*")
                                        (and (buffer-file-name b) (file-in-directory-p (buffer-file-name b) qc-tmp)))
                                (with-current-buffer b (set-buffer-modified-p nil) (kill-buffer b)))))
                        (error (princ (format "QUERY-C-ERROR %S\n" err)) (kill-emacs 1))) (current-buffer))))
          ;; Pin the child cwd before HOME is repointed.
          (setq default-directory (file-truename default-directory))
          (setenv "HOME" tmp) (setenv "CFFIXED_USER_HOME" tmp)
          (setenv "EMACSLOADPATH" (concat (mapconcat #'identity deps path-separator) path-separator))
          (with-temp-buffer
            (let ((status (apply #'call-process (or (getenv "EMACS_BIN") (expand-file-name invocation-name invocation-directory))
                                 nil t nil (append '("-Q" "--batch")
                                                   (apply #'append (mapcar (lambda (d) (list "-L" d)) deps))
                                                   (list "-L" root "-l" script)))))
              (when-let* ((out (getenv "SUPERTAG_QC_EVIDENCE")))
                (write-region (point-min) (point-max) (expand-file-name (format "%s-%s.log" stage scenario) out) nil 'silent)
                (copy-file script (expand-file-name (format "%s-%s.el" stage scenario) out) t))
              (princ (buffer-string))
              (should (equal status 0))
              (should (string-match-p "QUERY-C-ENTRY" (buffer-string)))
              (should (string-match-p (format "QUERY-C-DONE %s" scenario) (buffer-string)))
              (should (string-match-p (format "QUERY-C-PASS %s %s" stage scenario) (buffer-string))))))
      (delete-directory tmp t))))



        (supertag-store-put-entity :nodes (car row) (cdr row)))
      (setq facts (prin1-to-string supertag--store))
      (should (equal '("n1") (supertag-index-get-nodes-by-tag "p")))
      (should (equal '("n1" "n2") (supertag-index-get-nodes-by-tag "alias" t)))
      (should (equal '("n3") (supertag-index-get-nodes-by-tag "unresolved")))
      (should-not (supertag-index-get-nodes-by-tag "virtual" t))
      (should (equal '("n1" "n2") (mapcar #'car (supertag-find-nodes-by-tag "p" t))))
      (should (eq (cdar (supertag-find-nodes-by-tag "p")) (supertag-store-get-entity :nodes "n1")))
      (should (equal facts (prin1-to-string supertag--store)))
      (dolist (s '(supertag-tag-get supertag-tag-resolve-occurrence supertag-find-tag-descendants supertag-index-find-node-ids-by-tags))
        (should (member (list 'call s) qc-events)))
      (let ((token supertag--index-nodes-source-token))
        (supertag-store-put-entity :nodes "n2" '(:id "n2" :tags ("p")))
        (should-not (supertag-index-source-current-p token '(:nodes)))
        (setq facts (prin1-to-string supertag--store))
        (should (equal '("n1" "n2") (supertag-index-get-nodes-by-tag "p")))
        (should-not (supertag-index-get-nodes-by-tag "c"))
        (should (supertag-index-source-current-p supertag--index-nodes-source-token '(:nodes)))
        (should (equal facts (prin1-to-string supertag--store))))
      (qc-owner 'supertag-index-get-nodes-by-tag) (qc-owner 'supertag-find-nodes-by-tag)
      (princ "QUERY-C-DONE tags\n"))
     ('node
      (qc-absent '(supertag-query supertag-core-scan supertag-tag supertag-services-sync))
      (supertag--ensure-store)
      (supertag-node-create (list :id "existing-file" :level 0 :file file))
      (setq facts (prin1-to-string supertag--store))
      (with-current-buffer target (should (equal "existing-file" (supertag-ui--get-file-node-at-point))))
      (qc-owner 'supertag-find-file-node)
      (when (eq qc-stage 'after) (qc-absent '(supertag-core-scan supertag-tag)))
      (qc-absent '(supertag-services-sync supertag-ui-commands))
      (should (equal facts (prin1-to-string supertag--store)))
      (princ "QUERY-C-DONE node\n"))
     ('sync
      (princ (format "QUERY-C-SYNC-PROVIDER before-call=%S owner=%S\n"
                     (symbol-function 'supertag-find-nodes-by-file) (symbol-file 'supertag-find-nodes-by-file 'defun)))
      (supertag--ensure-store)
      (let ((counters (list :nodes-created 0 :nodes-updated 0 :nodes-deleted 0)))

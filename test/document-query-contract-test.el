      (should (member '(call supertag-find-nodes-by-file) qc-events))
      (should (equal '("qc-saved") (mapcar #'car (supertag-find-nodes-by-file file))))
      (qc-owner 'supertag-find-nodes-by-file)
      (princ "QUERY-C-DONE sync\n"))
     ('input
      (qc-absent '(supertag-query))
      (supertag--ensure-store)
      (supertag-store-put-entity :tags "p" '(:id "p" :name "root"))
      (supertag-store-put-entity :nodes "n1" '(:id "n1" :tags ("p")))
      (setq facts (prin1-to-string supertag--store))
      (cl-letf (((symbol-function 'completing-read) (lambda (_prompt choices &rest _) (should (member "root" choices)) "root")))
        (should (equal "p" (supertag-ui-read-tag "Tag: "))))
      (should (featurep 'supertag-query))
      (should-not (member '(call supertag-find-nodes-by-tag) qc-events))
      (should (equal '("n1") (mapcar #'car (supertag-find-nodes-by-tag "p"))))
      (should (member '(call supertag-find-nodes-by-tag) qc-events))
      (qc-owner 'supertag-find-nodes-by-tag)
      (should (equal facts (prin1-to-string supertag--store)))
      (princ "QUERY-C-DONE input\n"))
     ('main
      (should (featurep 'supertag)) (should-not after-init-time)
      (should (memq #'supertag-init emacs-startup-hook))
      (should-not (file-exists-p supertag-db-file))
      (let* ((events (reverse qc-events)) (point (assoc (if (eq qc-stage 'before) "supertag-core-scan" "supertag-query") events)))
        (should point)
        (if (eq qc-stage 'before)
            (progn (should (nth 2 point)) (should (nth 3 point)))
          (should-not (nth 2 point)) (should-not (nth 3 point))
          (should (< (cl-position point events :test #'equal)

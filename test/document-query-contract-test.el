 (defun qd-load-observer (file)
   (when (and (stringp file) (string-prefix-p qd-root file))
     (push (list (file-name-base file) (featurep 'org) (featurep 'supertag-node)
                 (featurep 'supertag-tag) (and (boundp 'org-babel-load-languages)
                                              (member '(supertag-query-block . t) org-babel-load-languages))) qd-events)))
 (add-hook 'after-load-functions #'qd-load-observer)
 (defun qd-absent (features)
   (dolist (f features)
     (should-not (featurep f))
     (should-not (cl-find-if (lambda (row) (and (stringp (car row)) (equal (file-name-base (car row)) (symbol-name f)))) load-history))))
 (defvar org-babel-load-languages) (defvar org-babel-default-header-args)
 (when (eq qd-case 'exact)
   (let ((org-babel-load-languages nil) (org-babel-default-header-args nil)) (require 'org)))
 (let* ((preset-lang (pcase qd-case ((or 'exact 'exact-failure) '((supertag-query-block . t))) ('conflict '((supertag-query-block . nil))) (_ nil)))
        (preset-headers (pcase qd-case ((or 'exact 'exact-failure) '((supertag-query-block . ((:results . "raw"))))) ('conflict '((supertag-query-block . ((:results . "value"))))) (_ nil)))
        (org-babel-load-languages (copy-tree preset-lang))
        (org-babel-default-header-args (copy-tree preset-headers))
        (target (get-buffer-create " *qd-target*")))
   ;; Variables must be special even before Org defines them.
   (defvar org-babel-load-languages) (defvar org-babel-default-header-args)
   (unless (eq qd-case 'exact) (should-not (featurep 'org)))
   (when (eq qd-case 'org-first) (require 'org))
   (if (eq qd-case 'exact-failure)
       (let (caught)
         (condition-case err
             (load (expand-file-name "supertag-query.el" qd-root) nil nil t)
           (error (setq caught err)))
         (should-not caught)
         (should (featurep 'org))
         (should (featurep 'supertag-query))
         (should (featurep 'ob-supertag-query-block))
         (should (fboundp 'org-babel-execute:supertag-query-block))
         (should (equal preset-headers org-babel-default-header-args))
         (should (fboundp 'supertag-query-node))
         (princ "QUERY-D-EXACT-PRESET-USABLE\n"))
     (progn
   (load (expand-file-name (pcase qd-case ('main "supertag.el")
                                 ((or 'menu-add 'menu-build 'menu-syntax) "supertag-menu.el")
                                 (_ "supertag-query.el")) qd-root) nil nil t)
   (princ (format "QUERY-D-ENTRY %S org=%S query=%S\n" qd-case (featurep 'org) (featurep 'supertag-query)))
   (when (eq qd-case 'owner)
     (dolist (s qd-functions) (should (equal (symbol-file s 'defun) (expand-file-name "supertag-query.el" qd-root))))
     (dolist (s qd-constants) (should (equal (symbol-file s 'defvar) (expand-file-name "supertag-query.el" qd-root))))
     (should-not (file-exists-p (expand-file-name "supertag-query-block.el" qd-root))))
   (cond
    ((memq qd-case '(empty exact exact-failure conflict org-first owner))
     (should (= qd-mode-count 0))
     (should-not supertag--store)
     (qd-absent '(supertag-node supertag-tag supertag-services-ui supertag-services-sync supertag-service-org))
     (when (eq qd-stage 'before)
       (unless (memq qd-case '(org-first exact)) (should-not (featurep 'org)))
       (should (equal preset-lang org-babel-load-languages))
       (load (expand-file-name "supertag-query-block.el" qd-root) nil nil t))
     (should (featurep 'org)) (should (featurep 'org-table))
     (let ((expected-lang (copy-tree preset-lang)) (expected-headers (copy-tree preset-headers)))
       (should (equal expected-lang org-babel-load-languages))
       (should (equal expected-headers org-babel-default-header-args))
       (load (expand-file-name (if (eq qd-stage 'before) "supertag-query-block.el" "supertag-query.el") qd-root) nil nil t)
       (should (equal expected-lang org-babel-load-languages))

         (should-not (nth 2 query)) (should-not (nth 3 query))))
     (princ "QUERY-D-DONE main\n"))
    (t
     (qd-absent '(supertag-query supertag-query-block))
     (with-current-buffer target
       (pcase qd-case
         ('menu-add
          (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "")))
            (call-interactively #'supertag-menu--add-query-block))
          (should (equal "" (buffer-string)))
          (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "(term \"Needle\")")))
            (call-interactively #'supertag-menu--add-query-block))
          (should (equal "#+BEGIN_SRC supertag-query-block :results raw\n(term \"Needle\")\n#+END_SRC" (buffer-string)))
          (should (buffer-modified-p))
          (princ "QUERY-D-DONE menu-add\n"))

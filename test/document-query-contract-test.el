;;; QUERY-C independent stages and source-only adapters.
(defun supertag-document-query--c-cold (scenario)
  (let* ((root supertag-document-query--a-root)
         (stage (if (equal (getenv "SUPERTAG_QC_STAGE") "before") 'before 'after))
         (tmp (make-temp-file "supertag-query-c-" t))
         (script (expand-file-name "cold.el" tmp))
         (deps (split-string (or (getenv "SUPERTAG_DEPS_LOADPATH") "") path-separator t))
         (process-environment (copy-sequence process-environment))
         (body '
(progn
 (require 'ert) (require 'cl-lib) (require 'org)
 (setq user-emacs-directory (file-name-as-directory qc-tmp)
       supertag-data-directory (expand-file-name "data/" qc-tmp)
       supertag--base-data-directory supertag-data-directory
       supertag-db-file (expand-file-name "store.el" qc-tmp)
       supertag-db-backup-directory (expand-file-name "backups/" qc-tmp)
       supertag-sync-state-file (expand-file-name "sync.el" qc-tmp)
       supertag-sync--state-source supertag-sync-state-file
       supertag-sync-directories (list qc-tmp) supertag-sync-directories-mode 'unified
       supertag-sync-exclude-directories nil
       org-id-locations-file (expand-file-name "ids" qc-tmp)
       org-id-locations nil org-id-files nil org-id-track-globally nil
       after-init-time nil org-mode-hook nil
       supertag-view-style-auto-enable t supertag-org-capture-auto-enable t
       global-supertag-ui-completion-mode nil make-backup-files nil auto-save-default nil)
 (defun qc-absent (names)
   (dolist (f names)
     (should-not (featurep f))
     (should-not (cl-find-if (lambda (row) (and (stringp (car row))
                                               (equal (file-name-base (car row)) (symbol-name f)))) load-history))))
 (defun qc-owner (s)
   (should-not (autoloadp (symbol-function s)))
   (should (equal (symbol-file s 'defun)
                  (expand-file-name (if (eq qc-stage 'before) "supertag-core-scan.el" "supertag-query.el") qc-root))))
 (defvar qc-events nil)
 (defvar qc-advice nil)
 (defun qc-watch (file)
   (when (and (stringp file) (string-prefix-p qc-root file))
     (push (list (file-name-base file) (featurep 'supertag-query)
                 (featurep 'supertag-node) (featurep 'supertag-tag)) qc-events)
     (dolist (s '(supertag-tag-get supertag-tag-resolve-occurrence supertag-find-tag-descendants
                   supertag-index-find-node-ids-by-tags supertag-find-nodes-by-file supertag-find-nodes-by-tag))
       (when (and (fboundp s) (not (autoloadp (symbol-function s))) (not (assq s qc-advice)))
         (let* ((symbol s) (observer (lambda (&rest _) (push (list 'call symbol) qc-events))))
           (advice-add s :before observer) (push (cons s observer) qc-advice))))))
 (add-hook 'after-load-functions #'qc-watch)
 (let* ((file (expand-file-name "input.org" qc-tmp))
        (text "* Saved\n:PROPERTIES:\n:ID: qc-saved\n:END:\nBody.\n")
        (ordinary (get-buffer-create " *qc-ordinary*")) target facts hooks)
   (with-temp-file file (insert text))
   (setq target (find-file-noselect file))
   (with-current-buffer ordinary (insert "Ordinary draft"))
   (setq hooks (copy-tree org-mode-hook))
   (load (expand-file-name (pcase qc-case ('main "supertag.el") ('node "supertag-node.el")
                                 ('sync "supertag-services-sync.el") ('input "supertag-tag.el")
                                 (_ "supertag-query.el")) qc-root) nil nil t)
   (princ (format "QUERY-C-ENTRY %S query=%S node=%S tag=%S\n" qc-case
                  (featurep 'supertag-query) (featurep 'supertag-node) (featurep 'supertag-tag)))
   (when (memq qc-case '(local tags owner))
     (should-not supertag--store)
     (qc-absent '(supertag-node supertag-tag supertag-services-ui supertag-services-sync supertag-service-org))
     (should-not (file-exists-p supertag-db-file)))
   (when (eq qc-case 'owner)
     (dolist (s qc-symbols)
       (should (equal (symbol-file s 'defun) (expand-file-name "supertag-query.el" qc-root))))
     (should-not (file-exists-p (expand-file-name "supertag-core-scan.el" qc-root))))
   (pcase qc-case
     ('local
      ;; True old provider call loads scan on before, not a manual hot preload.
      (should-not (supertag-index-get-nodes-by-word "no-store"))
      (supertag--ensure-store)
      (dolist (row '(("a" :id "a" :title "Alpha.[X]" :file "/a/x" :level 0 :created-at (1 0) :modified-at (2 0))
                     ("b" :id "b" :content "alpha" :file "/a/./x" :level 0 :created-at (2 0) :modified-at (3 0))
                     ("c" :id "c" :title "" :file "/a/x" :level 0 :created-at (3 0))
                     ("d" :id "d" :file 42 :level 0)
                     ("e" :id "e" :file nil :level 0)))
        (supertag-store-put-entity :nodes (car row) (cdr row)))
      (setq facts (prin1-to-string supertag--store))
      (should (equal '("a" "b") (supertag-index-get-nodes-by-word "ALPHA")))
      (should (equal '("a") (supertag-index-get-nodes-by-word ".[x]")))
      (should (equal '("a" "b" "c") (supertag-index-get-nodes-by-word "")))
      (should-error (supertag-index-get-nodes-by-word 42))
      (should (equal '("b") (supertag-index-get-nodes-by-date-range '(1 0) '(3 0))))
      (should (equal '("a" "b" "c") (supertag-index-get-nodes-by-date-range nil nil)))
      (should (equal '("a") (supertag-index-get-nodes-by-date-range nil '(2 0))))
      (should (equal '("c") (supertag-index-get-nodes-by-date-range '(2 0) nil)))
      (should (equal '("a") (supertag-index-get-nodes-by-date-range '(1 0) '(3 0) :modified-at)))
      (should-not (supertag-index-get-nodes-by-date-range nil nil :absent))
      (should (equal '("a" "c") (mapcar #'car (supertag-find-nodes-by-file "/a/x"))))
      (should (equal '("b") (mapcar #'car (supertag-find-nodes-by-file "/a/./x"))))
      (should-not (supertag-find-nodes-by-file nil))
      (should-not (supertag-find-nodes-by-file 42))
      (should (equal "a" (car (supertag-find-file-node "/a/x"))))
      (should (equal "e" (car (supertag-find-file-node nil))))
      (should (equal "d" (car (supertag-find-file-node 42))))
      (should (eq (cdr (car (supertag-find-nodes-by-file "/a/x"))) (supertag-store-get-entity :nodes "a")))
      (should (eq (cdr (supertag-find-file-node "/a/x")) (supertag-store-get-entity :nodes "a")))
      (dolist (s '(supertag-index-get-nodes-by-word supertag-index-get-nodes-by-date-range supertag-find-nodes-by-file supertag-find-file-node)) (qc-owner s))
      (if (eq qc-stage 'after)
          (progn (qc-absent '(supertag-core-scan supertag-node supertag-tag supertag-services-ui supertag-services-sync supertag-service-org))
                 (should (equal hooks org-mode-hook)))
        (should (featurep 'supertag-core-scan)) (should (featurep 'supertag-node)) (should (featurep 'supertag-tag)))
      (should (equal facts (prin1-to-string supertag--store)))
      (princ "QUERY-C-DONE local\n"))
     ('tags
      (supertag--ensure-store)
      (dolist (row '(("p" :id "p" :name "root" :aliases ("alias"))
                     ("c" :id "c" :name "root/child" :extends ("p"))
                     ("v" :id "v" :name "virtual/child")))
        (supertag-store-put-entity :tags (car row) (cdr row)))
      (dolist (row '(("n1" :id "n1" :tags ("p" "p")) ("n2" :id "n2" :tags ("c"))

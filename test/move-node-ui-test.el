        (goto-char (point-min)) (search-forward "Body")
        (let ((position (point))
              (expected (save-excursion (org-back-to-heading t) (org-end-of-subtree t t) (point))))
          (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "Current Position")))
            (should (equal (list :position expected :level 1)
                           (supertag-ui-select-insert-position target position)))))
        (should (equal text (buffer-string)))))))

;;; NODE-D independent source-only entry and Capture reachability.
(defconst move-node-ui-test--node-d-root
  (expand-file-name ".." (file-name-directory load-file-name)))
(defun move-node-ui-test--node-d-cold (mode spec available)
  (let* ((tmp (make-temp-file "supertag-node-d-" t))
         (root move-node-ui-test--node-d-root)
         (program (or (getenv "EMACS_BIN") (expand-file-name invocation-name invocation-directory)))
         (deps (split-string (or (getenv "SUPERTAG_DEPS_LOADPATH") "") path-separator t))
         (process-environment (copy-sequence process-environment))
         (script (expand-file-name "cold.el" tmp))
         (body '(progn
  (require 'cl-lib) (require 'ert) (require 'org) (require 'org-capture)
  (setq user-emacs-directory (file-name-as-directory nd-tmp)
        supertag-data-directory (expand-file-name "data/" nd-tmp)
        supertag--base-data-directory supertag-data-directory
        supertag-db-file (expand-file-name "store.el" supertag-data-directory)
        supertag-db-backup-directory (expand-file-name "backups/" nd-tmp)
        supertag-sync-state-file (expand-file-name "sync.el" nd-tmp)
        supertag-sync--state-source supertag-sync-state-file
        supertag-sync-directories (list nd-tmp) supertag-sync-directories-mode 'unified
        org-id-locations-file (expand-file-name "ids" nd-tmp)
        org-id-locations nil org-id-files nil org-id-track-globally nil
        org-mode-hook nil after-init-time nil supertag-view-style-auto-enable nil
        supertag-org-capture-auto-enable nil org-capture-after-finalize-hook nil
        make-backup-files nil auto-save-default nil load-prefer-newer t)
  (defun nd-disk (file) (with-temp-buffer (insert-file-contents file) (buffer-string)))
  (defun nd-owners ()
    (dolist (symbol '(supertag-ui--move-roots-in-region supertag-ui--move-select-target
                      supertag-ui--move-source-context supertag-ui--move-restore-source-context
                      supertag-ui--move supertag-move-node supertag-move-node-and-link
                      supertag-ui--safe-current-insert-position supertag-ui-select-insert-position))
      (unless (equal (symbol-file symbol 'defun) (expand-file-name "supertag-node.el" nd-root))
        (error "NODE-D owner mismatch %S=%S" symbol (symbol-file symbol 'defun))))
    (should (commandp 'supertag-move-node)) (should (commandp 'supertag-move-node-and-link)))
  (if (eq nd-mode 'owner-ui)
      (progn (require 'supertag-query) (require 'supertag-tag) (require 'supertag-services-sync) (supertag-node--prepare-cache-listener t))
    (load (expand-file-name "supertag-node.el" nd-root) nil nil t))
  (when (eq nd-mode 'capture-warm)
     (if (equal (getenv "SUPERTAG_SYA_STAGE") "before")
      (load (expand-file-name "supertag-ui-commands.el" nd-root) nil nil t)
    (require 'supertag-service-org)))
  (princ (format "NODE-D-ENTRY mode=%S spec=%S move=%S commands=%S\n"
                 nd-mode nd-spec (fboundp 'supertag-move-node) (featurep 'supertag-ui-commands)))
  (if (memq nd-mode '(owner-node owner-ui))
      (nd-owners)
    (if (memq nd-mode '(capture-cold capture-warm))
        (progn
          (if (eq nd-mode 'capture-warm)
              (if (equal (getenv "SUPERTAG_SYA_STAGE") "before")
      (should (featurep 'supertag-ui-commands))
    (progn (should (featurep 'supertag-service-org))
                     (should-not (featurep 'supertag-ui-commands))))
            (should-not (featurep 'supertag-ui-commands))
            (should-not (cl-find-if (lambda (row) (and (stringp (car row))
                                                       (equal "supertag-ui-commands" (file-name-base (car row))))) load-history)))
          (should (eq (not (null (fboundp 'supertag-move-node))) nd-available))
          (should (eq (not (null (fboundp 'supertag-move-node-and-link))) nd-available)))
      (nd-owners)
      (should (featurep 'supertag-service-org))
      (dolist (feature '(supertag-services-ui supertag-ui-commands supertag-services-sync supertag-tag supertag-query supertag-services-query supertag-services-note-query supertag-link supertag))
        (should-not (featurep feature))
        (should-not (cl-find-if (lambda (row) (and (stringp (car row))
                                                   (equal (symbol-name feature) (file-name-base (car row))))) load-history)))
      (should-not (autoloadp (symbol-function 'supertag-service-org-move-nodes)))
      (should (equal (symbol-file 'supertag-service-org-move-nodes 'defun)
                     (expand-file-name "supertag-service-org.el" nd-root))))
    (let* ((source (expand-file-name "source.org" nd-tmp))
           (target (expand-file-name "target.org" nd-tmp))
           (capture-p (memq nd-mode '(capture-cold capture-warm)))
           (will-move (and nd-available (not (memq nd-spec '(no-opt nil-move)))))
           (within (eq nd-spec 'within-target))
           (source-text (if capture-p "* Stay\nBody\n" "* Root\n:PROPERTIES:\n:ID: root\n:END:\nBody\n** Child\nChild body\n"))
           (target-text "* Destination\nBody\n")
           (files-prompt 0) (positions-prompt 0) (confirms 0) saves projects)
      (with-temp-file source (insert source-text))
      (with-temp-file target (insert target-text))
      (supertag--ensure-store)
      (unless capture-p
        ;; Isolated projection input for the real identity lookup.  No Sync preload.
        (supertag-store-put-entity :nodes "root" (list :id "root" :file source :title "Root" :level 1 :position 1 :type :node)))
      (cl-labels ((save-observer (orig &rest args)
                    (when (member (buffer-file-name) (list source target)) (push (buffer-file-name) saves))
                    (apply orig args))
                  (project-observer (orig id &rest args)
                    (push (cons id args) projects) (apply orig id args))
                  (provider-observer (_file)
                    (when (and (featurep 'supertag-service-org)
                               (not (advice-member-p #'project-observer 'supertag-service-org-retry-node-projection)))
                      (advice-add 'supertag-service-org-retry-node-projection :around #'project-observer))))
        (unwind-protect
            (progn
              (advice-add 'save-buffer :around #'save-observer)
              (if (featurep 'supertag-service-org)
                  (provider-observer nil)
                (add-hook 'after-load-functions #'provider-observer))
              (cl-letf (((symbol-function 'read-file-name)
                         (lambda (&rest _) (cl-incf files-prompt) target))
                        ((symbol-function 'completing-read)
                         (lambda (prompt &rest _)
                           (should (equal "Insert position: " prompt))
                           (cl-incf positions-prompt) (if within "File Top" "File End")))
                        ((symbol-function 'yes-or-no-p)
                         (lambda (prompt)
                           (should (string-prefix-p "Move " prompt))
                           (should (string-match-p "All unsaved changes" prompt))
                           (cl-incf confirms) t)))
                (if capture-p
                    (let ((org-capture-templates
                           `(("n" "Node" entry (file ,source) "* Captured\nCaptured body\n"
                              :supertag ,(not (eq nd-spec 'no-opt))
                              :supertag-move ,(unless (eq nd-spec 'nil-move) nd-spec)))))
                      (supertag-enable-org-capture-integration)
                      (org-capture nil "n") (should org-capture-mode)
                      (org-capture-finalize))
                  (switch-to-buffer (find-file-noselect source)) (goto-char (point-min))
                  (let ((origin (current-buffer)))
                    (should (equal '("root")
                                   (call-interactively (if (eq nd-spec 'link)
                                                           #'supertag-move-node-and-link #'supertag-move-node))))
                    (should (eq origin (current-buffer))) (should (= 1 (point)))))))
          (remove-hook 'after-load-functions #'provider-observer)
          (advice-remove 'save-buffer #'save-observer)
          (advice-remove 'supertag-service-org-retry-node-projection #'project-observer)))
      (should (= (if will-move 1 0) confirms))
      (should (= (if will-move 1 0) positions-prompt))
      (should (= (if (and will-move (not within)) 1 0) files-prompt))
      (let* ((name (if capture-p "Captured" "Root"))
             (destination (if (and will-move (not within)) target source))
             (text (nd-disk destination)) id)
        (with-temp-buffer
          (insert text) (org-mode) (goto-char (point-min))
          (re-search-forward (concat "^\\* " name "$"))
          (org-back-to-heading t) (setq id (org-entry-get nil "ID")))
        (cond
         ((eq nd-spec 'no-opt) (should-not id))
         ((and capture-p (not will-move))
          ;; Existing bare Capture finalizer projects the new live ID but does
          ;; not save it unless a member writer or requested Move saves later.
          (should-not id)
          (with-current-buffer (find-file-noselect source)
            (goto-char (point-min)) (re-search-forward "^\\* Captured$") (org-back-to-heading t)
            (setq id (org-entry-get nil "ID"))
            (should id) (should (buffer-modified-p))
            (should (equal source (plist-get (supertag-node-get id) :file)))))
         (t (should id) (should (equal destination (plist-get (supertag-node-get id) :file)))))
        (when will-move
          (should (featurep 'supertag-service-org))
          (should-not (autoloadp (symbol-function 'supertag-service-org-move-nodes)))
          (if within
              (should (< (string-match "^\\* Captured$" text) (string-match "^\\* Stay$" text)))
            (should (string-prefix-p target-text text)))
          (when (eq nd-spec 'link)
            (with-current-buffer (find-file-noselect source)
              (goto-char (point-min))
              (when capture-p (re-search-forward "^\\* Captured$") (org-back-to-heading t))
              (should (org-entry-get nil "ID"))
              (should-not (equal id (org-entry-get nil "ID"))))
            (should (string-match-p (regexp-quote (concat "[[id:" id "]")) (nd-disk source)))))
        (unless will-move (should (equal target-text (nd-disk target)))))
      (unless capture-p
        (should (equal (list target source) (reverse saves)))
        (should (= (if (eq nd-spec 'link) 2 1) (length projects)))
        (should-not (featurep 'supertag-ui-commands))
        (should-not (featurep 'supertag-services-ui)))
      (princ (format "NODE-D-BRANCH %S/%S available=%S move=%S prompts=%S saves=%S projects=%S\n"
                     nd-mode nd-spec nd-available will-move (list files-prompt positions-prompt confirms)
                     (length saves) (length projects)))))
  (princ "NODE-D-PASS\n"))))
    (unwind-protect
        (progn
          (with-temp-file script
            (insert ";;; -*- lexical-binding: t; -*-\n")
            (prin1 `(setq nd-root ,root nd-tmp ,tmp nd-mode ',mode nd-spec ',spec nd-available ,available) (current-buffer))
            (insert "\n")
            (let ((print-length nil) (print-level nil))
              (prin1 `(condition-case err
                          (unwind-protect ,body
                            (setq emacs-startup-hook nil kill-emacs-hook nil org-mode-hook nil
                                  org-capture-after-finalize-hook nil enable-theme-functions nil)
                            (mapc #'cancel-timer (append timer-list timer-idle-list)))
                        (error (princ (format "NODE-D-ERROR %S\n" err)) (kill-emacs 1))) (current-buffer))))
          (setenv "HOME" tmp) (setenv "CFFIXED_USER_HOME" tmp)
          (setenv "EMACSLOADPATH" (concat (mapconcat #'identity deps path-separator) path-separator))
          (with-temp-buffer
            (let ((status (apply #'call-process program nil t nil
                                 (append '("-Q" "--batch")
                                         (apply #'append (mapcar (lambda (dir) (list "-L" dir)) deps))
                                         (list "-L" root "-l" script)))))
              (unless (and (equal status 0) (string-match-p "NODE-D-ENTRY" (buffer-string))
                           (string-match-p "NODE-D-PASS" (buffer-string)))
                (ert-fail (format "NODE-D %S/%S exit=%S\n%s" mode spec status (buffer-string))))
              (dolist (line (split-string (buffer-string) "\n" t))
                (when (string-prefix-p "NODE-D-" line) (princ (concat line "\n")))))))
      (delete-directory tmp t))))

(ert-deftest move-node-ui-capture-cold-reachability ()
  (dolist (spec '(within-target link t no-opt nil-move))
    (move-node-ui-test--node-d-cold 'capture-cold spec t)))
(ert-deftest move-node-ui-capture-commands-preloaded-reachability ()
  (dolist (spec '(within-target link t no-opt nil-move))
    (move-node-ui-test--node-d-cold 'capture-warm spec t)))


(defmacro move-node-ui-test--fixture (&rest body)
  "Run BODY with temporary source/target files and no runtime writers."
  (declare (indent 0))
  `(let* ((dir (make-temp-file "supertag-move-ui-" t))
          (source (expand-file-name "source.org" dir))
          (target (expand-file-name "target.org" dir))
          source-buffer target-buffer)
     (unwind-protect
         (progn
           (with-temp-file source
             (insert "* Root\n:PROPERTIES:\n:ID: root\n:END:\nBody\n** Child\nChild body\n* Second\nSecond body\n"))
           (with-temp-file target
             (insert "* Target\nBody\n** Existing\nText\n* Last\n"))
           (setq source-buffer (find-file-noselect source)
                 target-buffer (find-file-noselect target))
           (save-window-excursion
             (switch-to-buffer source-buffer)
             (goto-char (point-min))
             (cl-letf (((symbol-function 'save-buffer)
                        (lambda (&rest _) (ert-fail "UI must not save")))
                       ((symbol-function 'supertag-node-identity-ensure-at-point)
                        (lambda (&rest _) (ert-fail "UI must not create IDs")))
                       ((symbol-function 'supertag-node-set-location)
                        (lambda (&rest _) (ert-fail "UI must not update Store")))
                       ((symbol-function 'supertag-reference-materialize-at-point)
                        (lambda (&rest _) (ert-fail "UI must not materialize links"))))
               ,@body)))
       (dolist (buffer (list source-buffer target-buffer))
         (when (buffer-live-p buffer)
           (with-current-buffer buffer (set-buffer-modified-p nil))
           (kill-buffer buffer)))
       (delete-directory dir t))))

(ert-deftest move-node-ui-delegates-once-with-warning-and-source-context ()
  (dolist (command '(supertag-move-node supertag-move-node-and-link))
    (move-node-ui-test--fixture
      (let (calls prompt)
        (cl-letf (((symbol-function 'read-file-name) (lambda (&rest _) target))
                  ((symbol-function 'supertag-ui-select-insert-position)
                   (lambda (_) (goto-char (point-max)) '(:position 1 :level 2)))
                  ((symbol-function 'yes-or-no-p)
                   (lambda (text) (setq prompt text) t))
                  ((symbol-function 'supertag-service-org-move-nodes)
                   (lambda (sources file position level link)
                     (push (list sources file (marker-position position)
                                 (marker-buffer position) level link) calls)
                     (switch-to-buffer target-buffer)
                     (goto-char (point-max))
                     '("root"))))
          (funcall command))
        (should (equal calls (list (list '("root") target 1 target-buffer 2
                                         (eq command 'supertag-move-node-and-link)))))
        (should (string-match-p "All unsaved changes in affected files will be saved" prompt))
        (should (eq (current-buffer) source-buffer))
        (should (eq (window-buffer (selected-window)) source-buffer))
        (should (= (point) 1))
        (should-not (buffer-modified-p source-buffer))))))

(ert-deftest move-node-ui-region-is-readonly-fold-independent-and-collapsed ()
  (move-node-ui-test--fixture
    (org-fold-hide-subtree)
    (let ((before (buffer-string)) (tick (buffer-chars-modified-tick)) roots)
      (unwind-protect
          (progn
            (setq roots (supertag-ui--move-roots-in-region (point-min) (point-max)))
            (should (= 2 (length roots)))
            (should (equal '("Root" "Second")
                           (mapcar (lambda (marker)
                                     (save-excursion (goto-char marker) (org-get-heading t t t t))) roots)))
            (should (equal before (buffer-string)))
            (should (= tick (buffer-chars-modified-tick)))
            (should-not (buffer-modified-p)))
        (mapc (lambda (marker) (set-marker marker nil)) roots)))))

(ert-deftest move-node-ui-region-boundaries-and-idless-delegation ()
  (move-node-ui-test--fixture
    (search-forward "** Child")
    (let ((beg (line-beginning-position)) (end (point-max)) calls)
      (cl-letf (((symbol-function 'read-file-name) (lambda (&rest _) target))
                ((symbol-function 'supertag-ui-select-insert-position)
                 (lambda (_) '(:position 1 :level 1)))
                ((symbol-function 'yes-or-no-p) (lambda (_) t))
                ((symbol-function 'supertag-service-org-move-nodes)
                 (lambda (sources &rest _)
                   (setq calls (mapcar (lambda (marker)
                                         (should (markerp marker))
                                         (save-excursion
                                           (goto-char marker)
                                           (should-not (org-id-get))
                                           (org-get-heading t t t t))) sources))
                   '("created-child" "created-second"))))
        (supertag-move-node beg end))
      (should (equal calls '("Child" "Second"))))
    (goto-char (point-min))
    (search-forward "* Second")
    (let* ((end (line-beginning-position))
           (roots (supertag-ui--move-roots-in-region 2 end)))
      (unwind-protect
          (should (equal '("Child")
                         (mapcar (lambda (m) (goto-char m) (org-get-heading t t t t)) roots)))
        (mapc (lambda (m) (set-marker m nil)) roots)))))

(ert-deftest move-node-ui-refusal-keeps-idless-region-untouched ()
  (move-node-ui-test--fixture
    (let ((text (buffer-string)) (calls 0))
      (cl-letf (((symbol-function 'read-file-name) (lambda (&rest _) target))
                ((symbol-function 'supertag-ui-select-insert-position)
                 (lambda (_) '(:position 1 :level 1)))
                ((symbol-function 'yes-or-no-p) (lambda (_) nil))
                ((symbol-function 'supertag-service-org-move-nodes)
                 (lambda (&rest _) (cl-incf calls))))
        (supertag-move-node (point-min) (point-max)))
      (should (= calls 0))
      (should (equal text (buffer-string)))
      (should-not (buffer-modified-p)))))

(ert-deftest move-node-ui-selector-cancel-restores-both-buffer-contexts ()
  (dolist (exit '(quit error nil))
    (move-node-ui-test--fixture
      (with-current-buffer target-buffer
        (goto-char 3)
        (narrow-to-region 1 7))
      (let ((calls 0) widened)
        (cl-letf (((symbol-function 'read-file-name) (lambda (&rest _) target))
                  ((symbol-function 'supertag-ui-select-insert-position)
                   (lambda (_)
                     (setq widened (> (point-max) 7))
                     (goto-char (point-max))
                     (pcase exit ('quit (signal 'quit nil)) ('error (error "Cancelled")))))
                  ((symbol-function 'supertag-service-org-move-nodes)
                   (lambda (&rest _) (cl-incf calls))))
          (condition-case nil (supertag-move-node) ((error quit) nil)))
        (should widened)
        (should (= calls 0)))
      (should (eq (current-buffer) source-buffer))
      (should (= (point) 1))
      (with-current-buffer target-buffer
        (should (= (point) 3))
        (should (= (point-max) 7))))))


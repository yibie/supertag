(defmacro move-node-ui-test--e2e-fixture (&rest body)
  "Run BODY with real Move UI/service writers and isolated temporary files."
  (declare (indent 0))
  `(let* ((dir (make-temp-file "supertag-move-ui-e2e-" t))
          (source (expand-file-name "source.org" dir))
          (target (expand-file-name "target.org" dir))
          (source-text "* Root\n:PROPERTIES:\n:ID: root\n:END:\nBody\n** Child\nChild body\n* Second\nSecond body\n")
          (target-text "* Target\nBody\n* Last\n")
          (supertag--store nil)
          (supertag--subscribers (make-hash-table :test 'equal))
          (supertag-sync--internal-modifications (make-hash-table :test 'equal))
          source-buffer target-buffer)
     (unwind-protect
         (progn
           (with-temp-file source (insert source-text))
           (with-temp-file target (insert target-text))
           (setq source-buffer (find-file-noselect source)
                 target-buffer (find-file-noselect target))
           (supertag--ensure-store)
           (cl-letf (((symbol-function 'supertag-node-location-find)
                      (lambda (id)
                        (cl-loop for buffer in (list source-buffer target-buffer)
                                 thereis
                                 (with-current-buffer buffer
                                   (save-excursion
                                     (save-restriction
                                       (widen)
                                       (goto-char (point-min))
                                       (when (re-search-forward
                                              (concat "^:ID: " (regexp-quote id) "$") nil t)
                                         (org-back-to-heading t)
                                         (point-marker)))))))))
             (save-window-excursion
               (switch-to-buffer source-buffer)
               (goto-char (point-min))
               ,@body)))
       (dolist (buffer (list source-buffer target-buffer))
         (when (buffer-live-p buffer)
           (with-current-buffer buffer (set-buffer-modified-p nil))
           (kill-buffer buffer)))
       (delete-directory dir t))))

(defun move-node-ui-test--disk (file)
  "Return FILE text for Move end-to-end assertions."
  (with-temp-buffer
    (insert-file-contents file)
    (buffer-string)))

(ert-deftest move-node-ui-e2e-public-same-file-after-heading ()
  (move-node-ui-test--e2e-fixture
    (cl-letf (((symbol-function 'read-file-name) (lambda (&rest _) source))
              ((symbol-function 'supertag-ui-select-insert-position)
               (lambda (_)
                 (goto-char (point-max))
                 (list :position (point-marker) :level 1)))
              ((symbol-function 'yes-or-no-p) (lambda (_) t))
              ((symbol-function 'message) #'ignore))
      (should (equal '("root") (supertag-move-node))))
    (let ((text (move-node-ui-test--disk source)))
      (should (< (string-match "^\\* Second$" text)
                 (string-match "^\\* Root$" text)))
      (should (string-match-p "^\\*\\* Child$" text)))
    (should (eq (current-buffer) source-buffer))
    (should (= (point) (point-min)))))

(ert-deftest move-node-ui-e2e-file-top-and-end-order ()
  (dolist (choice '("File Top" "File End"))
    (move-node-ui-test--e2e-fixture
      (cl-letf (((symbol-function 'read-file-name) (lambda (&rest _) target))
                ((symbol-function 'completing-read)
                 (lambda (prompt &rest _)
                   (if (string-prefix-p "Insert" prompt) choice "Target")))
                ((symbol-function 'yes-or-no-p) (lambda (_) t))
                ((symbol-function 'message) #'ignore))
        (should (equal '("root") (supertag-move-node))))
      (let* ((text (move-node-ui-test--disk target))
             (root (string-match "^\\* Root$" text))
             (target-heading (string-match "^\\* Target$" text))
             (last (string-match "^\\* Last$" text)))
        (if (equal choice "File Top")
            (should (< root target-heading))
          (should (< last root)))
        (should (string-match-p "^\\*\\* Child$" text))))))


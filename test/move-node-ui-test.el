;;; NODE-D retained UI contracts, evaluated before ownership migration.
(ert-deftest move-node-ui-preserves-exact-service-error-payload ()
  (dolist (kind '(supertag-move-recovery-error supertag-projection-error))
    (move-node-ui-test--fixture
      (let* ((snapshots (list (list :buffer source-buffer :text (buffer-string))))
             (payload (list :cause '(error "injected") :snapshots snapshots
                            :retry-function 'supertag-service-org--retry-move-projection
                            :retry-args (list source target))) caught)
        (cl-letf (((symbol-function 'read-file-name) (lambda (&rest _) target))
                  ((symbol-function 'completing-read) (lambda (&rest _) "File End"))
                  ((symbol-function 'yes-or-no-p) (lambda (_) t))
                  ((symbol-function 'supertag-service-org-move-nodes)
                   (lambda (&rest _) (signal kind payload))))
          (condition-case err (call-interactively #'supertag-move-node)
            (error (setq caught err))))
        (should (eq kind (car caught)))
        (should (eq payload (cdr caught)))
        (should (eq snapshots (plist-get (cdr caught) :snapshots)))
        (should (eq source-buffer (current-buffer)))
        (should (= 1 (point)))))))


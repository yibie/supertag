(ert-deftest move-node-ui-e2e-native-under-after-accept-ending-delimiters ()
  (dolist (fixture
           '((drawer . "* Target\n:PROPERTIES:\n:ID: target\n:END:\n* Last\n")
             (block . "* Target\n#+begin_src emacs-lisp\n(message \"safe\")\n#+end_src\n* Last\n")))
    (dolist (choice '("Under Heading..." "After Heading..."))
      (move-node-ui-test--e2e-fixture
        (with-current-buffer target-buffer
          (widen)
          (erase-buffer)
          (insert (cdr fixture))
          (save-buffer))
        (cl-letf (((symbol-function 'read-file-name) (lambda (&rest _) target))
                  ((symbol-function 'completing-read)
                   (lambda (prompt &rest _)
                     (if (string-prefix-p "Insert" prompt) choice "Target")))
                  ((symbol-function 'yes-or-no-p) (lambda (_) t))
                  ((symbol-function 'message) #'ignore))
          (should (equal '("root") (supertag-move-node))))
        (let* ((text (move-node-ui-test--disk target))
               (delimiter
                (string-match
                 (if (eq (car fixture) 'drawer) "^:END:$" "^#\\+end_src$")
                 text))
               (root (string-match
                      (if (equal choice "Under Heading...")
                          "^\\*\\* Root$"
                        "^\\* Root$")
                      text))
               (child (string-match
                       (if (equal choice "Under Heading...")
                           "^\\*\\*\\* Child$"
                         "^\\*\\* Child$")
                       text))
               (last (string-match "^\\* Last$" text)))
          (should (< delimiter root))
          (should (< root child))
          (should (< child last)))))))


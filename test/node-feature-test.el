              (supertag-enable-org-id-open-link-integration)
              (supertag-enable-org-id-open-link-integration)
              (load (expand-file-name "supertag-service-org.el" nh-root) nil nil t)
              (let ((count 0))
                (advice-mapc (lambda (ad _props) (when (eq ad 'supertag-service-org--org-id-open-link-advice) (cl-incf count))) 'org-id-open-link)
                (should (= 1 count)))
              (setq supertag-node-location-org-id-fallback nil)
              (dolist (reason '(uninitialized disabled nonstring unknown outside))

(defun supertag-node-feature--disk (file)
  (with-temp-buffer (insert-file-contents file) (buffer-string)))

(defun supertag-node-feature--file-exercise (tmp in-scope)
  "Exercise original disk projection; return actual state-call arguments."
  (let* ((file (expand-file-name "file.org" tmp))
         (supertag-sync-directories (list (if in-scope tmp (expand-file-name "outside/" tmp))))
         (real (symbol-function 'supertag-sync-update-state)) events)
    (with-temp-file file (insert ":PROPERTIES:\n:ID: file-id\n:END:\n#+TITLE: Saved S1\nBody\n"))
    (with-current-buffer (find-file-noselect file)
      (goto-char (point-min)) (search-forward "Saved S1") (replace-match "Draft S2")
      (let ((live (buffer-string)) (disk (supertag-node-feature--disk file)))
        (cl-letf (((symbol-function 'supertag-sync-update-state)
                   (lambda (&rest args) (push args events) (apply real args))))
          (supertag-ui--ensure-file-node-synced file)
          (should (equal "Saved S1" (plist-get (supertag-node-get "file-id") :title)))
          (should (eq 0 (plist-get (supertag-node-get "file-id") :level)))
          (should (equal live (buffer-string))) (should (buffer-modified-p))
          (should (equal disk (supertag-node-feature--disk file)))
          (if in-scope
              (progn
                (should (= 1 (cl-count 1 events :key #'length)))
                (should (= 1 (cl-count 2 events :key #'length))))
            (should-not events))
          (setq events nil)
          (supertag-ui--ensure-file-node-synced file)
          (if in-scope
              (progn
                ;; The original quoted counters retain their prior positive count.
                (should (= 1 (cl-count 1 events :key #'length)))
                (should (= 1 (cl-count 2 events :key #'length))))
            (should-not events)))
        (should (equal live (buffer-string)))
        (should (equal disk (supertag-node-feature--disk file)))))
    events))

(ert-deftest supertag-node-feature-containing-id-and-point-before-projection ()
  (supertag-node-feature--location-store
    (let ((file (expand-file-name "heading.org" tmp)))
      (with-temp-file file (insert "* Fresh\nBody text\n"))
      (with-current-buffer (find-file-noselect file)
        (search-forward "Body")
        (let* ((marker (point-marker)) (disk (supertag-node-feature--disk file))
               (id (supertag-ui--get-containing-node-at-point)))
          (should (stringp id)) (should (= (point) marker))
          (should (buffer-modified-p)) (should-not (supertag-node-get id))
          (should-not org-id-locations) (should (equal disk (supertag-node-feature--disk file)))
          ;; With fallback disabled an unprojected heading cannot be found by ID.
          (supertag-ui--ensure-node-synced id)
          (should-not (supertag-node-get id))
          ;; The Tag command's original at-point gate differs at body vs heading.
          (supertag-node-sync-at-point) (should-not (supertag-node-get id))
          (goto-char (point-min)) (supertag-node-sync-at-point)
          (should (equal id (supertag-ui--get-containing-node-at-point)))
          (let ((facts (supertag-node-feature--facts :nodes)))
            (supertag-ui--ensure-node-synced id)
            (should (equal facts (supertag-node-feature--facts :nodes))))
          (should (equal disk (supertag-node-feature--disk file)))
          (set-marker marker nil))))))


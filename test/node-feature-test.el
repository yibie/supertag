;;; NODE-F independent entry controls.
(defun supertag-node-feature--generic-cold (stage scenario preset)
  (let* ((tmp (make-temp-file "supertag-node-f-" t))
         (root supertag-node-feature--root)
         (program (or (getenv "EMACS_BIN") (expand-file-name invocation-name invocation-directory)))
         (deps (split-string (or (getenv "SUPERTAG_DEPS_LOADPATH") "") path-separator t))
         (process-environment (copy-sequence process-environment))
         (script (expand-file-name "cold.el" tmp))
         (body '(progn
  (require 'cl-lib) (require 'ert) (require 'org)
  (setq user-emacs-directory (file-name-as-directory nf-tmp)
        supertag-data-directory nf-tmp supertag--base-data-directory nf-tmp
        supertag-db-file (expand-file-name "db.el" nf-tmp)
        supertag-db-backup-directory (expand-file-name "backup/" nf-tmp)
        supertag-sync-state-file (expand-file-name "sync.el" nf-tmp)
        supertag-sync--state-source supertag-sync-state-file
        supertag-sync-directories (list nf-tmp) supertag-sync-directories-mode 'unified
        org-id-locations-file (expand-file-name "ids" nf-tmp)
        org-id-locations nil org-id-files nil org-id-track-globally nil
        org-mode-hook nil after-init-time nil supertag-view-style-auto-enable nil
        supertag-org-capture-auto-enable nil make-backup-files nil auto-save-default nil)
  (when nf-preset (setq supertag-ui--select-node-candidates 'preset))
  (load (expand-file-name "supertag-node.el" nf-root) nil nil t)
  (princ (format "NODE-F-ENTRY stage=%S case=%S preset=%S\n" nf-stage nf-case nf-preset))
  (should (featurep 'supertag-service-org))
  (dolist (feature '(supertag-services-ui supertag-ui-commands supertag-tag supertag-query supertag-services-query supertag-services-note-query supertag-services-sync supertag))
    (should-not (featurep feature))
    (should-not (cl-find-if (lambda (entry) (and (stringp (car entry)) (equal (file-name-base (car entry)) (symbol-name feature)))) load-history)))
  (should-not (file-exists-p supertag-db-file))
  (if (eq nf-case 'owner)
      (dolist (symbol '(supertag-ui-select-node supertag-ui-select-multiple-nodes supertag-node-reference-and-create supertag-ui--reproject-containing-node supertag-ui--select-node-candidates))
        (should (equal (symbol-file symbol (if (eq symbol 'supertag-ui--select-node-candidates) 'defvar 'defun)) (expand-file-name "supertag-node.el" nf-root))))
    (when (eq nf-stage 'before)
      (should-not (fboundp 'supertag-ui-select-node))
      (load (expand-file-name "supertag-services-ui.el" nf-root) nil nil t)
      (load (expand-file-name "supertag-ui-commands.el" nf-root) nil nil t))
    (should (eq (if nf-preset 'preset nil) supertag-ui--select-node-candidates))
    (when (eq nf-stage 'after)
      (should (autoloadp (symbol-function 'supertag-query-nodes)))
      (should (autoloadp (symbol-function 'supertag-node-sync-at-point))))
    (supertag--ensure-store)
    (let ((file (expand-file-name "cold.org" nf-tmp)))
      (with-temp-file file (insert "* Existing\n:PROPERTIES:\n:ID: existing\n:END:\nBody\n"))
      (if (eq nf-case 'query)
          (progn
            (supertag-store-put-entity :nodes "existing" (list :id "existing" :title "Existing" :file file :level 1 :type :node))
            (cl-letf (((symbol-function 'completing-read)
                       (lambda (_ table &rest _) (should (equal table supertag-ui--select-node-candidates)) (car (rassoc "existing" table)))))
              (should (equal "existing" (supertag-ui-select-node nil nil nil))))
            (should (featurep 'supertag-query))
            (should-not (autoloadp (symbol-function 'supertag-query-nodes))))
        (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "Created"))
                  ((symbol-function 'read-file-name) (lambda (&rest _) file))
                  ((symbol-function 'completing-read)
                   (lambda (_ choices &rest _) (should (member "File End" choices)) "File End")))
          (let ((id (supertag-node-reference-and-create)))
            (should (supertag-node-get id))
            (should (featurep 'supertag-services-sync))
            (should-not (autoloadp (symbol-function 'supertag-node-sync-at-point)))
            (should (string-match-p (regexp-quote id) (with-temp-buffer (insert-file-contents file) (buffer-string)))))))
      (should (eq (if nf-preset 'preset nil) supertag-ui--select-node-candidates))
      (princ (format "NODE-F-PROVIDERS query=%S sync=%S ui=%S\n" (featurep 'supertag-query) (featurep 'supertag-services-sync) (featurep 'supertag-services-ui)))
      (let ((owner (symbol-file 'supertag-ui-select-node 'defun)))
        (load (expand-file-name "supertag-node.el" nf-root) nil nil t)
        (progn (require 'supertag-query) (require 'supertag-tag) (require 'supertag-services-sync) (supertag-node--prepare-cache-listener t))
        (should (equal owner (symbol-file 'supertag-ui-select-node 'defun)))
        (should (eq (if nf-preset 'preset nil) supertag-ui--select-node-candidates)))))
  (princ "NODE-F-PASS\n"))))
    (unwind-protect
        (progn
          (with-temp-file script
            (insert ";;; -*- lexical-binding: t; -*-\n")
            (prin1 `(setq nf-root ,root nf-tmp ,tmp nf-stage ',stage nf-case ',scenario nf-preset ',preset) (current-buffer))
            (insert "\n")
            (let ((print-length nil) (print-level nil))
              (prin1 `(condition-case err
                          (unwind-protect ,body
                            (setq emacs-startup-hook nil kill-emacs-hook nil org-mode-hook nil
                                  org-capture-after-finalize-hook nil enable-theme-functions nil)
                            (mapc #'cancel-timer (append timer-list timer-idle-list))
                            (dolist (buffer (buffer-list))
                              (when (and (buffer-file-name buffer)
                                         (file-in-directory-p (buffer-file-name buffer) nf-tmp))
                                (with-current-buffer buffer
                                  (set-buffer-modified-p nil) (kill-buffer buffer)))))
                        (error (princ (format "NODE-F-ERROR %S\n" err)) (kill-emacs 1))) (current-buffer))))
          (setenv "HOME" tmp) (setenv "CFFIXED_USER_HOME" tmp)
          (setenv "EMACSLOADPATH" (concat (mapconcat #'identity deps path-separator) path-separator))
          (with-temp-buffer
            (let ((status (apply #'call-process program nil t nil
                                 (append '("-Q" "--batch")
                                         (apply #'append (mapcar (lambda (dir) (list "-L" dir)) deps))
                                         (list "-L" root "-l" script)))))
              (unless (and (equal status 0) (string-match-p "NODE-F-ENTRY" (buffer-string))
                           (string-match-p "NODE-F-PASS" (buffer-string)))
                (ert-fail (format "NODE-F %S/%S/%S exit=%S\n%s" stage scenario preset status (buffer-string))))
              (dolist (line (split-string (buffer-string) "\n" t))
                (when (string-prefix-p "NODE-F-" line) (princ (concat line "\n")))))))
      (delete-directory tmp t))))



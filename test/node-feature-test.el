(defconst supertag-node-feature--root
  (file-name-directory (directory-file-name (file-name-directory (or load-file-name buffer-file-name)))))

(defmacro supertag-node-feature--with-store (&rest body)
  (declare (indent 0))
  `(let* ((tmp (file-name-as-directory (make-temp-file "supertag-node-feature-" t)))
          (user-emacs-directory tmp)
          (supertag-data-directory tmp)
          (supertag--base-data-directory tmp)
          (supertag-db-file (expand-file-name "store.el" tmp))
          (supertag--store nil)
          (supertag--store-origin nil)
          (supertag--subscribers (make-hash-table :test 'equal))
          (org-id-locations nil) (org-id-files nil) (org-id-track-globally nil)
          (org-id-locations-file (expand-file-name "ids" tmp))
          (org-mode-hook nil) (make-backup-files nil) (auto-save-default nil))
     (unwind-protect
         (progn (supertag--ensure-store) ,@body)
       (dolist (buffer (buffer-list))
         (when-let* ((name (buffer-file-name buffer)) ((file-in-directory-p name tmp)))
           (with-current-buffer buffer (set-buffer-modified-p nil)) (kill-buffer buffer)))
       (delete-directory tmp t))))

(defun supertag-node-feature--facts (collection)
  (let (rows)
    (maphash (lambda (id data) (push (cons id (copy-tree data)) rows))
             (supertag-store-get-collection collection))
    (sort rows (lambda (a b) (string< (car a) (car b))))))

(defun supertag-node-feature--entities (directory)
  (let ((now '(10 20 30 40)))
    (cl-letf (((symbol-function 'supertag-current-time) (lambda () now)))
      (let ((node (supertag-node-create '(:id "explicit" :title "Node" :created-at (1 2 3 4) :extra "kept" :type :other))))
        (should (equal "explicit" (plist-get node :id)))
        (should (eq :node (plist-get node :type)))
        (should (equal '(1 2 3 4) (plist-get node :created-at)))
        (should (equal now (plist-get node :modified-at)))
        (should (equal "kept" (plist-get node :extra))))
      (let ((generated (supertag-node-create '(:title "Generated"))))
        (should (stringp (plist-get generated :id)))
        (should (> (length (plist-get generated :id)) 0))
        (should (equal generated (supertag-node-get (plist-get generated :id))))
        (should-not org-id-locations))
      (should-not (supertag-node-get "missing"))
      (should-not (supertag-node-update "missing" (lambda (_) (ert-fail "Missing node called updater"))))
      (let ((before (supertag-node-feature--facts :nodes)))
        (should (equal (supertag-node-get "explicit")
                       (supertag-node-update "explicit" (lambda (_) nil))))
        (should (equal before (supertag-node-feature--facts :nodes))))
      (setq now '(11 22 33 44))
      (should (equal "Changed"
                     (plist-get (supertag-node-update "explicit"
                                 (lambda (old) (plist-put (copy-tree old) :title "Changed"))) :title)))
      (should (equal now (plist-get (supertag-node-get "explicit") :modified-at)))
      (supertag-node-set-location "explicit" (expand-file-name "future.org" directory) 17)
      (should (= 17 (plist-get (supertag-node-get "explicit") :position)))
      (should (equal (expand-file-name "future.org" directory) (plist-get (supertag-node-get "explicit") :file)))
      ;; Original create has no update validation: preserve that asymmetry.
      (should (equal "no-title" (plist-get (supertag-node-create '(:id "no-title")) :id)))
      (let ((before (supertag-node-feature--facts :nodes)))
        (should-error (supertag-node-update "no-title" #'copy-tree) :type 'error)
        (should (equal before (supertag-node-feature--facts :nodes)))))))

(defun supertag-node-feature--relation-index ()
  (mapcar (lambda (id)
            (list id
                  (sort (mapcar (lambda (r) (plist-get r :id)) (supertag-relation-find-by-from id)) #'string<)
                  (sort (mapcar (lambda (r) (plist-get r :id)) (supertag-relation-find-by-to id)) #'string<)))
          '("a" "b" "c")))

(defun supertag-node-feature--delete-relations (inject)
  (dolist (id '("a" "b" "c")) (supertag-node-create (list :id id :title id)))
  (dolist (edge '(("a" "b") ("b" "a") ("a" "a") ("b" "c")))
    (supertag-relation-project-document-link (car edge) (cadr edge)))
  (let ((nodes (supertag-node-feature--facts :nodes))
        (relations (supertag-node-feature--facts :relations))
        (index (supertag-node-feature--relation-index))
        (real (symbol-function 'supertag-relation-delete)) calls)
    (if inject
        (progn
          (cl-letf (((symbol-function 'supertag-relation-delete)
                     (lambda (id)
                       (push id calls)
                       (funcall real id)
                       (should-not (supertag-relation-get id))
                       (should-not (equal index (supertag-node-feature--relation-index)))
                       (error "NODE-A injected after real relation delete"))))
            (let ((err (should-error (supertag-node-delete "a") :type 'error)))
              (should (equal '(error "NODE-A injected after real relation delete") err))))
          (should (= 1 (length calls)))
          (should (equal nodes (supertag-node-feature--facts :nodes)))
          (should (equal relations (supertag-node-feature--facts :relations)))
          (should (equal index (supertag-node-feature--relation-index)))
          (supertag-node-delete "a"))
      (cl-letf (((symbol-function 'supertag-relation-delete)
                 (lambda (id) (push id calls) (funcall real id))))
        (supertag-node-delete "a"))
      (should (= 3 (length calls)))
      (should (= 3 (length (delete-dups (copy-sequence calls))))))
    (should-not (supertag-node-get "a"))
    (should (equal (cdr (assoc "b" nodes)) (supertag-node-get "b")))
    (should (equal (cdr (assoc "c" nodes)) (supertag-node-get "c")))
    (should (= 1 (hash-table-count (supertag-store-get-collection :relations))))
    (should (= 1 (length (supertag-relation-find-between "b" "c"))))
    (should-not (supertag-relation-find-by-from "a"))
    (should-not (supertag-relation-find-by-to "a"))))

(defun supertag-node-feature--navigation (directory)
  (let ((file (expand-file-name "navigation.org" directory)))
    (with-temp-file file
      (insert ":PROPERTIES:\n:ID: file-node\n:END:\n\n* Heading\n:PROPERTIES:\n:ID: heading-node\n:END:\nBody\n"))
    (supertag-node-create (list :id "file-node" :level 0 :file file))
    (supertag-node-create (list :id "heading-node" :title "Heading" :level 1 :file file))
    (with-current-buffer (find-file-noselect file)
      (let ((disk (with-temp-buffer (insert-file-contents file) (buffer-string)))
            (live (buffer-string)) (dirty (buffer-modified-p))
            (nodes (supertag-node-feature--facts :nodes))
            (ids (copy-tree org-id-locations)))
        (goto-char (point-max))
        (should (supertag-node--goto-location "heading-node"))
        (should (looking-at "\\* Heading"))
        (let ((point (point)))
          (should-not (supertag-node--goto-location "absent"))
          (should (= point (point))))
        (goto-char (point-max))
        (should (supertag-node--goto-location "file-node"))
        (should (= (point-min) (point)))
        (should (equal live (buffer-string))) (should (eq dirty (buffer-modified-p)))
        (should (equal disk (with-temp-buffer (insert-file-contents file) (buffer-string))))
        (should (equal nodes (supertag-node-feature--facts :nodes)))
        (should (equal ids org-id-locations))))))


(defun supertag-node-feature--location-cold (entry scenario)
  "Run ENTRY and SCENARIO without preloading the Sync provider in the child."
  (let* ((tmp (make-temp-file "supertag-node-b-cold-" t))
         (root supertag-node-feature--root)
         (program (or (getenv "EMACS_BIN") (expand-file-name invocation-name invocation-directory)))
         (deps (split-string (or (getenv "SUPERTAG_DEPS_LOADPATH") "") path-separator t))
         (process-environment (copy-sequence process-environment))
         (script (expand-file-name "cold.el" tmp))
         (form
          `(condition-case err
               (unwind-protect
                   (progn
                     (require 'cl-lib) (require 'ert) (require 'org)
                     (setq user-emacs-directory ,(file-name-as-directory tmp)
                           supertag-data-directory user-emacs-directory
                           supertag--base-data-directory user-emacs-directory
                           supertag-db-file ,(expand-file-name "db.el" tmp)
                           supertag-db-backup-directory ,(expand-file-name "backups/" tmp)
                           supertag-sync-state-file ,(expand-file-name "sync.el" tmp)
                           supertag-sync--state-source supertag-sync-state-file
                           supertag-file-id-source 'org-id
                           supertag-sync-directories-mode 'unified
                           supertag-sync-directories (list ,(if (eq scenario 'out) (expand-file-name "outside/" tmp) tmp))
                           supertag-sync-exclude-directories nil
                           org-id-locations-file ,(expand-file-name "ids" tmp)
                           org-id-locations nil org-id-files nil org-id-track-globally nil
                           org-mode-hook nil after-init-time nil
                           supertag-view-style-auto-enable nil
                           make-backup-files nil auto-save-default nil load-prefer-newer t)
                     (load (expand-file-name ,(pcase entry ('ui (if (equal (getenv "SUPERTAG_SYA_STAGE") "before") "supertag-ui-commands.el" "supertag-node.el"))
                                                ('tag "supertag-tag.el") (_ "supertag-node.el")) ,root) nil nil t)
                     (princ "NODE-B-ENTRY-LOADED\n")
                     (dolist (symbol '(supertag-ui--get-containing-node-at-point supertag-ui--ensure-node-synced
                                       supertag-ui--file-node-p supertag-ui--get-file-node-at-point
                                       supertag-ui--ensure-file-node-synced supertag-ui--find-node-marker))
                       (unless (and (fboundp symbol) (not (autoloadp (symbol-function symbol)))
                                    (equal (symbol-file symbol 'defun) ,(expand-file-name "supertag-node.el" root)))
                         (error "NODE-B owner is not Node: %S (%S)" symbol (symbol-file symbol 'defun))))
                     (when (eq ',entry 'node)
                       (dolist (feature '(supertag-services-sync supertag-core-scan supertag-tag supertag-query supertag-services-query supertag-services-note-query
                                          supertag-ui-commands supertag-services-ui supertag-link supertag))
                         (should-not (featurep feature))
                         (should-not (cl-find-if (lambda (row) (and (stringp (car row))
                                                                   (equal (file-name-base (car row)) (symbol-name feature)))) load-history)))
                       (should-not supertag--store) (should-not (file-exists-p supertag-db-file)))
                     (when (and (eq ',entry 'node) (eq ',scenario 'owner))
                       (dolist (symbol '(supertag-node-sync-at-point supertag-sync--process-single-file
                                         supertag-sync--in-scope-path-p supertag-sync-update-state
                                         supertag-sync--parse-file-header supertag-sync--upsert-file-node))
                         (should (autoloadp (symbol-function symbol)))
                         (should (equal "supertag-services-sync" (nth 1 (symbol-function symbol)))))
                       (should (autoloadp (symbol-function 'supertag-find-file-node)))
                       (should (equal "supertag-query" (nth 1 (symbol-function 'supertag-find-file-node))))
                       (with-temp-buffer
                         (org-mode) (insert "* Pure getter\nBody\n") (goto-char (point-min))
                         (should (stringp (supertag-ui--get-containing-node-at-point)))
                         (should (buffer-modified-p)))
                       (should-not supertag--store) (should-not org-id-locations)
                       (should-not (featurep 'supertag-services-sync))
                       (should-not (featurep 'supertag-tag))
                       ;; Existing file lookup now resolves Query without the retired
                       ;; scan→Tag load cost or synchronization.
                       (supertag--ensure-store)
                       (let ((file ,(expand-file-name "existing.org" tmp)))
                         (with-temp-file file (insert "File text\n"))
                         (supertag-node-create (list :id "existing-file" :level 0 :file file))
                         (with-current-buffer (find-file-noselect file)
                           (should (equal "existing-file" (supertag-ui--get-file-node-at-point))))
                         (should (featurep 'supertag-query))
                         (should-not (autoloadp (symbol-function 'supertag-find-file-node)))
                         (should (equal (symbol-file 'supertag-find-file-node 'defun)
                                        ,(expand-file-name "supertag-query.el" root)))
                         (dolist (feature '(supertag-core-scan supertag-tag))
                           (should-not (featurep feature))
                           (should-not (cl-find-if (lambda (row) (and (stringp (car row))
                                                                     (equal (file-name-base (car row)) (symbol-name feature)))) load-history)))
                         (should-not (featurep 'supertag-services-sync))
                         (should-not (featurep 'supertag-ui-commands))))
                     (unless (eq ',scenario 'owner)
                       ;; Exact lazy declarations; mutation deliberately checks the
                       ;; missing predicate via actual branch behavior below.
                       (dolist (symbol '(supertag-node-sync-at-point supertag-sync--process-single-file
                                         supertag-sync-update-state supertag-sync--parse-file-header
                                         supertag-sync--upsert-file-node))
                         (should (autoloadp (symbol-function symbol)))
                         (should (equal "supertag-services-sync" (nth 1 (symbol-function symbol)))))
                       (should (autoloadp (symbol-function 'supertag-find-file-node)))
                       (should (equal "supertag-query" (nth 1 (symbol-function 'supertag-find-file-node))))
                       (defvar nb-events nil)
                       (defvar nb-observers nil)
                       (defun nb-install-sync (loaded)
                         (when (and (stringp loaded) (equal "supertag-services-sync" (file-name-base loaded)))
                           (should (featurep 'supertag-services-sync))
                           (dolist (symbol '(supertag-sync--in-scope-path-p supertag-sync--process-single-file
                                             supertag-sync--parse-file-header supertag-sync--upsert-file-node
                                             supertag-sync-update-state))
                             (should-not (autoloadp (symbol-function symbol)))
                             (should (equal (symbol-file symbol 'defun) ,(expand-file-name "supertag-services-sync.el" root)))
                             (let* ((observed-symbol symbol)
                                    (observer
                                    (lambda (original &rest args)
                                      (let ((value (apply original args)))
                                        (push (list observed-symbol (copy-tree args) value) nb-events)
                                        value))))
                               (push (cons symbol observer) nb-observers)
                               (advice-add symbol :around observer)))))
                       (add-hook 'after-load-functions #'nb-install-sync)
                       (supertag--ensure-store)
                       (let ((file ,(expand-file-name "source.org" tmp)))
                         (with-temp-file file (insert ":PROPERTIES:\n:ID: cold-file\n:END:\n#+TITLE: Saved S1\nBody\n"))
                         (with-current-buffer (find-file-noselect file)
                           (goto-char (point-min)) (search-forward "Saved S1") (replace-match "Draft S2")
                           (let ((live (buffer-string))
                                 (disk (with-temp-buffer (insert-file-contents file) (buffer-string))))
                             (supertag-ui--ensure-file-node-synced file)
                             (let ((predicate (assq 'supertag-sync--in-scope-path-p nb-events))
                                   (process (assq 'supertag-sync--process-single-file nb-events)))
                               (unless (and predicate (if (eq ',scenario 'in) (and (nth 2 predicate) process)
                                                         (and (not (nth 2 predicate)) (not process))))
                                 (error "NODE-B actual branch mismatch %S events=%S" ',scenario nb-events)))
                             (should (assq 'supertag-sync--parse-file-header nb-events))
                             (should (assq 'supertag-sync--upsert-file-node nb-events))
                             (should (equal "Saved S1" (plist-get (supertag-node-get "cold-file") :title)))
                             (let ((state (cl-remove-if-not (lambda (row) (eq (car row) 'supertag-sync-update-state)) nb-events)))
                               (if (eq ',scenario 'in)
                                   (progn (should (= 1 (cl-count 1 state :key (lambda (row) (length (cadr row))))))
                                          (should (= 1 (cl-count 2 state :key (lambda (row) (length (cadr row)))))))
                                 (should-not state)))
                             (setq nb-events nil)
                             (supertag-ui--ensure-file-node-synced file)
                             (let ((state (cl-remove-if-not (lambda (row) (eq (car row) 'supertag-sync-update-state)) nb-events)))
                               (if (eq ',scenario 'in)
                                   ;; Original quoted counters keep the outer call positive.
                                   (progn (should (= 1 (cl-count 1 state :key (lambda (row) (length (cadr row))))))
                                          (should (= 1 (cl-count 2 state :key (lambda (row) (length (cadr row)))))))
                                 (should-not state)))
                             (should (equal live (buffer-string))) (should (buffer-modified-p))
                             (should (equal disk (with-temp-buffer (insert-file-contents file) (buffer-string)))))))
                       (should-not (featurep 'supertag-ui-commands))
                       (should-not (featurep 'supertag-services-ui))
                       (let ((sync (symbol-function 'supertag-node-sync-at-point))
                             (membership (symbol-function 'supertag-node-has-tag-p)))
                         (load (expand-file-name "supertag-node.el" ,root) nil nil t)
                         (should (eq sync (symbol-function 'supertag-node-sync-at-point)))
                         (should (eq membership (symbol-function 'supertag-node-has-tag-p))))
                       (princ (format "NODE-B-BRANCH-PASS %S\n" ',scenario)))
                     (princ (format "NODE-B-COLD-PASS %S %S\n" ',entry ',scenario)))
                 (when (boundp 'nb-observers)
                   (dolist (pair nb-observers) (advice-remove (car pair) (cdr pair))))
                 (when (fboundp 'nb-install-sync) (remove-hook 'after-load-functions #'nb-install-sync))
                 (setq emacs-startup-hook nil kill-emacs-hook nil org-mode-hook nil enable-theme-functions nil)
                 (mapc #'cancel-timer (append timer-list timer-idle-list)))
             (error (princ (format "NODE-B-ERROR %S\n" err)) (kill-emacs 1)))))
    (unwind-protect
        (progn
          (with-temp-file script
            (insert ";;; -*- lexical-binding: t; -*-\n")
            (let ((print-length nil) (print-level nil)) (prin1 form (current-buffer))))
          (setenv "HOME" tmp) (setenv "CFFIXED_USER_HOME" tmp)
          (setenv "EMACSLOADPATH" (concat (mapconcat #'identity deps path-separator) path-separator))
          (with-temp-buffer
            (let* ((status (apply #'call-process program nil t nil
                                  (append '("-Q" "--batch")
                                          (apply #'append (mapcar (lambda (dir) (list "-L" dir)) deps))
                                          (list "-L" root "-l" script))))
                   (output (buffer-string)))
              (unless (and (equal status 0) (string-match-p "NODE-B-ENTRY-LOADED" output)
                           (string-match-p "NODE-B-COLD-PASS" output))
                (ert-fail (format "NODE-B %S/%S exit=%S\n%s" entry scenario status output)))
              (princ (format "NODE-B %S/%S ENTRY/PASS\n" entry scenario)))))
      (delete-directory tmp t))))


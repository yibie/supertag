                  (should (equal (list args) calls))))
              (setq supertag--initialized t supertag-org-id-open-link-auto-enable t calls nil)
              (should (eq t (org-id-open-link "inside" 'extra "tail")))
              (should-not calls)
              (should (equal "inside" (org-entry-get nil "ID")))
              (setq fail-original t)
              (should (equal '(error "NODE-H original Org failure")
                             (should-error (org-id-open-link "unknown" 'extra) :type 'error)))
              (setq fail-original nil)
              ;; An error from the real scope body must not turn into Org fallback.
              (let ((supertag-sync-file-pattern "["))
                (setq calls nil)
                (should-error (org-id-open-link "inside") :type 'invalid-regexp)
                (should-not calls))
              (supertag-disable-org-id-open-link-integration)
              (supertag-disable-org-id-open-link-integration)
              (should-not (advice-member-p 'supertag-service-org--org-id-open-link-advice 'org-id-open-link))
              (load (expand-file-name "supertag-service-org.el" nh-root) nil nil t)
              (should-not (advice-member-p 'supertag-service-org--org-id-open-link-advice 'org-id-open-link))
              (should (eq 'native-result (org-id-open-link "inside" 'extra)))))
        (when (eq nh-stage 'before)
          (load (expand-file-name "supertag-service-org.el" nh-root) nil nil t))
        (let* ((id (if (eq nh-case 'outside) "outside" "inside"))
               (result (supertag-service-org-follow-id id)))
          (princ (format "NODE-H-SCOPE %S returned=%S sync=%S source-selected=%S\n" nh-case result (featurep 'supertag-services-sync) (eq source (current-buffer))))
          (if (eq nh-case 'outside)
              (progn (should-not result) (should (eq source (current-buffer))))
            (should result) (should (equal "inside" (org-entry-get nil "ID"))))
          (should (featurep 'supertag-services-sync))
          (should-not (autoloadp (symbol-function 'supertag-sync--in-sync-scope-p)))
          (should (equal (symbol-file 'supertag-sync--in-sync-scope-p 'defun) (expand-file-name "supertag-services-sync.el" nh-root)))))
      (let ((owner (symbol-file 'supertag-service-org-follow-id 'defun)))
        (load (expand-file-name "supertag-node.el" nh-root) nil nil t)
        (load (expand-file-name "supertag-service-org.el" nh-root) nil nil t)
        (should (equal owner (symbol-file 'supertag-service-org-follow-id 'defun)))))
    (when (buffer-live-p (get-buffer " *node-h-cold-source*")) (kill-buffer " *node-h-cold-source*")))
  (princ "NODE-H-PASS\n"))))
    (unwind-protect
        (progn
          (with-temp-file script
            (insert ";;; -*- lexical-binding: t; -*-\n")
            (prin1 `(setq nh-root ,root nh-tmp ,tmp nh-stage ',stage nh-case ',scenario nh-preset ',preset) (current-buffer))
            (insert "\n")
            (let ((print-length nil) (print-level nil))
              (prin1 `(condition-case err
                          (unwind-protect ,body

;;; NODE-H: parent reads and scoped ID navigation, without policy unification.
(require 'supertag-service-org)

(defun supertag-node-feature--h-file (file)
  (with-temp-file file
    (insert "* TODO [#A] Parent #token :tag:\n:PROPERTIES:\n:ID: parent\n:END:\nParent body\n** Child\n:PROPERTIES:\n:ID: child\n:END:\nChild body\n* Sibling\n:PROPERTIES:\n:ID: sibling\n:END:\nSibling body\n"))
  (dolist (id '("parent" "child" "sibling"))
    (supertag-store-put-entity :nodes id
      (list :id id :file file :position 99999 :level (if (equal id "child") 2 1) :title id))))

(ert-deftest supertag-node-feature-parent-real-read-restriction-and-errors ()
  (save-window-excursion
    (supertag-node-feature--with-store
      (let* ((file (expand-file-name "parent.org" tmp))
             (source (generate-new-buffer " *node-h-source*")) target child sibling)
        (unwind-protect
            (progn
              (supertag-node-feature--h-file file)
              (setq target (find-file-noselect file))
              (with-current-buffer target
                (goto-char (point-min)) (search-forward "** Child") (beginning-of-line) (setq child (point))
                (search-forward "* Sibling") (beginning-of-line) (setq sibling (point)))
              (switch-to-buffer source) (insert "source") (goto-char 3)
              (let ((disk (supertag-node-feature--disk file))
                    (store (prin1-to-string supertag--store)))
                (dolist (restriction '(none parent-outside target-outside))
                  (with-current-buffer target
                    (widen)
                    (pcase restriction
                      ('parent-outside (narrow-to-region child (1- sibling)))
                      ('target-outside (narrow-to-region sibling (point-max))))
                    (goto-char (point-max)))
                  (let ((context (with-current-buffer target (list (point) (point-min) (point-max)))) result caught)
                    (condition-case e (setq result (supertag-service-org--parent-title "child")) (error (setq caught e)))
                    (pcase restriction
                      ('none (should (equal "Parent #token" result)) (should-not caught))
                      ('parent-outside (should-not result) (should-not caught))
                      ('target-outside
                       (should-not result)
                       (should (equal (list 'user-error (format-message "Node 'child' was not found in %s" file))
                                      caught))))
                    (should (eq source (current-buffer))) (should (= 3 (point)))
                    (should (equal context (with-current-buffer target (list (point) (point-min) (point-max)))))
                    (princ (format "NODE-H-PARENT %S result=%S error=%S\n" restriction result caught))))
                (with-current-buffer target (widen))
                (should-not (supertag-service-org--parent-title "parent"))
                (should-not (supertag-service-org--parent-title "unknown"))
                (supertag-store-put-entity :nodes "missing" (list :id "missing" :file (expand-file-name "missing.org" tmp)))
                (should-not (supertag-service-org--parent-title "missing"))
                (supertag-store-put-entity :nodes "wrong" (list :id "wrong" :file file :level 1))
                (should (equal (list 'user-error (format-message "Node 'wrong' was not found in %s" file))
                               (should-error (supertag-service-org--parent-title "wrong") :type 'user-error)))
                ;; Only explicit fixture seeds above change Store.
                (remhash "missing" (supertag-store-get-collection :nodes))
                (remhash "wrong" (supertag-store-get-collection :nodes))
                (should (equal store (prin1-to-string supertag--store)))
                (should (equal disk (supertag-node-feature--disk file)))
                (with-current-buffer target (should (equal disk (buffer-string))) (should-not (buffer-modified-p)))))
          (kill-buffer source))))))

(ert-deftest supertag-node-feature-follow-real-scope-reveal-and-location-fallback ()
  (save-window-excursion
    (supertag-node-feature--with-store
      (let* ((in (expand-file-name "in/" tmp)) (out (expand-file-name "out/" tmp))
             (excluded (expand-file-name "excluded/" in))
             (source (generate-new-buffer " *node-h-source*"))
             (supertag-sync-directories (list in)) (supertag-sync-directories-mode 'unified)
             (supertag-sync-exclude-directories (list excluded)) (supertag-sync-file-pattern "\\.org$")
             (supertag-node-location-org-id-fallback nil))
        (unwind-protect
            (progn
              (mapc (lambda (d) (make-directory d t)) (list in out excluded))
              (dolist (kind '(inside inside-target-outside outside excluded pattern))
                (let* ((file (expand-file-name (format "%s.%s" kind (if (eq kind 'pattern) "txt" "org"))
                                               (pcase kind ('outside out) ('excluded excluded) (_ in))))
                       (handled (memq kind '(inside inside-target-outside))))
                  (supertag-node-feature--h-file file)
                  (let ((target (find-file-noselect file)) (disk (supertag-node-feature--disk file))
                        (store (prin1-to-string supertag--store)))
                    (with-current-buffer target
                      (org-mode) (goto-char (point-min)) (org-fold-hide-subtree)
                      (search-forward (if (eq kind 'inside) "** Child" "* Sibling"))
                      (beginning-of-line) (narrow-to-region (point) (point-max)))
                    (switch-to-buffer source)
                    (should (eq (and handled t) (and (supertag-service-org-follow-id "child") t)))
                    (if handled
                        (progn (should (eq target (current-buffer)))
                               (should-not (buffer-narrowed-p))
                               (should (equal "child" (org-entry-get nil "ID")))
                               (should-not (org-invisible-p (point))))
                      (should (eq source (current-buffer))))
                    (should (equal store (prin1-to-string supertag--store)))
                    (should (equal disk (supertag-node-feature--disk file)))
                    (with-current-buffer target (save-restriction (widen) (should (equal disk (buffer-string)))) (should-not (buffer-modified-p))))))
              (should-not (supertag-service-org-follow-id nil))
              (should-not (supertag-service-org-follow-id 42))
              (should-not (supertag-service-org-follow-id "unknown"))
              ;; Actual Org ID fallback uses only a temporary in-memory ID cache.
              (let* ((file (expand-file-name "fallback.org" in))
                     (org-id-locations (make-hash-table :test 'equal))
                     (supertag-node-location-org-id-fallback t))
                (with-temp-file file (insert "* Fallback\n:PROPERTIES:\n:ID: fallback\n:END:\n"))
                (puthash "fallback" file org-id-locations)
                (should (supertag-service-org-follow-id "fallback"))
                (should (equal "fallback" (org-entry-get nil "ID")))
                (supertag-store-put-entity :nodes "fallback" (list :id "fallback" :file (expand-file-name "missing.org" tmp) :level 1))
                (should-not (supertag-service-org-follow-id "fallback"))
                (supertag-store-put-entity :nodes "fallback" (list :id "fallback" :file (expand-file-name "inside.org" in) :level 1))
                (should-not (supertag-service-org-follow-id "fallback"))))
          (kill-buffer source))))))

;;; NODE-H independent scope and retained Org integration.
(defun supertag-node-feature--h-cold (stage scenario preset)
  (let* ((tmp (make-temp-file "supertag-node-h-" t))
         (root supertag-node-feature--root)
         (program (or (getenv "EMACS_BIN") (expand-file-name invocation-name invocation-directory)))
         (deps (split-string (or (getenv "SUPERTAG_DEPS_LOADPATH") "") path-separator t))
         (process-environment (copy-sequence process-environment))
         (script (expand-file-name "cold.el" tmp))
         (body '(progn
  (require 'cl-lib) (require 'ert) (require 'org) (require 'org-id)
  (setq user-emacs-directory (file-name-as-directory nh-tmp)
        supertag-data-directory nh-tmp supertag--base-data-directory nh-tmp
        supertag-db-file (expand-file-name "db.el" nh-tmp)
        supertag-db-backup-directory (expand-file-name "backup/" nh-tmp)
        supertag-sync-state-file (expand-file-name "sync.el" nh-tmp)
        supertag-sync--state-source supertag-sync-state-file
        supertag-sync-directories (list (expand-file-name "in/" nh-tmp))
        supertag-sync-directories-mode 'unified supertag-sync-exclude-directories nil
        supertag-sync-file-pattern "\\.org$"
        org-id-locations-file (expand-file-name "ids" nh-tmp)
        org-id-locations nil org-id-files nil org-id-track-globally nil
        org-mode-hook nil after-init-time nil supertag-view-style-auto-enable nil
        supertag-org-capture-auto-enable nil org-capture-after-finalize-hook nil
        make-backup-files nil auto-save-default nil)
  (when (eq nh-preset 'disabled) (setq supertag-org-id-open-link-auto-enable nil))
  (load (expand-file-name "supertag-node.el" nh-root) nil nil t)
  (princ (format "NODE-H-ENTRY stage=%S case=%S preset=%S\n" nh-stage nh-case nh-preset))
  (should (featurep 'supertag-service-org))
  (dolist (feature '(supertag-services-ui supertag-ui-commands supertag-query supertag-services-query supertag-services-note-query supertag-services-sync supertag))
    (should-not (featurep feature))
    (should-not (cl-find-if (lambda (entry) (and (stringp (car entry)) (equal (file-name-base (car entry)) (symbol-name feature)))) load-history)))
  (should-not (file-exists-p supertag-db-file))
  (should (boundp 'supertag-org-id-open-link-auto-enable))
  (should (eq (not (eq nh-preset 'disabled)) supertag-org-id-open-link-auto-enable))
  (when (fboundp 'org-id-open-link)
    (should (eq (not (eq nh-preset 'disabled))
                (not (null (advice-member-p 'supertag-service-org--org-id-open-link-advice
                                           'org-id-open-link))))))
  (defun nh-owners (file)
    (dolist (symbol '(supertag-service-org-follow-id supertag-service-org--parent-title))
      (should (equal (symbol-file symbol 'defun) (expand-file-name file nh-root)))
      (should-not (commandp symbol))))
  (if (eq nh-case 'owner)
      (nh-owners "supertag-node.el")
    (when (eq nh-stage 'after)
      (nh-owners "supertag-node.el")
      ;; Outside test deliberately checks execution before any metadata assertion,
      ;; so omitting the autoload fails at the permissive real return branch.
      (unless (eq nh-case 'outside)
        (should (autoloadp (symbol-function 'supertag-sync--in-sync-scope-p)))
        (should (equal "supertag-services-sync" (nth 1 (symbol-function 'supertag-sync--in-sync-scope-p))))))
    (let* ((in (expand-file-name "in/" nh-tmp)) (out (expand-file-name "out/" nh-tmp))
           (inside (expand-file-name "inside.org" in)) (outside (expand-file-name "outside.org" out))
           (source (get-buffer-create " *node-h-cold-source*")))
      (make-directory in t) (make-directory out t)
      (with-temp-file inside (insert "* Parent\n:PROPERTIES:\n:ID: parent\n:END:\n** Inside\n:PROPERTIES:\n:ID: inside\n:END:\nBody\n"))
      (with-temp-file outside (insert "* Outside\n:PROPERTIES:\n:ID: outside\n:END:\nBody\n"))
      (supertag--ensure-store)
      (supertag-store-put-entity :nodes "inside" (list :id "inside" :file inside :position 99999 :level 2))
      (supertag-store-put-entity :nodes "outside" (list :id "outside" :file outside :position 99999 :level 1))
      (switch-to-buffer source) (insert "source") (goto-char 3)
      (if (eq nh-case 'integration)
          (let (calls fail-original)
            (cl-letf (((symbol-function 'org-id-open-link)
                       (lambda (&rest args)
                         (push args calls)
                         (when fail-original (error "NODE-H original Org failure"))
                         'native-result)))
              (load (expand-file-name "supertag-service-org.el" nh-root) nil nil t)

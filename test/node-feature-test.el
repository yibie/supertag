            (should (equal "value" (org-entry-get nil "CUSTOM")))
            (should (string-match-p "Own body" (plist-get data :content)))
            (should-not (string-match-p "Child body" (plist-get data :content)))
            (should (equal "Heading #inline" (supertag-ui--heading-title-at-point)))
            (should-not (supertag-tag-get "inline")) (should-not (supertag-tag-get "orgtag")))
          (re-search-forward "^\\* IDless") (beginning-of-line)
          (should-not (supertag--get-node-props-at-point))
          (should-not (org-entry-get nil "ID"))
          (forward-line 1) (should-not (supertag-ui--heading-title-at-point))
          (should (equal live (buffer-string))) (should-not (buffer-modified-p))

(ert-deftest supertag-node-feature-content-level-adapter-preserves-original-contract ()
  (require 'supertag-service-org)
  (should (equal "supertag-service-org.el"
                 (file-name-nondirectory (symbol-file 'supertag-ui--adjust-content-level 'defun))))
  (let ((content "* A\n** B\nBody\n"))
    (should (eq content (supertag-ui--adjust-content-level content nil 3)))

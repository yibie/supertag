(defun supertag-node-feature--compat-create (mode fault)
  (save-window-excursion
    (supertag-node-feature--with-store
      (let* ((file (expand-file-name "target.org" tmp))
             (text "Before\nTail\n")
             (source (generate-new-buffer " *node-g-source*"))
             (supertag-sync-directories (list tmp))
             (supertag-sync-directories-mode 'unified)
             (supertag-sync--internal-modifications (make-hash-table :test 'equal))
             (supertag-async--queue nil) (supertag-async--timer nil)
             (id-real (symbol-function 'supertag-node-identity-new))
             (visit-real (symbol-function 'find-file-noselect))
             (save-real (symbol-function 'save-buffer))
             (create-real (symbol-function 'supertag-node-create))
             (commit-real (symbol-function 'supertag-ops-commit))
             id result caught events live-before pos target min max)
        (unwind-protect
            (progn
              (with-temp-file file (insert text))
              (setq target (find-file-noselect file))
              (with-current-buffer target
                (setq-local after-save-hook nil)
                (when (eq mode 'hook) (supertag-sync-setup-realtime-hooks))
                (when (eq mode 'draft) (goto-char (point-max)) (insert "Unrelated draft\n"))
                (when (eq mode 'narrow) (narrow-to-region 2 (1- (point-max))))
                (setq pos (pcase mode ('start 1) ((or 'mid 'narrow) 4) (_ (point-max)))
                      min (point-min) max (point-max) live-before (buffer-string)))
              (switch-to-buffer source) (insert "Source unchanged") (goto-char 4)
              (cl-letf (((symbol-function 'supertag-async--ensure-timer) #'ignore)
                        ((symbol-function 'supertag-node-identity-new)
                         (lambda () (setq id (funcall id-real)) (push 'id events) id))
                        ((symbol-function 'find-file-noselect)
                         (lambda (&rest args) (when (equal file (car args)) (push 'visit events)) (apply visit-real args)))
                        ((symbol-function 'save-buffer)
                         (lambda (&rest args)
                           (push 'save-entry events)
                           (should-not (supertag-node-get id))
                           (when (eq fault 'save-before) (error "NODE-G save-before"))
                           (apply save-real args) (push 'saved events)
                           (when (eq fault 'save-after) (error "NODE-G save-after"))))
                        ((symbol-function 'supertag-node-create)
                         (lambda (props)
                           (push 'node-create events)
                           (should (string-match-p (regexp-quote id) (supertag-node-feature--disk file)))
                           (when (eq mode 'hook) (should (member (file-truename file) supertag-async--queue)))
                           (when (eq fault 'node-before) (error "NODE-G node-before"))
                           (funcall create-real props)))
                        ((symbol-function 'supertag-ops-commit)
                         (lambda (&rest args)
                           (push 'commit events)
                           (when (eq fault 'commit-before) (error "NODE-G commit-before"))
                           (prog1 (apply commit-real args)
                             (when (eq fault 'commit-after) (error "NODE-G commit-after"))))))
                (condition-case e
                    (setq result (supertag-ui--create-heading-node "Created" file (list :position pos :level 1)))
                  (error (setq caught e))))
              (should (eq source (current-buffer))) (should (= 4 (point)))
              (should (equal "Source unchanged" (buffer-string)))
              (should (equal '(id visit) (seq-take (reverse events) 2)))
              (should (equal caught (and fault (list 'error (concat "NODE-G " (symbol-name fault))))))
              (with-current-buffer target
                (should (not (equal live-before (buffer-string))))
                (should (= min (point-min)))
                (should (> (point-max) max))
                (should (eq (eq mode 'narrow) (and (buffer-narrowed-p) t)))
                (should (org-at-heading-p))
                (should (equal id (org-entry-get nil "ID")))
                (should (eq (eq fault 'save-before) (and (buffer-modified-p) t)))
                (when (eq mode 'draft) (should (string-match-p "Unrelated draft" (buffer-string)))))
              (if (eq fault 'save-before)
                  (should (equal text (supertag-node-feature--disk file)))
                (should (string-match-p (regexp-quote id) (supertag-node-feature--disk file))))
              (if (memq fault '(nil commit-after))
                  (let ((node (supertag-node-get id)))
                    (should (equal "Created" (plist-get node :title)))
                    (should (equal file (plist-get node :file)))
                    (should (= pos (plist-get node :position)))
                    (should (= 1 (plist-get node :level))))
                (should-not (supertag-node-get id)))
              (unless fault (should (equal id result)))
              (when (memq fault '(save-before save-after)) (should-not (memq 'node-create events)))
              (when (eq fault 'node-before) (should-not (memq 'commit events)))
              (should-not org-id-locations)
              (princ (format "NODE-G-CREATE mode=%S fault=%S pos=%S targetpoint=%S events=%S queue=%S\n"
                             mode fault pos (with-current-buffer target (point)) (reverse events) (length supertag-async--queue))))
          (when (timerp supertag-async--timer) (cancel-timer supertag-async--timer))
          (kill-buffer source))))))


(ert-deftest supertag-node-feature-legacy-link-format-contract ()
  (supertag-node-feature--with-store
    (supertag-node-create '(:id "id.x+" :title "ID"))
    (supertag-node-create '(:id "denote.x+" :title "Denote" :link-type denote))
    (should (equal "id" (supertag-node-link-type "id.x+")))
    (should (equal "denote" (supertag-node-link-type "denote.x+")))
    (should (equal "[[id:id.x+][id.x+]]" (supertag-node-format-link "id.x+")))
    (should (equal "[[denote:denote.x+][Shown]]" (supertag-node-format-link "denote.x+" "Shown")))
    (should (equal "[[custom:id.x+][Override]]" (supertag-node-format-link "id.x+" "Override" "custom")))
    (should (string-match-p (supertag-node-link-pattern "denote.x+") "[[denote:denote.x+][Shown]]"))
    (should-not (string-match-p (supertag-node-link-pattern "denote.x+") "[[denote:denoteXxx][Shown]]"))))


(defun supertag-node-feature--cold (entry)
  "Exercise ENTRY in an independent process without loading this test file."
  (let* ((directory (make-temp-file "supertag-node-cold-" t))
         (root supertag-node-feature--root)
         (program (or (getenv "EMACS_BIN") (expand-file-name invocation-name invocation-directory)))
         (deps (split-string (or (getenv "SUPERTAG_DEPS_LOADPATH") "") path-separator t))
         (process-environment (copy-sequence process-environment))
         helpers)
    ;; Copy only test exercise definitions, never the file's require/ERT forms.
    (with-temp-buffer
      (insert-file-contents (expand-file-name "test/node-feature-test.el" root))
      (goto-char (point-min))
      (condition-case nil
          (while t
            (let ((form (read (current-buffer))))
              (when (memq (cadr form)
                          '(supertag-node-feature--with-store supertag-node-feature--facts
                            supertag-node-feature--entities supertag-node-feature--relation-index
                            supertag-node-feature--delete-relations supertag-node-feature--navigation))
                (push form helpers))))
        (end-of-file nil)))
    (unwind-protect
        (let* ((script (expand-file-name "cold.el" directory))
               (form
                `(condition-case err
                     (unwind-protect
                         (progn
                           (require 'cl-lib) (require 'ert) (require 'org)
                           (setq user-emacs-directory ,(file-name-as-directory directory)
                                 supertag-data-directory user-emacs-directory
                                 supertag--base-data-directory user-emacs-directory
                                 supertag-db-file ,(expand-file-name "unused-store.el" directory)
                                 supertag-db-backup-directory ,(expand-file-name "backups" directory)
                                 supertag-sync-state-file ,(expand-file-name "sync.el" directory)
                                 org-id-locations-file ,(expand-file-name "ids" directory)
                                 org-id-track-globally nil org-id-locations nil org-id-files nil
                                 after-init-time nil org-mode-hook nil
                                 supertag-view-style-auto-enable nil
                                 supertag-sync-directories nil supertag-active-sync-directory nil
                                 make-backup-files nil auto-save-default nil load-prefer-newer t)
                           (load (expand-file-name ,(pcase entry
                                                      ('tag "supertag-tag.el")
                                                      ('sync "supertag-services-sync.el")
                                                      ('node "supertag-node.el")
                                                      (_ (if (equal (getenv "SUPERTAG_LB_STAGE") "before") "supertag-ops-node.el" "supertag-node.el"))) ,root) nil nil t)
                           (princ "NODE-A-ENTRY-LOADED\n")
                           (dolist (symbol '(supertag--validate-node-data supertag-node-create
                                             supertag-node-get supertag-node--goto-location
                                             supertag-node-update supertag-node-delete supertag-node-set-location))
                             (unless (equal (symbol-file symbol 'defun) ,(expand-file-name "supertag-node.el" root))
                               (error "NODE-A wrong owner %S: %S" symbol (symbol-file symbol 'defun))))
                           (when (eq ',entry 'node)
                             (dolist (feature '(supertag-tag supertag-query supertag-services-query supertag-services-note-query supertag-services-sync
                                                supertag-services-ui supertag-ui-commands supertag-link
                                                supertag-ops-node supertag))
                               (should-not (featurep feature))
                               (should-not (cl-find-if
                                            (lambda (row) (and (stringp (car row))
                                                              (equal (file-name-base (car row)) (symbol-name feature))))
                                            load-history)))
                             (should-not supertag--store)
                             (should-not (file-exists-p supertag-db-file)))
                           ,@(nreverse helpers)
                           (supertag-node-feature--with-store (supertag-node-feature--entities tmp))
                           ;; Relation fixture construction requires Link after the cold guards.
                           (require 'supertag-link)
                           (supertag-node-feature--with-store (supertag-node-feature--delete-relations nil))
                           (supertag-node-feature--with-store (supertag-node-feature--delete-relations t))
                           (supertag-node-feature--with-store (supertag-node-feature--navigation tmp))
                           (when (eq ',entry 'node)
                             (should-not (featurep 'supertag-tag))
                             (should-not (featurep 'supertag-services-sync)))
                           ;; Exercise the real membership definition after lazy Tag load,
                           ;; then prove reloading both carriers does not reinstall autoloads.
                           (require 'supertag-tag)
                           (let ((functions (mapcar #'symbol-function
                                                   '(supertag-node-add-tag supertag-node-remove-tag
                                                     supertag-node-has-tag-p supertag-node-toggle-tag)))
                                 (mode (symbol-function 'supertag-ui-completion-mode)))
                             (supertag-node-feature--with-store
                               (supertag-node-create '(:id "member" :title "Member" :tags ("tag")))
                               (should (supertag-node-has-tag-p "member" "tag"))
                               (should-not (supertag-node-has-tag-p "member" "absent")))
                             (load (expand-file-name "supertag-node.el" ,root) nil nil t)
                             (load (expand-file-name (if (equal (getenv "SUPERTAG_LB_STAGE") "before") "supertag-ops-node.el" "supertag-link.el") ,root) nil nil t)
                             (cl-mapc (lambda (symbol original)
                                        (should-not (autoloadp (symbol-function symbol)))
                                        (should (eq original (symbol-function symbol))))
                                      '(supertag-node-add-tag supertag-node-remove-tag
                                        supertag-node-has-tag-p supertag-node-toggle-tag) functions)
                             (should (eq mode (symbol-function 'supertag-ui-completion-mode))))
                           (dolist (symbol '(supertag-node-link-type supertag-node-format-link supertag-node-link-pattern))
                             (should (equal (symbol-file symbol 'defun) ,(expand-file-name (if (equal (getenv "SUPERTAG_LB_STAGE") "before") "supertag-ops-node.el" "supertag-link.el") root))))
                           ;; Real native projection, after (not before) cold graph checks.
                           (require 'supertag-services-sync)
                           (supertag-node-feature--with-store
                             (let ((file (expand-file-name "project.org" tmp)))
                               (supertag-tag-create '(:id "sample-id" :name "sample"))
                               (with-temp-file file (insert "* Project #sample\n:PROPERTIES:\n:ID: project-node\n:END:\nBody\n"))
                               (with-current-buffer (find-file-noselect file)
                                 (goto-char (point-min))
                                 (supertag-node-sync-at-point))
                               (should (equal "Project" (plist-get (supertag-node-get "project-node") :title)))
                               (let ((tag-id (supertag-tag-resolve-occurrence "sample")))
                                 (should tag-id)
                                 (should (supertag-node-has-tag-p "project-node" tag-id)))))
                           (princ (format "NODE-A-COLD-PASS %S\n" ',entry)))
                       (setq emacs-startup-hook nil kill-emacs-hook nil org-mode-hook nil enable-theme-functions nil)
                       (mapc #'cancel-timer (append timer-list timer-idle-list)))
                   (error (princ (format "NODE-A-ERROR %S\n" err)) (kill-emacs 1)))))
          (with-temp-file script
            (insert ";;; -*- lexical-binding: t; -*-\n")
            (let ((print-length nil) (print-level nil)) (prin1 form (current-buffer))))
          (setenv "HOME" directory) (setenv "CFFIXED_USER_HOME" directory)
          (setenv "EMACSLOADPATH" (concat (mapconcat #'identity deps path-separator) path-separator))
          (with-temp-buffer
            (let* ((status (apply #'call-process program nil t nil
                                  (append '("-Q" "--batch")
                                          (apply #'append (mapcar (lambda (dir) (list "-L" dir)) deps))
                                          (list "-L" root "-l" script))))
                   (output (buffer-string)))
              (unless (and (equal status 0) (string-match-p "NODE-A-ENTRY-LOADED" output)
                           (string-match-p "NODE-A-COLD-PASS" output))
                (ert-fail (format "NODE-A %S exit=%S\n%s" entry status output)))
              (princ (format "NODE-A %S exit0 ENTRY-LOADED/PASS\n" entry)))))
      (delete-directory directory t))))


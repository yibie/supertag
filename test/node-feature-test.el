(ert-deftest supertag-node-feature-marker-metadata-narrowing-and-fail-closed ()
  (supertag-node-feature--location-store
    (let ((file (expand-file-name "markers.org" tmp)))
      ;; Preserve the exact marker adapter's keyword-before-drawer layout.
      (with-temp-file file
        (insert "#+TITLE: Marker\n:PROPERTIES:\n:ID: file-marker\n:END:\n\nBody\n* Heading\n:PROPERTIES:\n:ID: heading-marker\n:END:\nText\n"))
      (supertag-node-create (list :id "file-marker" :level 0 :file file))
      (supertag-node-create (list :id "heading-marker" :title "Heading" :level 1 :file file))
      (with-current-buffer (find-file-noselect file)
        (let ((live (buffer-string)) (disk (supertag-node-feature--disk file)))
          (goto-char (point-min)) (search-forward "Text")
          (narrow-to-region (line-beginning-position) (point-max))
          (let ((p (point)) (lo (point-min)) (hi (point-max)))
            (let ((marker (supertag-ui--find-node-marker "file-marker")))
              (should (markerp marker))
              (save-restriction (widen) (save-excursion (goto-char marker) (should (looking-at "Body"))))
              (set-marker marker nil))
            (should (= p (point))) (should (= lo (point-min))) (should (= hi (point-max))))
          (widen)

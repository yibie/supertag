(defvar supertag-semantic-request-timeout)

(defun supertag-semantic-test--dispose-request (options)
  "Clean temporary artifacts if a request assertion fails before its sentinel."
  (when options
    (let ((input (substring (cadr (member "--data-binary" (plist-get options :command))) 1)))
      (when (file-exists-p input) (delete-file input))))
  (dolist (key '(:buffer :stderr))
    (when (buffer-live-p (plist-get options key))
      (kill-buffer (plist-get options key)))))

(ert-deftest supertag-semantic-request-timeout-is-passed-to-curl ()
  (supertag-semantic-test-with-index
    (let ((supertag-semantic-request-timeout 7.5) options failure)
      (unwind-protect
          (cl-letf (((symbol-function 'make-process)
                     (lambda (&rest args) (setq options args) nil)))
            (supertag-semantic--request '("Body") (lambda (_vectors error) (setq failure error)))
            (let ((input (substring (cadr (member "--data-binary" (plist-get options :command))) 1)))
              (should (file-exists-p input))
              (cl-letf (((symbol-function 'process-status) (lambda (_) 'exit))
                        ((symbol-function 'process-exit-status) (lambda (_) 28)))
                (funcall (plist-get options :sentinel) nil "exited 28"))
              (should-not (file-exists-p input)))
            (should (equal "7.5" (cadr (member "--max-time" (plist-get options :command)))))
            (should (equal "Request timed out after 7.5 s" failure))
            (should (= 30 (eval (car (get 'supertag-semantic-request-timeout 'standard-value)) t))))
        (supertag-semantic-test--dispose-request options)))))


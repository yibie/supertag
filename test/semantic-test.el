;;; semantic-test.el --- Isolated semantic candidate contracts -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'document-fixture)
(require 'supertag-semantic)
(require 'supertag-view-node)

(defmacro supertag-semantic-test-with-index (&rest body)
  (declare (indent 0))
  `(supertag-document-test-with-vault
    (let ((supertag-semantic-enabled t)
          (supertag-semantic--vectors (make-hash-table :test 'equal))
          (supertag-semantic--dirty (make-hash-table :test 'equal))
          (supertag-semantic--context nil) (supertag-semantic--dim nil)
          (supertag-semantic--last-enabled nil) (supertag-semantic--last-save 0)
          (supertag-semantic--active nil) (supertag-semantic--process nil)
          (supertag-semantic--timer nil) (supertag-semantic--error nil)
          (supertag-semantic--paused nil) (supertag-semantic--rebuild nil)
          (supertag-semantic--needs-save nil)
          (supertag-semantic--subscription-table nil))
      (unwind-protect
          (cl-letf (((symbol-function 'supertag-semantic--schedule) #'ignore)
                    ((symbol-function 'supertag-semantic--probe) (lambda () t)))
            ,@body)
        (supertag-semantic-stop)))))

(defmacro supertag-semantic-test-with-request (&rest body)
  (declare (indent 0))
  `(let (requests)
     (cl-letf (((symbol-function 'supertag-semantic--request)
                (lambda (texts callback) (push (cons texts callback) requests) nil)))
	      ,@body)))

(defun supertag-semantic-test-complete (request &optional vector)
  (funcall (cdr request) (vconcat (mapcar (lambda (_) (or vector [1.0 0.0])) (car request))) nil))

(defun supertag-semantic-test-seed (id title content &optional refs)
  (supertag-store-put-entity :nodes id
                             (list :id id :title title :content content :level 1
                                   :ref-to refs :file (plist-get (supertag-semantic--node "document-node") :file)) t))

(ert-deftest supertag-semantic-disabled-does-nothing ()
  (supertag-semantic-test-with-index
   (let ((supertag-semantic-enabled nil)
         (store (prin1-to-string supertag--store))
         (subscribers (prin1-to-string supertag--subscribers)))
     (cl-letf (((symbol-function 'supertag-semantic--request) (lambda (&rest _) (ert-fail "Request while disabled"))))
       (with-temp-buffer (supertag-semantic-insert-section "document-node") (should (equal "" (buffer-string))))
       (supertag-semantic--pump)
       (supertag-semantic-status))
     (should-not supertag-semantic--context)
     (should (equal store (prin1-to-string supertag--store)))
     (should (equal subscribers (prin1-to-string supertag--subscribers)))
     (should-not (file-exists-p (supertag-data-file "supertag-semantic.el"))))))

(ert-deftest supertag-semantic-cache-preserves-all-bytes-and-rejects-nonbytes ()
  (supertag-semantic-test-with-index
   (supertag-semantic--ensure)
   (let ((bytes (apply #'unibyte-string (number-sequence 0 255))))
     (setq supertag-semantic--dim 256)
     (puthash "document-node" (cons "hash" bytes) supertag-semantic--vectors)
     (supertag-semantic--save)
     (clrhash supertag-semantic--vectors)
     (supertag-semantic--load)
     (let ((loaded (cdr (gethash "document-node" supertag-semantic--vectors))))
       (should (equal bytes loaded))
       (should-not (multibyte-string-p loaded)))
     (dolist (invalid '("中" "ab"))
       (with-temp-file (car supertag-semantic--context)
         (prin1 (list :version 1 :model supertag-semantic-model :dim 1
                      :entries (list (cons "document-node" (cons "hash" invalid))))
                (current-buffer)))
       (clrhash supertag-semantic--vectors)
       (setq supertag-semantic--dim nil)
       (supertag-semantic--load)
       (should (zerop (hash-table-count supertag-semantic--vectors)))
       (should-not supertag-semantic--dim)))))

(ert-deftest supertag-semantic-index-roundtrip-and-only-dirty-node-refresh ()
  (supertag-semantic-test-with-index
   (supertag-semantic-test-with-request
    (supertag-semantic-test-seed "other" "Other" "Distinct original body.")
    (let ((store (prin1-to-string supertag--store)) (disk (supertag-document-test-disk file)))
      (supertag-semantic--ensure) (supertag-semantic--ensure)
      (should (= 1 (cl-count #'supertag-semantic--changed (gethash :store-changed supertag--subscribers))))
      (supertag-semantic--pump)
      (should (= 2 (length (caar requests))))
      (should (cl-some (lambda (text) (string-match-p "Property Node.*\n.*\nBody" text)) (caar requests)))
      (supertag-semantic-test-complete (car requests))
      (should (= 2 (hash-table-count supertag-semantic--vectors)))
      (should (= 0 (hash-table-count supertag-semantic--dirty)))
      (let ((entry (gethash "document-node" supertag-semantic--vectors)))
        (should-not (multibyte-string-p (cdr entry)))
        (clrhash supertag-semantic--vectors)
        (supertag-semantic--load)
        (should (equal entry (gethash "document-node" supertag-semantic--vectors)))
        (should-not (multibyte-string-p (cdr (gethash "document-node" supertag-semantic--vectors)))))
      (should (equal store (prin1-to-string supertag--store)))
      (should (equal disk (supertag-document-test-disk file))))
    (supertag-semantic-test-seed "other" "Other" "Changed original body.")
    (should (equal '("other") (hash-table-keys supertag-semantic--dirty)))
    (supertag-semantic--pump)
    (should (= 1 (length (caar requests))))
    (should (string-match-p "Changed original body" (caaar requests)))
    (supertag-semantic-test-complete (car requests))
    (supertag-store-remove-entity :nodes "other")
    (should-not (gethash "other" supertag-semantic--vectors))
    (supertag-semantic--pump)
    (clrhash supertag-semantic--vectors) (supertag-semantic--load)
    (should-not (gethash "other" supertag-semantic--vectors)))))

(ert-deftest supertag-semantic-batches-and-rebuilds-on-model-or-dimension-change ()
  (supertag-semantic-test-with-index
   (supertag-semantic-test-with-request
    (supertag-semantic-test-seed "other" "Other" "Body")
    (let ((supertag-semantic-request-chars 1))
      (supertag-semantic--ensure) (supertag-semantic--pump)
      (should (= 1 (length (caar requests))))
      (supertag-semantic--pump) (should (= 1 (length requests)))
      (supertag-semantic-test-complete (car requests))
      (supertag-semantic--pump) (supertag-semantic-test-complete (car requests)))
    (should (= 2 (hash-table-count supertag-semantic--vectors)))
    (let ((supertag-semantic-model "another-model"))
      (supertag-semantic--ensure)
      (should (= 0 (hash-table-count supertag-semantic--vectors)))
      (should (= 2 (hash-table-count supertag-semantic--dirty)))
      (supertag-semantic--pump) (supertag-semantic-test-complete (car requests))
      (supertag-semantic-test-seed "other" "Other" "Changed")
      (supertag-semantic--pump)
      (supertag-semantic-test-complete (car requests) [1.0 0.0 0.0])
      (should (= 3 supertag-semantic--dim))
      (should-not (gethash "document-node" supertag-semantic--vectors))
      (should (gethash "document-node" supertag-semantic--dirty))
      (supertag-semantic--pump) (supertag-semantic-test-complete (car requests) [1.0 0.0 0.0])
      (should (= 2 (hash-table-count supertag-semantic--vectors)))))))

(ert-deftest supertag-semantic-ranking-excludes-links-and-applies-threshold ()
  (supertag-semantic-test-with-index
   (supertag-semantic-test-seed "best" "Best" "Related")
   (supertag-semantic-test-seed "weak" "Weak" "Different")
   (supertag-semantic-test-seed "incoming" "Incoming" "Linked" '("document-node"))
   (supertag-semantic-test-seed "outgoing" "Outgoing" "Linked")
   (supertag-store-put-entity :nodes "document-node"
                              (plist-put (copy-sequence (supertag-semantic--node "document-node")) :ref-to '("outgoing")) t)
   (supertag-semantic--ensure)
   (maphash (lambda (id node)
              (puthash id (cons (supertag-semantic--hash node)
                                (supertag-semantic--quantize (if (equal id "weak") [0.0 1.0] [1.0 0.0])))
                       supertag-semantic--vectors)) (supertag-store-get-collection :nodes))
   (should (equal '("best") (mapcar (lambda (m) (plist-get m :id)) (supertag-semantic--matches "document-node"))))
   (let ((supertag-semantic-min-similarity 0) (supertag-semantic-max-results 1))
     (should (equal '("best") (mapcar (lambda (m) (plist-get m :id)) (supertag-semantic--matches "document-node")))))))

(ert-deftest supertag-semantic-stale-response-and-stale-text-are-not-committed ()
  (supertag-semantic-test-with-index
   (supertag-semantic-test-with-request
    (supertag-semantic--ensure) (supertag-semantic--pump)
    (let ((a (car requests)))
      (supertag-semantic-rebuild) (supertag-semantic--pump)
      (supertag-semantic-test-complete (car requests) [0.0 1.0])
      (let ((before (copy-tree (gethash "document-node" supertag-semantic--vectors))))
        (supertag-semantic-test-complete a [1.0 0.0])
        (should (equal before (gethash "document-node" supertag-semantic--vectors)))))
    (supertag-semantic-test-seed "document-node" "Updated" "first")
    (supertag-semantic--pump)
    (supertag-semantic-test-seed "document-node" "Updated" "second")
    (supertag-semantic-test-complete (car requests))
    (should (gethash "document-node" supertag-semantic--dirty))
    (should-not (equal (car (gethash "document-node" supertag-semantic--vectors))
                       (supertag-semantic--hash (supertag-semantic--node "document-node")))))))


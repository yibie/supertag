(defun supertag-semantic-test--blocked-render (error-state)
  "Render an existing view while paused or in ERROR-STATE, without adding work."
  (supertag-semantic-test-with-index
    (let ((view (with-current-buffer (find-file-noselect file)
                  (supertag-view-node-open "document-node")))
          (queue (symbol-function 'supertag-semantic--queue))
          (schedule (symbol-function 'supertag-semantic--schedule)))
      (setq supertag-semantic--paused (not error-state)
            supertag-semantic--error (and error-state "Offline"))
      (clrhash supertag-semantic--dirty)
      (puthash "already-dirty" t supertag-semantic--dirty)
      (dotimes (cold 2)
        (when (= cold 1) (setq supertag-semantic--last-enabled nil))
        (let ((queued 0) (scheduled 0)
              (disk (supertag-document-test-disk file))
              (store (prin1-to-string supertag--store)))
          (cl-letf (((symbol-function 'supertag-semantic--queue)
                     (lambda (id) (cl-incf queued) (funcall queue id)))
                    ((symbol-function 'supertag-semantic--schedule)
                     (lambda () (cl-incf scheduled) (funcall schedule))))
            (with-current-buffer view
              (supertag-view-node--refresh-view)
              (should (string-match-p (if error-state "Unavailable: Offline" "Paused\\.")
                                      (buffer-string)))
              (should (string-match-p "\\[Retry\\]" (buffer-string)))))
          (should (= 0 queued))
          (should (= 0 scheduled))
          (should (equal '("already-dirty") (hash-table-keys supertag-semantic--dirty)))
          (should (eq t (gethash "already-dirty" supertag-semantic--dirty)))
          (should (equal disk (supertag-document-test-disk file)))
          (should (equal store (prin1-to-string supertag--store))))))))


(ert-deftest supertag-semantic-real-local-endpoint-if-model-present ()
  (skip-unless (executable-find supertag-semantic-curl-program))
  ;; Discover the installed default model using only the local public endpoint.
  (let ((available nil))
    (with-temp-buffer
      (let ((process (make-process :name "semantic-test-tags" :buffer (current-buffer)
                                   :noquery t :sentinel #'ignore
                                   :command (list supertag-semantic-curl-program "--silent" "--fail"
                                                  "--noproxy" "*" "--max-time" "2"
                                                  "http://localhost:11434/api/tags"))))
        (let ((deadline (+ (float-time) 3)))
          (while (and (process-live-p process) (< (float-time) deadline))
            (accept-process-output process 0.05)))
        (when (process-live-p process) (delete-process process))
        (when (= 0 (process-exit-status process))
          (setq available
                (ignore-errors
                  (cl-some (lambda (model) (member (alist-get 'name model) '("bge-m3" "bge-m3:latest")))
                           (alist-get 'models (json-parse-string (buffer-string) :object-type 'alist :array-type 'list))))))))
    (skip-unless available))
  (supertag-semantic-test-with-index
   (let ((supertag-semantic-endpoint "http://localhost:11434")
         (supertag-semantic-model "bge-m3"))
     (supertag-semantic-test-seed "document-node" "咖啡因与睡眠"
                                  "下午喝含咖啡因的饮料会延迟入睡。想改善睡眠，可以减少午后咖啡摄入。")
     (supertag-semantic-test-seed "sleep-zh" "晚间休息与饮品"
                                  "为了更快入睡，下午之后少喝咖啡，避免咖啡因影响夜间休息。")
     (supertag-semantic-test-seed "sleep-en" "Caffeine and rest"
                                  "Avoid coffee in the afternoon to prevent caffeine from delaying sleep at night.")
     (supertag-semantic-test-seed "garden" "番茄浇水"
                                  "番茄在阳光充足的地方生长，需要保持土壤湿润。")
     (supertag-semantic--ensure)
     (supertag-semantic--pump)
     (let ((deadline (+ (float-time) 35)))
       (while (and supertag-semantic--active (< (float-time) deadline))
         (accept-process-output nil 0.05)))
     (should-not supertag-semantic--active)
     (should-not supertag-semantic--error)
     (should (> supertag-semantic--dim 0))
     (should (gethash "document-node" supertag-semantic--vectors))
     (let* ((source (cdr (gethash "document-node" supertag-semantic--vectors)))
            (zh (supertag-semantic--score source (cdr (gethash "sleep-zh" supertag-semantic--vectors))))
            (en (supertag-semantic--score source (cdr (gethash "sleep-en" supertag-semantic--vectors))))
            (other (supertag-semantic--score source (cdr (gethash "garden" supertag-semantic--vectors)))))
       (message "Synthetic bge-m3 quality: Chinese rewrite=%.4f cross-language=%.4f unrelated=%.4f" zh en other)
       (should (> zh other)) (should (> en other)))
     (should (file-exists-p (supertag-data-file "supertag-semantic.el"))))))


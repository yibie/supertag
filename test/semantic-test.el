(defun supertag-semantic-test--observe-blocked-context ()
  "Render production section and require context observation without work creation."
  (let ((scan (symbol-function 'supertag-semantic--scan))
        (queue (symbol-function 'supertag-semantic--queue))
        (schedule (symbol-function 'supertag-semantic--schedule))
        (scanned 0) (queued 0) (scheduled 0))
    (cl-letf (((symbol-function 'supertag-semantic--scan)
               (lambda () (cl-incf scanned) (funcall scan)))
              ((symbol-function 'supertag-semantic--queue)
               (lambda (id) (cl-incf queued) (funcall queue id)))
              ((symbol-function 'supertag-semantic--schedule)
               (lambda () (cl-incf scheduled) (funcall schedule))))
      (with-temp-buffer
        (supertag-semantic-insert-section "document-node")
        (should (string-match-p "\\[Retry\\]" (buffer-string)))))
    (should (= 0 scanned))
    (should (= 0 queued))
    (should (= 0 scheduled))
    (should (equal supertag-semantic--context (supertag-semantic--current-context)))
    (should-not supertag-semantic--last-enabled)))

(defun supertag-semantic-test--blocked-context-roundtrip (dimension error-state)
  "Observe A/B/A for model or directory DIMENSION while stopped or in ERROR-STATE.
This exercises the context seam with real Store events, not vault activation."
  (supertag-semantic-test-with-index
    (supertag-semantic-test-with-request
      (let ((supertag-semantic-model "model-A")
            (directory-b (expand-file-name "context-B/" tmp)))
        (supertag-semantic-test-seed "other" "Other" "old body")
        (supertag-semantic--ensure)
        (supertag-semantic--pump)
        (supertag-semantic-test-complete (car requests))
        (should (= 2 (hash-table-count supertag-semantic--vectors)))
        (should (= 0 (hash-table-count supertag-semantic--dirty)))
        (if error-state
            (progn
              (supertag-semantic-test-seed "document-node" "Property Node" "changed source")
              (supertag-semantic--pump)
              (funcall (cdar requests) nil "Offline")
              (should (equal "Offline" supertag-semantic--error)))
          (supertag-semantic-stop))
        (should supertag-semantic--paused)
        (let ((old (car requests))
              (request-count (length requests))
              (disk (supertag-document-test-disk file))
              (sidecar (supertag-document-test-disk (car supertag-semantic--context))))
          (let ((supertag-semantic-model (if (eq dimension 'model) "model-B" supertag-semantic-model))
                (supertag-data-directory (if (eq dimension 'directory) directory-b supertag-data-directory)))
            (supertag-semantic-test--observe-blocked-context)
            (should-not supertag-semantic--active)
            (should (= 0 (hash-table-count supertag-semantic--vectors)))
            ;; Old dirty belongs to A; dropping it is context invalidation.
            (should (= 0 (hash-table-count supertag-semantic--dirty)))
            (supertag-semantic-test-seed "other" "Other" "changed body in B"))
          (supertag-semantic-test--observe-blocked-context)
          (should supertag-semantic--paused)
          (when error-state (should (equal "Offline" supertag-semantic--error)))
          (should (= request-count (length requests)))
          (should (equal sidecar (supertag-document-test-disk (car supertag-semantic--context))))
          (should-not (file-exists-p (expand-file-name "supertag-semantic.el" directory-b)))
          (let ((store (prin1-to-string supertag--store)))
            (supertag-semantic--retry "document-node")
            (should-not supertag-semantic--paused)
            (should-not supertag-semantic--error)
            (should supertag-semantic--last-enabled)
            (should (gethash "other" supertag-semantic--dirty))
            (supertag-semantic--pump)
            (should (= (1+ request-count) (length requests)))
            (should (cl-some (lambda (text) (string-match-p "changed body in B" text))
                             (caar requests)))
            (let ((active supertag-semantic--active))
              (supertag-semantic-test-complete old)
              (should (eq active supertag-semantic--active)))
            (supertag-semantic-test-complete (car requests))
            (should (equal (car (gethash "other" supertag-semantic--vectors))
                           (supertag-semantic--hash (supertag-semantic--node "other"))))
            (should (= 2 (hash-table-count supertag-semantic--vectors)))
            (should-not (gethash "other" supertag-semantic--dirty))
            (should (equal disk (supertag-document-test-disk file)))
            (should (equal store (prin1-to-string supertag--store)))))))))


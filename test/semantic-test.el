(ert-deftest supertag-semantic-rebuild-reports-batch-progress-and-completion ()
  (supertag-semantic-test-with-index
    (supertag-semantic-test-with-request
      (supertag-semantic-test-seed "extra" "Extra" "Extra body")
      (let ((supertag-semantic-request-chars 1) messages)
        (cl-letf (((symbol-function 'message)
                   (lambda (format-string &rest args)
                     (push (apply #'format format-string args) messages))))
          (supertag-semantic-rebuild)
          (should (= 2 (plist-get supertag-semantic--rebuild :total)))
          (supertag-semantic--pump)
          (supertag-semantic-test-complete (car requests))
          (should (= 1 (plist-get supertag-semantic--rebuild :done)))
          (supertag-semantic--pump)
          (supertag-semantic-test-complete (car requests))
          (should-not supertag-semantic--rebuild)
          (should (cl-some (lambda (line)
                             (string-match-p "Similar notes ready: 2 notes embedded" line))
                           messages)))))))

(ert-deftest supertag-semantic-stop-reports-and-resume-preserves-vectors ()
  (supertag-semantic-test-with-index
    (supertag-semantic-test-with-request
      (supertag-semantic-test-seed "extra" "Extra" "Extra body")
      (let ((supertag-semantic-request-chars 1) messages (scheduled 0))
        (cl-letf (((symbol-function 'message)
                   (lambda (format-string &rest args)
                     (push (apply #'format format-string args) messages)))
                  ((symbol-function 'supertag-semantic--schedule)
                   (lambda () (cl-incf scheduled))))
          (supertag-semantic-rebuild)
          (supertag-semantic--pump)
          (supertag-semantic-test-complete (car requests))
          (let ((entry (gethash "document-node" supertag-semantic--vectors)))
            (should entry)
            (should (= 1 (plist-get supertag-semantic--rebuild :done)))
            (supertag-semantic-stop)
            (should-not supertag-semantic--rebuild)
            (should (cl-some (lambda (line)
                               (string-match-p "Embedding stopped at 1/2 — M-x supertag-semantic-resume to continue"
                                               line))
                             messages))
            (setq scheduled 0)
            (supertag-semantic-resume)
            (should (= 1 scheduled))
            (should (eq entry (gethash "document-node" supertag-semantic--vectors)))
            (should (= 1 (plist-get supertag-semantic--rebuild :total)))))))))

(ert-deftest supertag-semantic-real-view-computing-cards-and-failure-no-retry-storm ()
  (supertag-semantic-test-with-index
   (supertag-semantic-test-with-request
    (supertag-semantic-test-seed "similar" "Similar title" "Original line one.\nOriginal line two.\nThird.\nFourth.")
    (let ((disk (supertag-document-test-disk file))
          (store (prin1-to-string supertag--store))
          (view (with-current-buffer (find-file-noselect file) (supertag-view-node-open "document-node"))))
      (with-current-buffer view (should (string-match-p "Computing…" (buffer-string))))
      (supertag-semantic--pump) (supertag-semantic-test-complete (car requests))
      (with-current-buffer view
        (should (string-match-p " SIMILAR / " (buffer-string)))
        (should (string-match-p "Similar title" (buffer-string)))
        (should (string-match-p "      Original line one" (buffer-string)))
        (should (string-match-p "Fourth" (buffer-string)))
        (should-not (string-match-p "\\[View\\]" (buffer-string)))
        (should-not (string-match-p "\\[Add link\\]" (buffer-string))))
      (should (equal disk (supertag-document-test-disk file)))
      (should (equal store (prin1-to-string supertag--store)))
      (supertag-semantic-rebuild) (supertag-semantic--pump)
      (let ((sidecar (supertag-document-test-disk (supertag-data-file "supertag-semantic.el"))))
        (funcall (cdar requests) nil "Endpoint unavailable")
        (dotimes (_ 3) (supertag-semantic--pump))
        (should (= 2 (length requests)))
        (with-current-buffer view (should (string-match-p "Unavailable: Endpoint unavailable" (buffer-string))))
        (should (equal sidecar (supertag-document-test-disk (supertag-data-file "supertag-semantic.el"))))
        (should (equal disk (supertag-document-test-disk file)))
        (should (equal store (prin1-to-string supertag--store))))))))


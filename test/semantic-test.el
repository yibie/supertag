                (goto-char (point-min))
                (search-forward ":ID: candidate")
                (org-back-to-heading t)
                (org-fold-hide-subtree))
              (button-activate button)
              (should (derived-mode-p 'org-mode))
              (should (looking-at ":\\(?:NOTE\\|END\\|LOGBOOK\\):"))
              (should-not (org-invisible-p (point)))
              (should (equal "candidate" (org-entry-get nil "ID")))
              (should (equal disk (buffer-string)))
              (should-not (buffer-modified-p))
              (should (equal disk (supertag-document-test-disk file)))
              (should (equal store (prin1-to-string supertag--store)))
              ;; Unclosed NOTE must not swallow the later paragraph either.
              (when (string-prefix-p ":NOTE:" body)
                (supertag-semantic--visit-passage "candidate" "Later legitimate prose.")
                (should (looking-at "Later legitimate prose\\.")))
              ;; The same text exists beyond the own-body bound, but must not match.
              (supertag-semantic--visit-passage "candidate" "* Neighbor")
              (should (org-at-heading-p))
              (should (equal "candidate" (org-entry-get nil "ID"))))
          (when (buffer-live-p (supertag-view-node--buffer))
            (kill-buffer (supertag-view-node--buffer)))))))))
